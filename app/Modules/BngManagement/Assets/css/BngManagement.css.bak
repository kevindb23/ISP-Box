#bngManagementApp {
    --bng-blue: #2563eb;
    --bng-blue-dark: #1d4ed8;
    --bng-ink: #0f172a;
    --bng-muted: #64748b;
    --bng-line: #e2e8f0;
    --bng-surface: #ffffff;
    --bng-surface-soft: #f8fafc;
    --bng-shadow-soft: 0 12px 28px rgba(15, 23, 42, 0.05);
    --bng-shadow-lg: 0 20px 40px rgba(15, 23, 42, 0.08);
}

/* =========================================================
   HEADER / HERO
========================================================= */
#bngManagementApp .nx-page-header-card,
#bngManagementApp .nx-toolbar-card,
#bngManagementApp .nx-content-card {
    border-radius:3px;
    overflow: hidden;
}

#bngManagementApp .bng-hero-card {
    border: 1px solid rgba(37, 99, 235, 0.08);
    background:
            radial-gradient(circle at top right, rgba(37, 99, 235, 0.10), transparent 28%),
            linear-gradient(180deg, rgba(255, 255, 255, 1) 0%, rgba(248, 250, 252, 0.94) 100%);
    box-shadow: var(--bng-shadow-lg);
}

#bngManagementApp .bng-hero-body {
    min-height: 124px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    padding: 24px 28px;
}

#bngManagementApp .bng-hero-left {
    max-width: 860px;
}

#bngManagementApp .bng-hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 7px 12px;
    border-radius:3px;
    background: rgba(37, 99, 235, 0.08);
    color: var(--bng-blue-dark);
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    margin-bottom: 14px;
}

#bngManagementApp .bng-hero-badge i {
    font-size: 11px;
    line-height: 1;
}

#bngManagementApp .bng-hero-title {
    margin: 0 0 6px;
    font-size: 18px;
    font-weight: 800;
    color: var(--bng-ink);
    line-height: 1.2;
}

#bngManagementApp .bng-hero-text {
    margin: 0;
    font-size: 14px;
    color: var(--bng-muted);
    line-height: 1.55;
}

#bngManagementApp .bng-hero-actions {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-wrap: wrap;
}

#bngManagementApp .bng-hero-actions .btn {
    height: 40px;
    min-height: 40px;
    padding: 0 16px;
    border-radius:3px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    font-size: 14px;
    font-weight: 700;
    line-height: 1;
    vertical-align: middle;
    box-shadow: none;
}

.nx-runtime-panel {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px;
}

#bngManagementApp .nx-runtime-card {
    background: linear-gradient(180deg, #ffffff, #f8fafc);
    border-radius: 3px;
    padding: 16px;
    border: 0;
}

.nx-runtime-title {
    font-weight: 600;
    margin-bottom: 12px;
}

.nx-runtime-main {
    display: flex;
    align-items: center;
    gap: 10px;
}

.nx-runtime-arrow {
    font-size: 18px;
    color: #64748b;
}

.nx-vlan-list {
    display: flex;
    flex-direction: column;
    gap: 8px;
}

.nx-vlan-row {
    display: flex;
    justify-content: space-between;
    padding: 10px;
    border-radius:3px;
    background: #f1f5f9;
}

.nx-vlan-id {
    font-weight: 600;
}

.nx-vlan-status.success {
    color: #16a34a;
    font-weight: 600;
}

#bngManagementApp .bng-hero-actions .btn-primary {
    background: linear-gradient(135deg, #3b82f6 0%, #2563eb 100%);
    border-color: #2563eb;
}

#bngManagementApp .bng-hero-actions .btn-primary:hover,
#bngManagementApp .bng-hero-actions .btn-primary:focus {
    background: linear-gradient(135deg, #2563eb 0%, #1d4ed8 100%);
    border-color: #1d4ed8;
}

#bngManagementApp .bng-hero-actions .btn-success {
    background: linear-gradient(135deg, #22c55e 0%, #16a34a 100%);
    border-color: #16a34a;
    color: #fff;
}

#bngManagementApp .bng-hero-actions .btn-success:hover,
#bngManagementApp .bng-hero-actions .btn-success:focus {
    background: linear-gradient(135deg, #16a34a 0%, #15803d 100%);
    border-color: #15803d;
    color: #fff;
}

#bngManagementApp .bng-hero-actions .btn-light {
    background: #fff;
    border-color: #dbe3ef;
    color: #0f172a;
}

#bngManagementApp .bng-hero-actions .btn-light:hover,
#bngManagementApp .bng-hero-actions .btn-light:focus {
    background: #f8fafc;
    border-color: #cbd5e1;
    color: #0f172a;
}

/* =========================================================
   SUMMARY CARDS
========================================================= */
#bngManagementApp .nx-summary-card {
    position: relative;
    min-height: 142px;
    border-radius:3px;
    background: linear-gradient(180deg, #ffffff 0%, #fbfdff 100%);
    border: 1px solid rgba(226, 232, 240, 0.9);
    box-shadow: var(--bng-shadow-soft);
    overflow: hidden;
    padding: 22px 28px;
}

#bngManagementApp .nx-summary-card::before {
    content: "";
    position: absolute;
    inset: 0 auto 0 0;
    width: 5px;
    border-radius:3px;
}

#bngManagementApp .nx-summary-primary::before {
    background: linear-gradient(180deg, #3b82f6 0%, #1d4ed8 100%);
}

#bngManagementApp .nx-summary-success::before {
    background: linear-gradient(180deg, #22c55e 0%, #15803d 100%);
}

#bngManagementApp .nx-summary-danger::before {
    background: linear-gradient(180deg, #ef4444 0%, #dc2626 100%);
}

#bngManagementApp .nx-summary-cyan::before {
    background: linear-gradient(180deg, #06b6d4 0%, #0891b2 100%);
}

#bngManagementApp .nx-summary-slate::before {
    background: linear-gradient(180deg, #64748b 0%, #334155 100%);
}

#bngManagementApp .nx-summary-top {
    position: relative;
    z-index: 1;
    display: flex;
    justify-content: space-between;
    gap: 16px;
}

#bngManagementApp .nx-summary-title {
    font-size: 12px;
    font-weight: 700;
    color: #64748b;
    margin-bottom: 8px;
    letter-spacing: 0.02em;
    text-transform: none;
}

#bngManagementApp .nx-summary-value {
    font-size: 20px;
    font-weight: 800;
    color: #0f172a;
    line-height: 1.1;
    margin-bottom: 8px;
}

#bngManagementApp .nx-summary-subtitle {
    font-size: 13px;
    color: #6b7280;
    line-height: 1.45;
    max-width: 240px;
}

#bngManagementApp .nx-summary-icon {
    width: 38px;
    height: 38px;
    border-radius:3px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: #eff6ff;
    color: #2563eb;
    font-size: 15px;
    flex: 0 0 auto;
    margin-top: 2px;
}

#bngManagementApp .nx-summary-primary .nx-summary-icon {
    background: #eff6ff;
    color: #2563eb;
}

#bngManagementApp .nx-summary-cyan .nx-summary-icon {
    background: #ecfeff;
    color: #0891b2;
}

#bngManagementApp .nx-summary-slate .nx-summary-icon {
    background: #f1f5f9;
    color: #475569;
}

#bngManagementApp .nx-summary-success .nx-summary-icon {
    background: #f0fdf4;
    color: #16a34a;
}

#bngManagementApp .nx-summary-danger .nx-summary-icon {
    background: #fef2f2;
    color: #dc2626;
}

/* =========================================================
   TOOLBAR CARD
========================================================= */
#bngManagementApp .nx-toolbar-card {
    border: 1px solid rgba(226, 232, 240, 0.9);
    background: linear-gradient(180deg, #ffffff 0%, #fbfdff 100%);
    box-shadow: var(--bng-shadow-soft);
}

#bngManagementApp .nx-toolbar-card .card-body {
    padding: 20px 22px;
}

#bngManagementApp .nx-toolbar-inline {
    display: flex;
    align-items: center;
    gap: 12px;
    flex-wrap: wrap;
}

#bngManagementApp .nx-toolbar-inline .form-control,
#bngManagementApp .nx-toolbar-inline .form-select {
    height: 42px;
    min-height: 42px;
    border-radius:3px;
    border-color: #dbe3ef;
    font-size: 14px;
    box-shadow: none;
    min-width: 260px;
}

#bngManagementApp .nx-toolbar-inline .form-control:focus,
#bngManagementApp .nx-toolbar-inline .form-select:focus {
    border-color: #93c5fd;
    box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.10);
}

#bngManagementApp .nx-section-title {
    font-size: 18px;
    font-weight: 800;
    color: #0f172a;
    line-height: 1.2;
}

#bngManagementApp .nx-section-subtitle {
    font-size: 14px;
    color: #64748b;
    line-height: 1.55;
}

/* =========================================================
   CONTENT CARD / TABLE
========================================================= */
#bngManagementApp .nx-content-card {
    position: relative;
    border: 1px solid rgba(226, 232, 240, 0.9);
    background: linear-gradient(180deg, #ffffff 0%, #fbfdff 100%);
    box-shadow: var(--bng-shadow-lg);
}

/* Keep the BNG workspace visually attached to the page canvas. The shared
   shell gives ordinary cards a tinted panel surface; this form reads better
   when only its controls provide contrast against the body background. */
body#nxApplication .main-content #bngManagementApp .bng-bng-panel {
    background: var(--nx-bg-page) !important;
    background-image: none !important;
    border-color: transparent !important;
    box-shadow: none !important;
}

#bngManagementApp .bng-bng-panel .card-body {
    padding: 18px 18px 20px !important;
}

/* Apply the same canvas-colored surface to the remaining CGNAT tab panels. */
body#nxApplication .main-content #bngManagementApp .bng-surface-panel {
    background: var(--nx-bg-page) !important;
    background-image: none !important;
    border-color: transparent !important;
    box-shadow: none !important;
}

body#nxApplication .main-content #bngManagementApp .bng-bng-panel::before,
body#nxApplication .main-content #bngManagementApp .bng-surface-panel::before {
    display: none !important;
}

/* Match the Subscribers card contract: a quiet theme-aware outline with no
   heavy shadow, while keeping the CGNAT workspace surfaces readable. */
body#nxApplication .main-content #bngManagementApp .bng-hero-card,
body#nxApplication .main-content #bngManagementApp .nx-summary-card,
body#nxApplication .main-content #bngManagementApp .nx-toolbar-card,
body#nxApplication .main-content #bngManagementApp .nx-content-card,
body#nxApplication .main-content #bngManagementApp .bng-bng-panel,
body#nxApplication .main-content #bngManagementApp .bng-surface-panel {
    border: 1px solid var(--nx-panel-border-light) !important;
    box-shadow: none !important;
}

body#nxApplication .main-content #bngManagementApp .nx-runtime-card {
    border: 1px solid var(--nx-panel-border-light) !important;
    box-shadow: none !important;
}

#bngManagementApp .nx-content-card::before {
    content: "";
    display: block;
    height: 4px;
    background: linear-gradient(90deg, #3b82f6 0%, #2563eb 25%, rgba(37, 99, 235, 0.10) 100%);
}

#bngManagementApp .nx-content-card .card-body {
    padding: 10px 18px 14px !important;
}

#bngManagementApp .nx-table-wrap {
    overflow-x: auto;
    overflow-y: hidden;
}

#bngManagementApp .table {
    margin-bottom: 0;
}

#bngManagementApp .table th,
#bngManagementApp .table td {
    vertical-align: middle;
}

#bngManagementApp .table thead th {
    white-space: nowrap;
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 0.10em;
    text-transform: uppercase;
    color: #475569;
    border-bottom-color: #e2e8f0;
    padding-top: 18px;
    padding-bottom: 14px;
    background: #f8fafc;
}

#bngManagementApp .table tbody td {
    padding-top: 16px;
    padding-bottom: 16px;
    border-bottom-color: #edf2f7;
    color: #0f172a;
}

#bngManagementApp .table td:last-child,
#bngManagementApp .table th:last-child {
    text-align: right;
    white-space: nowrap;
}

/* =========================================================
   BADGES / CHIPS
========================================================= */
#bngManagementApp .badge.text-bg-light.border,
#bngManagementApp .nx-chip,
#bngManagementApp .nx-soft-badge {
    font-size: 11px;
    padding: 5px 10px;
    border-radius:3px;
    font-weight: 800;
    letter-spacing: 0.02em;
    display: inline-flex;
    align-items: center;
    justify-content: center;
}

#bngManagementApp .badge.text-bg-light.border,
#bngManagementApp .nx-chip,
#bngManagementApp .nx-chip--neutral {
    background: #f8fafc !important;
    color: #334155 !important;
    border: 1px solid rgba(148, 163, 184, 0.22) !important;
}

#bngManagementApp .nx-chip-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
}

#bngManagementApp .nx-chip--success {
    background: #e8f8ef !important;
    color: #15803d !important;
    border-color: rgba(22, 163, 74, 0.18) !important;
}

#bngManagementApp .nx-chip--danger {
    background: #fef2f2 !important;
    color: #dc2626 !important;
    border-color: rgba(220, 38, 38, 0.18) !important;
}

/* =========================================================
   BUTTONS
========================================================= */
#bngManagementApp .btn-group-sm > .btn,
#bngManagementApp .btn-sm {
    border-radius:3px;
    font-weight: 600;
}

#bngManagementApp .btn-group-sm > .btn + .btn {
    margin-left: 0.15rem;
}

/* =========================================================
   FORMS
========================================================= */
#bngManagementApp .form-label {
    display: block;
    font-size: 12px;
    font-weight: 600;
    color: #6b7280;
    margin-bottom: 6px;
    text-transform: uppercase;
    letter-spacing: .04em;
}

#bngManagementApp .form-control,
#bngManagementApp .form-select {
    border-color: rgba(148, 163, 184, 0.34);
    box-shadow: none;
    border-radius:3px;
    min-height: 46px;
}

#bngManagementApp .form-control:focus,
#bngManagementApp .form-select:focus {
    border-color: #93c5fd;
    box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.10);
}

#bngManagementApp textarea.form-control {
    min-height: 110px;
    resize: vertical;
}

/* Use explicit tracks so the BNG fields stay aligned instead of relying on
   Bootstrap's flex wrapping when optional SSH key fields are toggled. */
#bngManagementApp .bng-bng-form {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: 16px;
    margin: 0;
}

#bngManagementApp .bng-bng-form > * {
    width: auto;
    min-width: 0;
    padding-left: 0;
    padding-right: 0;
    grid-column: 1 / -1;
}

/* Desktop arrangement: 2/4/2/4, 3/5/4, and 4/4/2/2 tracks. */
#bngManagementApp .bng-bng-form > .col-md-2 {
    grid-column: span 2;
}

#bngManagementApp .bng-bng-form > .col-md-3 {
    grid-column: span 3;
}

#bngManagementApp .bng-bng-form > .col-md-4 {
    grid-column: span 4;
}

#bngManagementApp .bng-bng-form > .col-md-5 {
    grid-column: span 5;
}

@media (max-width: 991px) {
    #bngManagementApp .bng-bng-form > [class*="col-md-"] {
        grid-column: span 6;
    }
}

@media (max-width: 575px) {
    #bngManagementApp .bng-bng-form > [class*="col-md-"] {
        grid-column: 1 / -1;
    }
}

/* S-VLAN actions and NAT pool fields stay in balanced columns on desktop. */
#bngManagementApp .bng-svlan-form,
#bngManagementApp .bng-pool-form-grid {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: 16px;
    margin: 0;
}

#bngManagementApp .bng-svlan-form {
    align-items: start !important;
    outline: none !important;
    box-shadow: none !important;
}

#bngManagementApp .bng-svlan-form > .col-md-4:first-child .form-label,
#bngManagementApp .bng-form-label-spacer {
    height: 18px;
    line-height: 18px;
    margin-bottom: 6px;
}

#bngManagementApp .bng-form-label-spacer {
    visibility: hidden;
}

#bngManagementApp .bng-svlan-form .btn {
    min-height: 46px;
    height: 46px;
}

#bngManagementApp .bng-svlan-form > *,
#bngManagementApp .bng-pool-form-grid > * {
    width: auto;
    min-width: 0;
    padding-left: 0;
    padding-right: 0;
    grid-column: 1 / -1;
}

#bngManagementApp .bng-svlan-form > .col-md-4 {
    grid-column: span 4;
}

#bngManagementApp .bng-pool-form-grid > .col-md-6 {
    grid-column: span 6;
}

@media (max-width: 991px) {
    #bngManagementApp .bng-svlan-form > .col-md-4,
    #bngManagementApp .bng-pool-form-grid > .col-md-6 {
        grid-column: span 6;
    }
}

@media (max-width: 575px) {
    #bngManagementApp .bng-svlan-form > [class*="col-md-"],
    #bngManagementApp .bng-pool-form-grid > [class*="col-md-"] {
        grid-column: 1 / -1;
    }
}

/* =========================================================
   MODALS
========================================================= */
#bngManagementApp .nx-modal-content {
    border: 0;
    border-radius:3px;
    box-shadow: 0 20px 50px rgba(15, 23, 42, 0.18);
    overflow: hidden;
}

#bngManagementApp .nx-modal-header {
    padding: 18px 22px;
    border-bottom: 1px solid #eef2f7;
    background: #fff;
}

#bngManagementApp .nx-modal-body {
    background: #f8fafc;
    padding: 20px;
}

#bngManagementApp .nx-modal-footer {
    padding: 16px 22px;
    border-top: 1px solid #eef2f7;
    background: #fff;
}

#bngManagementApp .nx-modal-header .modal-title {
    font-weight: 800;
    color: #0f172a;
}

/* =========================================================
   PREVIEW / CODE
========================================================= */
#bngManagementApp .nx-code-block {
    margin: 0;
    min-height: 360px;
    max-height: 60vh;
    overflow: auto;
    border-radius:3px;
    padding: 1rem 1.05rem;
    background: #0f172a;
    color: #e2e8f0;
    border: 1px solid rgba(30, 41, 59, 0.9);
    font-size: 0.86rem;
    line-height: 1.5;
    white-space: pre-wrap;
    word-break: break-word;
}

/* =========================================================
   RUNTIME BLOCKS
========================================================= */
#bngManagementApp .nx-runtime-block {
    border: 1px solid rgba(148, 163, 184, 0.18);
    border-radius:3px;
    padding: 1rem 1.05rem;
    background: linear-gradient(180deg, #ffffff 0%, #fbfdff 100%);
    box-shadow: 0 10px 24px rgba(15, 23, 42, 0.04);
    min-height: 152px;
}

#bngManagementApp .nx-runtime-block__title {
    font-size: 12px;
    font-weight: 700;
    color: #64748b;
    margin-bottom: 8px;
    letter-spacing: 0.02em;
    text-transform: none;
}

#bngManagementApp .nx-runtime-block__value {
    font-size: 20px;
    font-weight: 800;
    color: #0f172a;
    line-height: 1.1;
    margin-bottom: 8px;
    word-break: break-word;
}

#bngManagementApp .nx-runtime-block__meta {
    font-size: 13px;
    color: #6b7280;
    line-height: 1.45;
}

#bngManagementApp .nx-runtime-rules {
    display: grid;
    gap: 0.55rem;
}

#bngManagementApp .nx-runtime-rule {
    border-radius:3px;
    padding: 0.82rem 0.92rem;
    background: #0f172a;
    color: #e2e8f0;
    border: 1px solid rgba(30, 41, 59, 0.95);
    font-size: 0.86rem;
    line-height: 1.45;
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, "Liberation Mono", monospace;
    word-break: break-word;
    overflow-wrap: anywhere;
}

#bngManagementApp .nx-runtime-meta-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.55rem 1rem;
    font-size: 0.92rem;
    color: #334155;
}

#bngManagementApp #bngApplyResultCard .nx-runtime-block {
    min-height: auto;
}

#bngManagementApp .nx-empty-inline {
    color: #64748b;
    font-size: 14px;
    line-height: 1.55;
}

/* =========================================================
   OVERVIEW TAB POLISH
========================================================= */
#bngManagementApp [data-bng-tab="overview"] .nx-content-card,
#bngManagementApp [data-bng-tab="runtime"] .nx-content-card {
    height: 100%;
}

#bngManagementApp [data-bng-tab="overview"] .nx-content-card .card-body,
#bngManagementApp [data-bng-tab="runtime"] .nx-content-card .card-body {
    padding-top: 18px;
}

#bngManagementApp [data-bng-tab="overview"] .nx-runtime-block {
    min-height: 138px;
}

#bngManagementApp [data-bng-tab="overview"] #bngRuntimeBox .nx-runtime-block {
    min-height: auto;
}

#bngManagementApp #bngApplyResultBox .table thead th,
#bngManagementApp #bngApplyResultBox .table tbody td {
    font-size: 13px;
}

#bngManagementApp #bngApplyResultBox .table thead th {
    letter-spacing: 0.06em;
    padding-top: 14px;
    padding-bottom: 12px;
}

#bngManagementApp #bngApplyResultBox .table tbody td {
    padding-top: 12px;
    padding-bottom: 12px;
}

#bngManagementApp #bngApplyResultCard .nx-section-subtitle,
#bngManagementApp [data-bng-tab="overview"] .nx-section-subtitle {
    max-width: 720px;
}

#bngManagementApp #bngRuntimeBox > .row,
#bngManagementApp #bngApplyResultBox > .row {
    margin-bottom: 0;
}

#bngManagementApp #bngRuntimeBox .nx-chip,
#bngManagementApp #bngApplyResultBox .nx-chip {
    gap: 4px;
}

#bngManagementApp #bngRuntimeBox .nx-empty-inline,
#bngManagementApp #bngApplyResultBox .nx-empty-inline {
    padding: 8px 0;
}

#bngManagementApp #bngRuntimeBox .nx-runtime-panel {
    border: none !important;
}

/* =========================================================
   RESPONSIVE
========================================================= */
@media (max-width: 1199px) {
    #bngManagementApp .table {
        min-width: 1080px;
    }
}

@media (max-width: 992px) {
    #bngManagementApp .bng-hero-body {
        flex-direction: column;
        align-items: flex-start;
    }

    #bngManagementApp .bng-hero-actions {
        width: 100%;
    }

    #bngManagementApp .nx-toolbar-inline {
        width: 100%;
    }

    #bngManagementApp .nx-toolbar-inline .form-control,
    #bngManagementApp .nx-toolbar-inline .form-select {
        min-width: 100%;
    }
}

@media (max-width: 767px) {
    #bngManagementApp .nx-runtime-panel {
        grid-template-columns: 1fr;
    }

    #bngManagementApp .nx-summary-card {
        min-height: 128px;
        padding: 20px 22px;
    }

    #bngManagementApp .nx-content-card .card-body,
    #bngManagementApp .nx-toolbar-card .card-body {
        padding-left: 14px;
        padding-right: 14px;
    }

    #bngManagementApp .nx-runtime-meta-grid {
        grid-template-columns: 1fr;
    }

    #bngManagementApp .nx-code-block {
        min-height: 240px;
    }

    #bngManagementApp [data-bng-tab="overview"] .nx-runtime-block {
        min-height: auto;
    }
}

@media (max-width: 575px) {
    #bngManagementApp .bng-hero-actions .btn {
        width: 100%;
    }

    #bngManagementApp .nx-summary-top {
        align-items: flex-start;
    }
}

/* =========================================================
   CGNAT DARK MODE
========================================================= */

html[data-theme="dark"] body#nxApplication .main-content #bngManagementApp .bng-hero-card,
html[data-theme="dark"] body#nxApplication .main-content #bngManagementApp .nx-summary-card,
html[data-theme="dark"] body#nxApplication .main-content #bngManagementApp .nx-toolbar-card,
html[data-theme="dark"] body#nxApplication .main-content #bngManagementApp .nx-content-card,
html[data-theme="dark"] body#nxApplication .main-content #bngManagementApp .bng-bng-panel,
html[data-theme="dark"] body#nxApplication .main-content #bngManagementApp .bng-surface-panel,
html[data-theme="dark"] body#nxApplication .main-content #bngManagementApp .nx-runtime-card {
    border-color: var(--nx-panel-border-dark) !important;
}

html[data-theme="dark"] #bngManagementApp {
    --bng-ink: #f8fafc;
    --bng-muted: #9aa9bd;
    --bng-line: #2b3d56;
    --bng-surface: #182235;
    --bng-surface-soft: #141f31;
}

/* ---------------------------------------------------------
   HERO
--------------------------------------------------------- */

html[data-theme="dark"] #bngManagementApp .bng-hero-card,
html[data-theme="dark"] #bngManagementApp .nx-toolbar-card,
html[data-theme="dark"] #bngManagementApp .nx-content-card,
html[data-theme="dark"] #bngManagementApp .nx-summary-card,
html[data-theme="dark"] #bngManagementApp .nx-runtime-card,
html[data-theme="dark"] #bngManagementApp .nx-runtime-block {
    background: linear-gradient(180deg,#182235 0%,#141f31 100%);
    border-color: rgba(255,255,255,.06);
    box-shadow: 0 16px 36px rgba(0,0,0,.28);
}

html[data-theme="dark"] #bngManagementApp .bng-hero-badge {
    background: rgba(59,130,246,.15);
    color: #93c5fd;
}

html[data-theme="dark"] #bngManagementApp .bng-hero-title,
html[data-theme="dark"] #bngManagementApp .nx-section-title,
html[data-theme="dark"] #bngManagementApp .nx-summary-value,
html[data-theme="dark"] #bngManagementApp .nx-runtime-title,
html[data-theme="dark"] #bngManagementApp .nx-runtime-block__value,
html[data-theme="dark"] #bngManagementApp .nx-modal-header .modal-title {
    color: #f8fafc;
}

html[data-theme="dark"] #bngManagementApp .bng-hero-text,
html[data-theme="dark"] #bngManagementApp .nx-section-subtitle,
html[data-theme="dark"] #bngManagementApp .nx-summary-title,
html[data-theme="dark"] #bngManagementApp .nx-summary-subtitle,
html[data-theme="dark"] #bngManagementApp .nx-runtime-block__title,
html[data-theme="dark"] #bngManagementApp .nx-runtime-block__meta,
html[data-theme="dark"] #bngManagementApp .nx-empty-inline {
    color: #9aa9bd;
}

/* ---------------------------------------------------------
   BUTTONS
--------------------------------------------------------- */

html[data-theme="dark"] #bngManagementApp .btn-light {
    background: #223049;
    border-color: #334155;
    color: #f8fafc;
}

html[data-theme="dark"] #bngManagementApp .btn-light:hover {
    background: #2a3b57;
    border-color: #475569;
    color: #fff;
}

/* ---------------------------------------------------------
   SEGMENT CONTROL
--------------------------------------------------------- */

/* ---------------------------------------------------------
   SUMMARY ICONS
--------------------------------------------------------- */

html[data-theme="dark"] #bngManagementApp .nx-summary-primary .nx-summary-icon {
    background: rgba(37,99,235,.16);
    color: #93c5fd;
}

html[data-theme="dark"] #bngManagementApp .nx-summary-success .nx-summary-icon {
    background: rgba(34,197,94,.15);
    color: #4ade80;
}

html[data-theme="dark"] #bngManagementApp .nx-summary-danger .nx-summary-icon {
    background: rgba(239,68,68,.14);
    color: #f87171;
}

html[data-theme="dark"] #bngManagementApp .nx-summary-cyan .nx-summary-icon {
    background: rgba(6,182,212,.14);
    color: #67e8f9;
}

html[data-theme="dark"] #bngManagementApp .nx-summary-slate .nx-summary-icon {
    background: rgba(148,163,184,.12);
