#subscribersPage {
    --subs-blue: var(--nx-primary-2, #2563eb);
    --subs-blue-dark: var(--nx-primary, #1d4ed8);
    --subs-ink: var(--nx-text, #0f172a);
    --subs-muted: var(--nx-text-muted, #64748b);
    --subs-line: var(--nx-border, #e2e8f0);
    --subs-line-soft: var(--nx-border-soft, #edf2f7);
    --subs-surface: var(--nx-panel-surface-light, #ffffff);
    --subs-surface-soft: var(--nx-bg-soft, #f8fafc);
    --subs-table-head: var(--nx-table-head-surface-light, #f8fafc);
    --subs-table-row: var(--nx-panel-surface-light, #ffffff);
    --subs-table-row-alt: var(--nx-bg-soft, #f8fafc);
    --subs-control-bg: var(--nx-white, #ffffff);
    --subs-control-border: var(--nx-control-border-light, #dbe3ef);
    --subs-shadow-soft: none;
    --subs-shadow-lg: none;
}

/* =========================================================
   HERO / HEADER
========================================================= */
#subscribersPage .nx-page-header-card,
#subscribersPage .nx-toolbar-card,
#subscribersPage .nx-content-card {
    border-radius:3px;
    overflow: hidden;
}

#subscribersPage .nx-page-header-card {
    border: 1px solid var(--subs-line);
    background: var(--subs-surface);
    box-shadow: var(--subs-shadow-lg);
}

#subscribersPage .nx-page-header {
    min-height: 124px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    padding: 24px 28px;
}

#subscribersPage .nx-page-header-left {
    max-width: 820px;
}

#subscribersPage .subs-hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 7px 12px;
    border-radius:3px;
    background: transparent;
    color: var(--subs-blue-dark);
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    margin-bottom: 14px;
    border: 0;
}

#subscribersPage .subs-hero-badge i {
    font-size: 11px;
    line-height: 1;
}

#subscribersPage .nx-page-title {
    margin: 0 0 6px;
    font-size: 18px;
    font-weight: 800;
    color: var(--subs-ink);
    line-height: 1.2;
}

#subscribersPage .nx-page-subtitle {
    margin: 0;
    font-size: 14px;
    color: var(--subs-muted);
    line-height: 1.55;
}

#subscribersPage .nx-page-actions {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-wrap: wrap;
}

#subscribersPage .nx-header-btn {
    height: 40px;
    min-height: 40px;
    padding: 0 16px;
    border-radius:3px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    font-size: 14px;
    font-weight: 700;
    line-height: 1;
    vertical-align: middle;
    box-shadow: none;
}

#subscribersPage .btn-primary.nx-header-btn {
    background: linear-gradient(135deg, #3b82f6 0%, #2563eb 100%);
    border-color: #2563eb;
}

#subscribersPage .btn-primary.nx-header-btn:hover,
#subscribersPage .btn-primary.nx-header-btn:focus {
    background: linear-gradient(135deg, #2563eb 0%, #1d4ed8 100%);
    border-color: #1d4ed8;
}

#subscribersPage .btn-light.nx-header-btn {
    background: #fff;
    border-color: #dbe3ef;
    color: #0f172a;
}

#subscribersPage .btn-light.nx-header-btn:hover,
#subscribersPage .btn-light.nx-header-btn:focus {
    background: #f8fafc;
    border-color: #cbd5e1;
    color: #0f172a;
}

/* =========================================================
   SUMMARY CARDS
========================================================= */
#subscribersPage .nx-subscriber-summary-row {
    margin-bottom: 18px;
}

#subscribersPage .nx-summary-card {
    position: relative;
    min-height: 142px;
    border-radius:3px;
    box-shadow: var(--subs-shadow-soft);
    overflow: hidden;
}

#subscribersPage .nx-summary-card::before {
    content: "";
    position: absolute;
    inset: 0 auto 0 0;
    width: 5px;
    border-radius:3px;
}

#subscribersPage .nx-summary-primary::before {
    background: linear-gradient(180deg, #3b82f6 0%, #1d4ed8 100%);
}

#subscribersPage .nx-summary-success::before {
    background: linear-gradient(180deg, #22c55e 0%, #15803d 100%);
}

#subscribersPage .nx-summary-danger::before {
    background: linear-gradient(180deg, #ef4444 0%, #dc2626 100%);
}

#subscribersPage .nx-summary-cyan::before {
    background: linear-gradient(180deg, #06b6d4 0%, #0891b2 100%);
}

#subscribersPage .nx-summary-top {
    position: relative;
    z-index: 1;
    display: flex;
    justify-content: space-between;
    gap: 16px;
}

#subscribersPage .nx-summary-label {
    font-size: 12px;
    font-weight: 700;
    color: var(--subs-muted);
    margin-bottom: 8px;
    letter-spacing: 0.02em;
}

#subscribersPage .nx-summary-value {
    font-size: 20px;
    font-weight: 800;
    color: var(--subs-ink);
    line-height: 1.1;
    margin-bottom: 8px;
}

#subscribersPage .nx-summary-text {
    font-size: 13px;
    color: var(--subs-muted);
    line-height: 1.45;
    max-width: 240px;
}

#subscribersPage .nx-summary-icon {
    width: 38px;
    height: 38px;
    border-radius:3px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: var(--subs-surface-soft);
    color: var(--subs-blue-dark);
    font-size: 15px;
    flex: 0 0 auto;
    margin-top: 2px;
}

/* =========================================================
   TOOLBAR
========================================================= */
#subscribersPage .nx-toolbar-card {
    border: 1px solid var(--subs-line);
    background: var(--subs-surface);
    box-shadow: var(--subs-shadow-soft);
}

#subscribersPage .nx-toolbar-card .card-body {
    padding: 20px 22px;
}

#subscribersPage .subs-toolbar-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr) auto;
    gap: 12px;
    align-items: center;
}

#subscribersPage .subs-search-wrap {
    position: relative;
    min-width: 0;
}

#subscribersPage .subs-search-icon {
    position: absolute;
    top: 50%;
    left: 14px;
    transform: translateY(-50%);
    font-size: 14px;
    color: #94a3b8;
    pointer-events: none;
}

#subscribersPage .subs-toolbar-control {
    height: 42px;
    min-height: 42px;
    border-radius:3px;
    border-color: var(--subs-control-border);
    background: var(--subs-control-bg);
    color: var(--subs-ink);
    font-size: 14px;
    box-shadow: none;
}

#subscribersPage .subs-search-control {
    padding-left: 40px;
}

#subscribersPage .subs-toolbar-control:focus {
    border-color: var(--nx-control-focus, #64748b);
    box-shadow: 0 0 0 2px rgba(100, 116, 139, .14);
}

#subscribersPage .subs-toolbar-note {
    font-size: 13px;
    line-height: 1.45;
    color: var(--subs-muted);
}

#subscribersPage .subs-toolbar-meta {
    text-align: right;
    white-space: nowrap;
}

#subscribersPage .subs-pagination-top {
    display: inline-block;
    font-size: 13px;
    color: var(--subs-muted);
}

/* =========================================================
   TABLE CARD
========================================================= */
#subscribersPage .nx-content-card {
    position: relative;
    border: 1px solid var(--subs-line);
    background: var(--subs-surface);
    box-shadow: var(--subs-shadow-lg);
}

#subscribersPage .subs-table-topline {
    display: none;
}

#subscribersPage .nx-content-card .card-body {
    padding: 10px 18px 14px;
}

#subscribersPage #subscribersTableHost {
    min-height: 180px;
}

#subscribersPage .nx-table-wrap {
    overflow-x: auto;
    overflow-y: hidden;
}

#subscribersPage table {
    table-layout: fixed;
    width: 100%;
}

#subscribersPage .table {
    margin-bottom: 0;
}

#subscribersPage .subs-mobile-list {
    display: none;
}

#subscribersPage .table th,
#subscribersPage .table td {
    vertical-align: middle;
}

#subscribersPage .table thead th {
    white-space: nowrap;
    color: var(--subs-muted);
    border-bottom-color: var(--subs-line);
    background: var(--subs-table-head);
}

#subscribersPage .table tbody td {
    padding-top: 16px;
    padding-bottom: 16px;
    border-bottom-color: var(--subs-line-soft);
    background: var(--subs-table-row);
    color: var(--subs-ink);
}

#subscribersPage .table tbody tr:nth-child(even) td {
    background: var(--subs-table-row-alt);
}

#subscribersPage .table td:last-child,
#subscribersPage .table th:last-child {
    text-align: right;
    white-space: nowrap;
}

#subscribersPage .table th:nth-child(1),
#subscribersPage .table td:nth-child(1) {
    width: 13%;
}

#subscribersPage .table th:nth-child(2),
#subscribersPage .table td:nth-child(2) {
    width: 12%;
}

#subscribersPage .table th:nth-child(3),
#subscribersPage .table td:nth-child(3) {
    width: 11%;
}

#subscribersPage .table th:nth-child(4),
#subscribersPage .table td:nth-child(4) {
    width: 10%;
}

#subscribersPage .table th:nth-child(5),
#subscribersPage .table td:nth-child(5) {
    width: 10%;
}

#subscribersPage .table th:nth-child(6),
#subscribersPage .table td:nth-child(6) {
    width: 9%;
}

#subscribersPage .table th:nth-child(7),
#subscribersPage .table td:nth-child(7) {
    width: 20%;
}

#subscribersPage .table th:nth-child(8),
#subscribersPage .table td:nth-child(8) {
    width: 15%;
    min-width: 146px;
}

#subscribersPage .sort-indicator {
    font-size: 11px;
    margin-left: 4px;
    color: var(--subs-muted);
}

/* =========================================================
   CELL STYLES
========================================================= */
#subscribersPage .nx-cell-stack {
    display: flex;
    flex-direction: column;
    gap: 3px;
    min-width: 0;
}

#subscribersPage .nx-cell-title {
    font-size: 14px;
    font-weight: 700;
    color: var(--subs-ink);
    line-height: 1.2;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

#subscribersPage .nx-cell-sub {
    font-size: 12px;
    color: var(--subs-muted);
    line-height: 1.25;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

#subscribersPage .nx-text-mono {
    white-space: nowrap;
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, "Liberation Mono", monospace;
}

/* =========================================================
   ACTION BUTTONS
========================================================= */
#subscribersPage .nx-subscriber-actions {
    display: inline-flex;
    align-items: center;
    justify-content: flex-end;
    gap: 4px;
    flex-wrap: nowrap;
    white-space: nowrap;
    min-width: 144px;
    max-width: 100%;
}

#subscribersPage .nx-icon-btn {
    width: 32px;
    height: 32px;
    min-width: 32px;
    min-height: 32px;
    padding: 0;
    border-radius:3px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    line-height: 1;
    box-shadow: none;
}

#subscribersPage .nx-icon-btn i {
    font-size: 12px;
    line-height: 1;
    display: inline-flex;
    align-items: center;
    justify-content: center;
}

#subscribersPage .btn-outline-secondary.nx-icon-btn {
    border-color: var(--subs-control-border);
    color: var(--subs-muted);
    background: var(--subs-control-bg);
}

#subscribersPage .btn-outline-secondary.nx-icon-btn:hover {
    background: var(--subs-surface-soft);
    border-color: var(--subs-control-border);
    color: var(--subs-ink);
}

#subscribersPage .btn-outline-primary.nx-icon-btn {
    border-color: var(--subs-control-border);
    color: var(--subs-blue);
    background: var(--subs-control-bg);
}

#subscribersPage .btn-outline-primary.nx-icon-btn:hover {
    background: var(--subs-surface-soft);
    border-color: var(--subs-control-border);
    color: var(--subs-blue-dark);
}

#subscribersPage .btn-outline-warning.nx-icon-btn {
    border-color: var(--subs-control-border);
    color: #d97706;
    background: var(--subs-control-bg);
}

#subscribersPage .btn-outline-warning.nx-icon-btn:hover {
    background: #fffbeb;
    border-color: #fcd34d;
    color: #b45309;
}

#subscribersPage .btn-outline-success.nx-icon-btn {
    border-color: var(--subs-control-border);
    color: #16a34a;
    background: var(--subs-control-bg);
}

#subscribersPage .btn-outline-success.nx-icon-btn:hover {
    background: #f0fdf4;
    border-color: #86efac;
    color: #15803d;
}

/* =========================================================
   MOBILE CARD LIST
========================================================= */
#subscribersPage .subs-mobile-list {
    gap: 12px;
}

#subscribersPage .subs-mobile-card {
    background: var(--subs-table-row);
    border: 1px solid var(--subs-line);
    border-radius: 3px;
    padding: 14px;
}

#subscribersPage .subs-mobile-card + .subs-mobile-card {
    margin-top: 12px;
}

#subscribersPage .subs-mobile-card__header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 12px;
    margin-bottom: 12px;
}

#subscribersPage .subs-mobile-card__title {
    font-size: 15px;
    font-weight: 700;
    color: var(--subs-ink);
    line-height: 1.25;
}

#subscribersPage .subs-mobile-card__meta {
    margin-top: 4px;
    font-size: 12px;
    color: var(--subs-muted);
}

#subscribersPage .subs-mobile-card__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10px 12px;
    margin-bottom: 12px;
}

#subscribersPage .subs-mobile-item {
    min-width: 0;
}

#subscribersPage .subs-mobile-item__label {
    margin-bottom: 4px;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--subs-muted);
}

#subscribersPage .subs-mobile-item__value {
    font-size: 13px;
    color: var(--subs-ink);
    line-height: 1.35;
    word-break: break-word;
}

#subscribersPage .subs-mobile-item__sub {
    margin-top: 2px;
    font-size: 12px;
    color: var(--subs-muted);
}

#subscribersPage .subs-mobile-card__actions .nx-subscriber-actions {
    display: flex;
    justify-content: flex-start;
    flex-wrap: wrap;
    gap: 8px;
    min-width: 0;
}

#subscribersPage .btn-outline-danger.nx-icon-btn {
    border-color: var(--subs-control-border);
    color: #ef4444;
    background: var(--subs-control-bg);
}

#subscribersPage .btn-outline-danger.nx-icon-btn:hover {
    background: #fef2f2;
    border-color: #fca5a5;
    color: #dc2626;
}

/* =========================================================
   BADGES
========================================================= */
#subscribersPage .nx-soft-badge,
#subscribersPage .badge {
    font-size: 10px;
    padding: 4px 10px;
    border-radius:3px;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    line-height: 1.1;
    min-width: 98px;
    height: 22px;
    justify-content: center;
    display: inline-flex;
    align-items: center;
    border: 0;
    box-shadow: none;
}

#subscribersPage .nx-soft-badge-success {
    background: #198754;
    color: #ffffff;
}

#subscribersPage .nx-soft-badge-danger {
    background: #7f1d1d;
    color: #ffffff;
}

#subscribersPage .nx-soft-badge-warning {
    background: #b45309;
    color: #ffffff;
}

#subscribersPage .nx-soft-badge-info {
    background: #0ea5e9;
    color: #ffffff;
}

/* =========================================================
   EMPTY STATE
========================================================= */
#subscribersPage .nx-empty-state {
    padding: 36px 20px;
    text-align: center;
}

#subscribersPage .nx-empty-icon {
    width: 64px;
    height: 64px;
    margin: 0 auto 14px;
    border-radius:3px;
    background: #eff6ff;
    color: #2563eb;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 24px;
}

#subscribersPage .nx-empty-title {
    font-size: 18px;
    font-weight: 800;
    color: #0f172a;
    margin-bottom: 6px;
}

#subscribersPage .nx-empty-text {
    font-size: 14px;
    color: #64748b;
    line-height: 1.55;
    margin-bottom: 16px;
}

/* =========================================================
   MODALS
========================================================= */
#subscribersPage .nx-modal .modal-dialog {
    max-width: 1100px;
}

#subscribersPage .nx-modal .modal-dialog-scrollable {
    height: calc(100vh - 40px);
}

#subscribersPage .nx-modal-content {
    border: 0;
    border-radius:3px;
    box-shadow: 0 20px 50px rgba(15, 23, 42, 0.18);
    overflow: hidden;
    height: 100%;
    display: flex;
    flex-direction: column;
    min-height: 0;
}

#subscribersPage .nx-modal-content > form {
    height: 100%;
    display: flex;
    flex-direction: column;
    min-height: 0;
}

#subscribersPage .nx-modal-header {
    padding: 18px 22px;
    border-bottom: 1px solid #eef2f7;
    background: #fff;
    flex-shrink: 0;
}

#subscribersPage .nx-modal-body {
    background: #f8fafc;
    padding: 20px;
    overflow-y: auto;
    flex: 1 1 auto;
    min-height: 0;
}

#subscribersPage .nx-modal-content > form .nx-modal-body {
    flex: 1 1 auto;
    min-height: 0;
    overflow-y: auto;
}

/* Create and edit forms should size to their content until scrolling is needed. */
#subscribersPage #createModal .modal-dialog-scrollable,
#subscribersPage #subscriberEditModal .modal-dialog-scrollable {
    height: auto;
    max-height: calc(100vh - 40px);
}

#subscribersPage #createModal .nx-modal-content,
#subscribersPage #subscriberEditModal .nx-modal-content,
#subscribersPage #createModal .nx-modal-content > form,
#subscribersPage #subscriberEditModal .nx-modal-content > form {
    height: auto;
    max-height: calc(100vh - 40px);
}

#subscribersPage #createModal .nx-modal-body,
#subscribersPage #subscriberEditModal .nx-modal-body {
    flex: 0 1 auto;
}

#subscribersPage .nx-modal-footer {
    padding: 16px 22px;
    border-top: 1px solid #eef2f7;
    background: #fff;
    flex-shrink: 0;
    position: sticky;
    bottom: 0;
    z-index: 2;
}

#subscribersPage .nx-section-card {
    background: #fff;
    border: 1px solid #edf2f7;
    border-radius:3px;
    padding: 18px 18px 14px;
    margin-bottom: 18px;
    box-shadow: 0 4px 18px rgba(15, 23, 42, 0.04);
}

#subscribersPage .nx-section-title {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 26px;
    font-weight: 600;
    color: #1f2937;
    margin-bottom: 14px;
    padding-bottom: 12px;
    border-bottom: 1px solid #eef2f7;
}

#subscribersPage .nx-section-title span {
    font-size: 18px;
}

#subscribersPage .nx-grid-2,
#subscribersPage .nx-subscriber-detail-grid,
#subscribersPage .nx-subscriber-credentials {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px 18px;
}

#subscribersPage .nx-field label {
    display: block;
    font-size: 12px;
    font-weight: 600;
    color: #6b7280;
    margin-bottom: 6px;
    text-transform: uppercase;
    letter-spacing: .04em;
}

#subscribersPage .nx-field div {
    min-height: 42px;
    display: flex;
    align-items: center;
    padding: 10px 12px;
    background: #f8fafc;
    border: 1px solid #eef2f7;
    border-radius:3px;
    color: #111827;
    word-break: break-word;
}

#subscribersPage input[readonly] {
    background: #f8fafc;
    color: #0f172a;
    font-weight: 600;
}

#subscribersPage .password-mask {
    letter-spacing: .08em;
}

/* =========================================================
   SWEETALERT
========================================================= */
.swal2-popup.nx-toast-popup {
    border-radius:3px !important;
    box-shadow: 0 16px 36px rgba(15, 23, 42, .16) !important;
}

/* =========================================================
   RESPONSIVE
========================================================= */
@media (max-width: 1199px) {
    #subscribersPage table {
        table-layout: auto;
        min-width: 1080px;
    }

    #subscribersPage .subs-toolbar-grid {
        grid-template-columns: 1fr;
    }

    #subscribersPage .subs-toolbar-meta {
        text-align: left;
        white-space: normal;
    }
}

@media (max-width: 992px) {
    #subscribersPage .nx-page-header {
        flex-direction: column;
        align-items: flex-start;
    }

    #subscribersPage .nx-page-actions {
        width: 100%;
    }

    #subscribersPage .nx-grid-2,
    #subscribersPage .nx-subscriber-detail-grid,
    #subscribersPage .nx-subscriber-credentials {
        grid-template-columns: 1fr;
    }

    #subscribersPage .nx-modal .modal-dialog {
        max-width: calc(100% - 24px);
        margin: 12px auto;
    }
}

@media (max-width: 767px) {
    #subscribersPage .nx-summary-card {
        min-height: 128px;
        padding: 20px 22px;
    }

    #subscribersPage .nx-content-card .card-body,
    #subscribersPage .nx-toolbar-card .card-body {
        padding-left: 14px;
        padding-right: 14px;
    }
}
/* =========================================================
   SUBSCRIBERS PAGE DARK MODE
========================================================= */

html[data-theme="dark"] #subscribersPage {
    --subs-blue: #60a5fa;
    --subs-blue-dark: #3b82f6;
    --subs-ink: var(--nx-text, #f8fafc);
    --subs-muted: var(--nx-text-muted, #9aabc1);
    --subs-line: var(--nx-control-border-dark, #2f3a46);
    --subs-line-soft: var(--nx-border-soft, #1f2937);
    --subs-surface: var(--nx-panel-surface-dark, #0c2439);
    --subs-surface-soft: var(--nx-control-surface-dark, #212a34);
    --subs-table-head: var(--nx-table-head-surface-dark, #252d36);
    --subs-table-row: var(--nx-table-row-surface-dark, #28323c);
    --subs-table-row-alt: var(--nx-table-row-surface-dark-alt, #2c3742);
    --subs-control-bg: var(--nx-control-surface-dark, #212a34);
    --subs-control-border: var(--nx-control-border-dark, #2f3a46);
    --subs-shadow-soft: none;
    --subs-shadow-lg: none;
}

/* Cards / surfaces */
html[data-theme="dark"] #subscribersPage .nx-page-header-card,
html[data-theme="dark"] #subscribersPage .nx-toolbar-card,
html[data-theme="dark"] #subscribersPage .nx-content-card,
html[data-theme="dark"] #subscribersPage .nx-summary-card,
html[data-theme="dark"] #subscribersPage .nx-section-card {
    /* background: var(--subs-surface) !important; */
    background-image: none !important;
    border-color: var(--subs-line) !important;
    box-shadow: var(--subs-shadow-soft) !important;
}

/* Text */
html[data-theme="dark"] #subscribersPage .nx-page-title,
html[data-theme="dark"] #subscribersPage .nx-summary-value,
html[data-theme="dark"] #subscribersPage .nx-cell-title,
html[data-theme="dark"] #subscribersPage .nx-empty-title,
html[data-theme="dark"] #subscribersPage .nx-section-title,
html[data-theme="dark"] #subscribersPage .nx-field div {
    color: var(--subs-ink) !important;
}

html[data-theme="dark"] #subscribersPage .nx-page-subtitle,
html[data-theme="dark"] #subscribersPage .nx-summary-label,
html[data-theme="dark"] #subscribersPage .nx-summary-text,
html[data-theme="dark"] #subscribersPage .subs-toolbar-note,
html[data-theme="dark"] #subscribersPage .subs-pagination-top,
html[data-theme="dark"] #subscribersPage .nx-cell-sub,
html[data-theme="dark"] #subscribersPage .sort-indicator,
html[data-theme="dark"] #subscribersPage .nx-empty-text,
html[data-theme="dark"] #subscribersPage .nx-field label {
    color: var(--subs-muted) !important;
}

/* Badge */
html[data-theme="dark"] #subscribersPage .subs-hero-badge {
    background: transparent !important;
    color: #93c5fd !important;
    border: 0 !important;
}

/* Buttons */
html[data-theme="dark"] #subscribersPage .btn-light.nx-header-btn {
    background: var(--subs-control-bg) !important;
    border-color: var(--subs-control-border) !important;
    color: #e5e7eb !important;
}

html[data-theme="dark"] #subscribersPage .btn-light.nx-header-btn:hover {
    background: var(--subs-surface-soft) !important;
    color: #ffffff !important;
}

/* Forms */
html[data-theme="dark"] #subscribersPage .form-control,
html[data-theme="dark"] #subscribersPage .form-select,
html[data-theme="dark"] #subscribersPage .subs-toolbar-control,
html[data-theme="dark"] #subscribersPage input[readonly] {
    background: var(--subs-control-bg) !important;
    border-color: var(--subs-control-border) !important;
    color: #f8fafc !important;
}

html[data-theme="dark"] #subscribersPage .form-control::placeholder,
html[data-theme="dark"] #subscribersPage .subs-toolbar-control::placeholder {
    color: #64748b !important;
}

html[data-theme="dark"] #subscribersPage .subs-search-icon {
    color: #64748b !important;
}

/* Tables */
html[data-theme="dark"] #subscribersPage .nx-table-wrap,
html[data-theme="dark"] #subscribersPage table,
html[data-theme="dark"] #subscribersPage .table {
    /* background: var(--subs-surface) !important; */
    color: #dbe4f0 !important;
}

html[data-theme="dark"] #subscribersPage .table thead,
html[data-theme="dark"] #subscribersPage .table thead tr,
html[data-theme="dark"] #subscribersPage .table thead th {
    background: var(--subs-table-head) !important;
    color: var(--subs-muted) !important;
    border-color: var(--subs-line) !important;
}

html[data-theme="dark"] #subscribersPage .table tbody,
html[data-theme="dark"] #subscribersPage .table tbody tr,
html[data-theme="dark"] #subscribersPage .table tbody td {
    /* background: var(--subs-table-row) !important; */
    color: var(--subs-ink) !important;
    border-color: var(--subs-line) !important;
}

html[data-theme="dark"] #subscribersPage .table tbody tr:hover,
html[data-theme="dark"] #subscribersPage .table tbody tr:hover td {
    /* background: var(--subs-table-row-alt) !important; */
    color: #ffffff !important;
}

html[data-theme="dark"] #subscribersPage .table > :not(caption) > * > * {
    background-color: transparent !important;
    color: inherit !important;
    box-shadow: none !important;
}

/* Action buttons */
html[data-theme="dark"] #subscribersPage .btn-outline-secondary.nx-icon-btn,
html[data-theme="dark"] #subscribersPage .btn-outline-primary.nx-icon-btn,
html[data-theme="dark"] #subscribersPage .btn-outline-warning.nx-icon-btn,
html[data-theme="dark"] #subscribersPage .btn-outline-success.nx-icon-btn,
html[data-theme="dark"] #subscribersPage .btn-outline-danger.nx-icon-btn {
    background: var(--subs-control-bg) !important;
    border-color: var(--subs-control-border) !important;
}

html[data-theme="dark"] #subscribersPage .btn-outline-secondary.nx-icon-btn { color: #cbd5e1 !important; }
html[data-theme="dark"] #subscribersPage .btn-outline-primary.nx-icon-btn { color: #60a5fa !important; }
html[data-theme="dark"] #subscribersPage .btn-outline-warning.nx-icon-btn { color: #fbbf24 !important; }
html[data-theme="dark"] #subscribersPage .btn-outline-success.nx-icon-btn { color: #4ade80 !important; }
html[data-theme="dark"] #subscribersPage .btn-outline-danger.nx-icon-btn { color: #f87171 !important; }

html[data-theme="dark"] #subscribersPage .nx-icon-btn:hover {
    background: var(--subs-surface-soft) !important;
    border-color: var(--subs-control-border) !important;
}

/* Badges */
html[data-theme="dark"] #subscribersPage .nx-soft-badge-success {
    background: #198754 !important;
    color: #ffffff !important;
}

html[data-theme="dark"] #subscribersPage .nx-soft-badge-danger {
    background: #7f1d1d !important;
    color: #ffffff !important;
}

html[data-theme="dark"] #subscribersPage .nx-soft-badge-warning {
    background: #b45309 !important;
    color: #ffffff !important;
}

html[data-theme="dark"] #subscribersPage .nx-soft-badge-info {
    background: #0ea5e9 !important;
    color: #ffffff !important;
}

/* Empty state */
html[data-theme="dark"] #subscribersPage .nx-empty-icon {
    background: rgba(59, 130, 246, .14) !important;
    color: #60a5fa !important;
}

/* Modals */
html[data-theme="dark"] #subscribersPage .nx-modal-content {
    background: var(--subs-surface) !important;
    color: #f8fafc !important;
    border: 1px solid var(--subs-line) !important;
}

html[data-theme="dark"] #subscribersPage .nx-modal-header,
html[data-theme="dark"] #subscribersPage .nx-modal-footer {
    background: var(--subs-surface) !important;
    border-color: var(--subs-line) !important;
}

html[data-theme="dark"] #subscribersPage .nx-modal-body {
    background: var(--subs-surface-soft) !important;
}

html[data-theme="dark"] #subscribersPage .nx-field div {
    background: var(--subs-control-bg) !important;
    border-color: var(--subs-control-border) !important;
}
/* =========================================================
   SUBSCRIBER ACTION BUTTON VISIBILITY FIX - DARK MODE
========================================================= */

html[data-theme="dark"] #subscribersPage .nx-subscriber-actions .nx-icon-btn {
    background: var(--subs-control-bg) !important;
    border: 1px solid var(--subs-control-border) !important;
    opacity: 1 !important;
    visibility: visible !important;
}

html[data-theme="dark"] #subscribersPage .nx-subscriber-actions .nx-icon-btn i {
    opacity: 1 !important;
}

html[data-theme="dark"] #subscribersPage .nx-subscriber-actions .btn-outline-secondary {
    color: #cbd5e1 !important;
}

html[data-theme="dark"] #subscribersPage .nx-subscriber-actions .btn-outline-primary {
    color: #60a5fa !important;
}

html[data-theme="dark"] #subscribersPage .nx-subscriber-actions .btn-outline-warning {
    color: #fbbf24 !important;
}

html[data-theme="dark"] #subscribersPage .nx-subscriber-actions .btn-outline-success {
    color: #4ade80 !important;
}

html[data-theme="dark"] #subscribersPage .nx-subscriber-actions .btn-outline-danger {
    color: #f87171 !important;
}

html[data-theme="dark"] #subscribersPage .nx-subscriber-actions .nx-icon-btn:hover {
    background: var(--subs-surface-soft) !important;
    border-color: var(--subs-control-border) !important;
    color: #ffffff !important;
    transform: translateY(-1px);
}

/* disabled action buttons should still be visible */
html[data-theme="dark"] #subscribersPage .nx-subscriber-actions .nx-icon-btn:disabled,
html[data-theme="dark"] #subscribersPage .nx-subscriber-actions .nx-icon-btn.disabled {
    background: var(--subs-control-bg) !important;
    border-color: var(--subs-control-border) !important;
    color: #64748b !important;
    opacity: .65 !important;
}
/* =========================================================
   SUBSCRIBERS ACTION BUTTON DARK ICON FIX
   Place at VERY BOTTOM
========================================================= */

html[data-theme="dark"] #subscribersPage .btn-outline-dark.nx-icon-btn {
    background: var(--subs-control-bg) !important;
    border-color: var(--subs-control-border) !important;
    color: #cbd5e1 !important;
}

html[data-theme="dark"] #subscribersPage .btn-outline-dark.nx-icon-btn:hover {
    background: var(--subs-surface-soft) !important;
    border-color: var(--subs-control-border) !important;
    color: #ffffff !important;
}

html[data-theme="dark"] #subscribersPage .btn-outline-dark.nx-icon-btn i,
html[data-theme="dark"] #subscribersPage .btn-outline-dark.nx-icon-btn .bi,
html[data-theme="dark"] #subscribersPage .btn-outline-dark.nx-icon-btn .bi::before {
    color: #cbd5e1 !important;
    opacity: 1 !important;
    visibility: visible !important;
}

html[data-theme="dark"] #subscribersPage .btn-outline-dark.nx-icon-btn:hover i,
html[data-theme="dark"] #subscribersPage .btn-outline-dark.nx-icon-btn:hover .bi::before {
    color: #ffffff !important;
}

/* =========================================================
   UI AI-SLOP AUDIT
   Use flat operational surfaces and one consistent type scale.
========================================================= */

#subscribersPage {
    --subs-blue: #2f5f8f;
    --subs-blue-dark: #244b70;
    --subs-ink: #172033;
    --subs-muted: #65748a;
    --subs-line: #d8e0e8;
    --subs-surface: #ffffff;
    --subs-surface-soft: #f5f7f9;
    --subs-shadow-soft: none;
    --subs-shadow-lg: none;
}

#subscribersPage .nx-page-header-card,
#subscribersPage .nx-toolbar-card,
#subscribersPage .nx-content-card,
#subscribersPage .nx-summary-card {
    border-color: var(--subs-line) !important;
    background: transparent !important;
    background-image: none !important;
    box-shadow: none !important;
}

#subscribersPage .nx-page-header {
    min-height: 112px;
    padding: 20px 24px;
}

#subscribersPage .subs-hero-badge {
    padding: 4px 9px;
    margin-bottom: 10px;
    border-radius: 2px;
    background: #eef3f7 !important;
    border: 1px solid #d4e0ea;
    color: var(--subs-blue-dark);
    font-size: 11px;
}

#subscribersPage .nx-page-title {
    font-size: 21px;
    font-weight: 700;
}

#subscribersPage .nx-summary-card {
    min-height: 132px;
    padding: 20px 22px;
    border-radius: 2px;
}

#subscribersPage .toolbar-grid {
    min-height: 0 !important;
    padding: 0 !important;
    border-radius: 2px;
}

#subscribersPage .nx-summary-card::before {
    display: none;
}

#subscribersPage .nx-summary-label {
    font-size: 12px;
    font-weight: 650;
}

#subscribersPage .nx-summary-value {
    font-size: 23px;
    font-weight: 700;
}

#subscribersPage .nx-summary-text {
    font-size: 14px;
}

#subscribersPage .nx-summary-icon {
    width: 36px;
    height: 36px;
    border-radius: 2px;
    background: #eef3f7 !important;
    color: var(--subs-blue-dark);
}

#subscribersPage .nx-summary-success .nx-summary-icon { color: #2d7a59; }
#subscribersPage .nx-summary-danger .nx-summary-icon { color: #a64b4b; }
#subscribersPage .nx-summary-cyan .nx-summary-icon { color: #2f748d; }

#subscribersPage .nx-toolbar-card .card-body {
    padding: 16px 18px;
}

#subscribersPage .subs-toolbar-control {
    height: 44px;
    min-height: 44px;
    border-color: #cbd5df;
    font-size: 14px;
}

#subscribersPage .subs-toolbar-control:focus {
    border-color: #8998a8;
    box-shadow: 0 0 0 2px rgba(100, 116, 139, .14);
}

#subscribersPage .subs-table-topline {
    display: none;
}

#subscribersPage .nx-content-card .card-body {
    padding: 0 18px 14px;
}

#subscribersPage .table thead th {
    color: #526276;
    background: #f5f7f9;
    border-bottom: 1px solid var(--subs-line);
}

#subscribersPage .table tbody td {
    border-bottom-color: #e7ecf1;
}

#subscribersPage .table tbody th {
    padding-top: 0px !important;
    padding-bottom: 0px !important;
    height: 37px !important;
}

#subscribersPage .nx-cell-title {
    font-size: 14px;
    font-weight: 650;
}

#subscribersPage .nx-cell-sub {
    font-size: 13px;
}

#subscribersPage .nx-icon-btn {
    width: 34px;
    height: 34px;
    min-width: 34px;
    min-height: 34px;
    border-color: #cbd5df !important;
    color: #526276;
}

#subscribersPage .btn-primary.nx-header-btn,
#subscribersPage .btn-primary {
    background: var(--subs-blue-dark) !important;
    border-color: var(--subs-blue-dark) !important;
    box-shadow: none !important;
}

#subscribersPage .btn-primary.nx-header-btn:hover,
#subscribersPage .btn-primary.nx-header-btn:focus,
#subscribersPage .btn-primary:hover,
#subscribersPage .btn-primary:focus {
    background: #1d3f5e !important;
    border-color: #1d3f5e !important;
}

#subscribersPage .form-control:focus,
#subscribersPage .form-select:focus {
    border-color: #8998a8 !important;
    box-shadow: 0 0 0 2px rgba(100, 116, 139, .14) !important;
}

#subscribersPage .nx-modal-content {
    box-shadow: 0 18px 44px rgba(15, 23, 42, .14);
}

#subscribersPage .nx-modal-body {
    background: #f5f7f9;
    padding: 18px;
}

#subscribersPage .nx-section-card {
    border-color: var(--subs-line);
    border-radius: 2px;
    padding: 16px 18px 14px;
    margin-bottom: 12px;
    box-shadow: none;
}

#subscribersPage .nx-section-title {
    font-size: 18px;
    font-weight: 650;
    padding-bottom: 10px;
    border-bottom-color: #e3e9ef;
}

#subscribersPage .nx-section-title span {
    font-size: inherit;
}

html[data-theme="dark"] #subscribersPage .nx-page-header-card,
html[data-theme="dark"] #subscribersPage .nx-toolbar-card,
html[data-theme="dark"] #subscribersPage .nx-content-card,
html[data-theme="dark"] #subscribersPage .nx-summary-card,
html[data-theme="dark"] #subscribersPage .nx-section-card {
    /* background: #182235 !important; */
    background-image: none !important;
    border-color: #344456 !important;
    box-shadow: none !important;
}

html[data-theme="dark"] #subscribersPage .subs-hero-badge,
html[data-theme="dark"] #subscribersPage .nx-summary-icon {
    background: #213247 !important;
    border-color: #344456 !important;
    color: #a9c5dd !important;
}

html[data-theme="dark"] #subscribersPage .subs-hero-badge {
    border: 1px solid #344456 !important;
}

html[data-theme="dark"] #subscribersPage .nx-modal-body {
    background: #101827 !important;
}

html[data-theme="dark"] #subscribersPage .nx-section-title {
    border-bottom-color: #344456 !important;
}

html body#nxApplication .main-content .nx-toolbar-card .card-body {
    padding: 0 !important;
}

#subscribersPage .nx-content-card .card-body {
    padding: 0 !important;
}

html[data-theme="dark"] #subscribersPage table, html[data-theme="dark"] #subscribersPage .table {
    width: 100%;
}

html[data-theme="dark"] .main-content .nx-table-wrap {
    background: none !important;
}

/* Match the bordered summary-card treatment used by Plans. */
#subscribersPage .nx-summary-card {
    border: 1px solid #d7e0ea !important;
}

/* The toolbar is only a layout wrapper; keep the search control itself visible. */
#subscribersPage .nx-toolbar-card {
    border: 0 !important;
    background: transparent !important;
    box-shadow: none !important;
}

html[data-theme="dark"] #subscribersPage .nx-summary-card {
    border-color: #344456 !important;
}

/* These selectors intentionally match nx.css' high-specificity theme rules. */
html body#nxApplication .main-content #subscribersPage .nx-summary-card {
    border: 1px solid #d7e0ea !important;
    box-shadow: none !important;
}

html body#nxApplication .main-content #subscribersPage .nx-toolbar-card {
    border: 0 !important;
    background: transparent !important;
    box-shadow: none !important;
}

html[data-theme="dark"] body#nxApplication .main-content #subscribersPage .nx-summary-card {
    border-color: #344456 !important;
}

/*
 * Light-theme table contract: keep Subscribers visually aligned with the
 * Plans table.  The table wrapper remains responsive; only its surfaces,
 * separators and controls are normalized here.
 */
html:not([data-theme="dark"]) body#nxApplication .main-content #subscribersPage .table-container,
html:not([data-theme="dark"]) body#nxApplication .main-content #subscribersPage .nx-table-wrap,
html:not([data-theme="dark"]) body#nxApplication .main-content #subscribersPage table,
html:not([data-theme="dark"]) body#nxApplication .main-content #subscribersPage .table {
    background: transparent !important;
    background-image: none !important;
    box-shadow: none !important;
}

html:not([data-theme="dark"]) body#nxApplication .main-content #subscribersPage table,
html:not([data-theme="dark"]) body#nxApplication .main-content #subscribersPage .table {
    border: 1px solid var(--nx-table-border-light) !important;
    border-collapse: separate !important;
    border-spacing: 0 !important;
}

html:not([data-theme="dark"]) body#nxApplication .main-content #subscribersPage .table thead,
html:not([data-theme="dark"]) body#nxApplication .main-content #subscribersPage .table thead tr,
html:not([data-theme="dark"]) body#nxApplication .main-content #subscribersPage .table thead th {
    background: var(--nx-table-head-surface-light) !important;
    background-image: none !important;
    color: var(--nx-text-muted) !important;
    border-color: var(--nx-table-border-light) !important;
}

html:not([data-theme="dark"]) body#nxApplication .main-content #subscribersPage .table tbody,
html:not([data-theme="dark"]) body#nxApplication .main-content #subscribersPage .table tbody tr,
html:not([data-theme="dark"]) body#nxApplication .main-content #subscribersPage .table tbody td {
    background: var(--nx-table-row-surface-light) !important;
    background-image: none !important;
    color: var(--nx-text) !important;
    border-color: var(--nx-table-border-light) !important;
}

html:not([data-theme="dark"]) body#nxApplication .main-content #subscribersPage .table tbody tr:nth-child(even),
html:not([data-theme="dark"]) body#nxApplication .main-content #subscribersPage .table tbody tr:nth-child(even) td {
    background: var(--nx-table-row-surface-light-alt) !important;
}

html:not([data-theme="dark"]) body#nxApplication .main-content #subscribersPage .table .nx-icon-btn,
html:not([data-theme="dark"]) body#nxApplication .main-content #subscribersPage .table .btn.nx-icon-btn {
    background: #f1f4f7 !important;
    border: 1px solid #d7e0ea !important;
    color: #315b82 !important;
    box-shadow: none !important;
}

html:not([data-theme="dark"]) body#nxApplication .main-content #subscribersPage .table .nx-icon-btn:hover,
html:not([data-theme="dark"]) body#nxApplication .main-content #subscribersPage .table .btn.nx-icon-btn:hover {
    background: #e7edf3 !important;
    border-color: #c3d0dd !important;
}
