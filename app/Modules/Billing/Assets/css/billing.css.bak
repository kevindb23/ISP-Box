/* Module override layer: shared shell, panels, tables, controls, and theme
   tokens are defined in public/assets/css/nx.css. Keep this file scoped to
   billing-specific layout and visual exceptions only. */
#billingPage {
    --billing-blue: #2563eb;
    --billing-blue-dark: #1d4ed8;
    --billing-blue-soft: #eff6ff;

    --billing-green: #16a34a;
    --billing-green-dark: #15803d;
    --billing-green-soft: #ecfdf5;

    --billing-amber: #f59e0b;
    --billing-amber-dark: #b45309;
    --billing-amber-soft: #fffbeb;

    --billing-orange: #ea580c;
    --billing-orange-soft: #fff7ed;

    --billing-red: #ef4444;
    --billing-red-dark: #b91c1c;
    --billing-red-soft: #fef2f2;

    --billing-purple: #7c3aed;
    --billing-purple-soft: #f5f3ff;

    --billing-cyan: #0891b2;
    --billing-cyan-soft: #ecfeff;

    --billing-ink: #0f172a;
    --billing-ink-soft: #334155;
    --billing-muted: #64748b;
    --billing-muted-soft: #94a3b8;
    --billing-line: #e2e8f0;
    --billing-line-soft: #edf2f7;

    --billing-surface: #ffffff;
    --billing-surface-soft: #f8fafc;
    --billing-surface-glass: rgba(255, 255, 255, 0.84);

    --billing-radius-xl: 28px;
    --billing-radius-lg: 22px;
    --billing-radius-md: 16px;
    --billing-radius-sm: 12px;

    --billing-shadow-xs: 0 4px 12px rgba(15, 23, 42, 0.035);
    --billing-shadow-soft: 0 10px 26px rgba(15, 23, 42, 0.045);
    --billing-shadow-md: 0 16px 36px rgba(15, 23, 42, 0.065);
    --billing-shadow-lg: 0 22px 52px rgba(15, 23, 42, 0.095);
    --billing-shadow-blue: 0 14px 28px rgba(37, 99, 235, 0.20);

    color: var(--billing-ink);
    padding-bottom: 44px;
}

#billingPage * {
    box-sizing: border-box;
}

#billingPage .card {
    border-radius:3px;
}

#billingPage .btn {
    border-radius:3px;
    font-weight: 750;
    letter-spacing: -0.01em;
    transition:
            transform 0.16s ease,
            box-shadow 0.16s ease,
            border-color 0.16s ease,
            background 0.16s ease,
            color 0.16s ease;
}

#billingPage .btn:hover {
    transform: translateY(-1px);
}

#billingPage .btn-sm {
    border-radius:3px;
}

#billingPage .form-control,
#billingPage .form-select {
    border-radius:3px;
    border-color: var(--billing-line);
    color: var(--billing-ink);
    box-shadow: none;
    transition: border-color 0.16s ease, box-shadow 0.16s ease, background 0.16s ease;
}

#billingPage .form-control:focus,
#billingPage .form-select:focus {
    border-color: rgba(37, 99, 235, 0.55);
    box-shadow: 0 0 0 4px rgba(37, 99, 235, 0.10);
}

#billingPage .text-muted {
    color: var(--billing-muted) !important;
}

/* =========================================================
   HEADER
========================================================= */

#billingPage .billing-hero {
    position: relative;
    margin-bottom: 16px !important;
    border-radius:3px;
    overflow: hidden;
    border: 1px solid rgba(37, 99, 235, 0.10);
    background:
            radial-gradient(circle at 5% 10%, rgba(37, 99, 235, 0.14), transparent 30%),
            radial-gradient(circle at 92% 18%, rgba(14, 165, 233, 0.14), transparent 28%),
            radial-gradient(circle at 75% 100%, rgba(124, 58, 237, 0.07), transparent 32%),
            linear-gradient(135deg, #ffffff 0%, #f8fbff 48%, #eef7ff 100%);
    box-shadow: var(--billing-shadow-soft);
}

#billingPage .billing-hero::before {
    content: "";
    position: absolute;
    inset: 0;
    background-image:
            linear-gradient(rgba(37, 99, 235, 0.035) 1px, transparent 1px),
            linear-gradient(90deg, rgba(37, 99, 235, 0.035) 1px, transparent 1px);
    background-size: 34px 34px;
    mask-image: linear-gradient(90deg, rgba(0, 0, 0, 0.70), transparent 78%);
    pointer-events: none;
}

#billingPage .billing-hero::after {
    content: "";
    position: absolute;
    width: 250px;
    height: 250px;
    right: -86px;
    top: -98px;
    border-radius: 50%;
    background: rgba(37, 99, 235, 0.08);
    border: 1px solid rgba(37, 99, 235, 0.08);
    pointer-events: none;
}

#billingPage .nx-page-header {
    position: relative;
    z-index: 1;
    display: flex;
    justify-content: space-between;
    gap: 24px;
    align-items: center;
    padding: 22px 24px;
}

#billingPage .nx-page-header-left {
    min-width: 0;
}

#billingPage .nx-page-title {
    margin: 0;
    color: var(--billing-ink);
    font-size: 22px;
    font-weight: 950;
    letter-spacing: -0.04em;
}

#billingPage .nx-page-subtitle {
    margin-top: 5px;
    color: var(--billing-muted);
    font-size: 12.5px;
    line-height: 1.4;
}

#billingPage .billing-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: 6px 10px;
    margin-bottom: 10px;
    border-radius:3px;
    color: var(--billing-blue-dark);
    background: rgba(37, 99, 235, 0.09);
    border: 1px solid rgba(37, 99, 235, 0.10);
    font-size: 10.5px;
    font-weight: 900;
    letter-spacing: 0.055em;
    text-transform: uppercase;
}

#billingPage .billing-ph-note {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    margin-top: 8px;
    color: #334155;
    font-size: 11.5px;
    font-weight: 750;
}

#billingPage .billing-ph-note i {
    color: var(--billing-blue);
}

#billingPage .nx-page-actions,
#billingPage .billing-hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 9px;
    justify-content: flex-end;
    align-items: center;
}

#billingPage .nx-header-btn {
    min-height: 38px;
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding-inline: 13px;
    box-shadow: var(--billing-shadow-xs);
}

#billingPage .nx-header-btn.btn-primary,
#billingPage .nx-header-btn.btn-success,
#billingPage .nx-header-btn.btn-warning {
    border: 0;
}

/* =========================================================
   STATS
========================================================= */

#billingPage .billing-stats-grid {
    margin-top: 0;
    margin-bottom: 14px !important;
}

#billingPage .nx-summary-card,
#billingPage .billing-stat-card {
    position: relative;
    min-height: 92px;
    display: flex;
    gap: 13px;
    align-items: center;
    padding: 15px 16px;
    border-radius:3px;
    border: 1px solid rgba(226, 232, 240, 0.86);
    background:
            radial-gradient(circle at 95% 12%, rgba(37, 99, 235, 0.07), transparent 26%),
            linear-gradient(180deg, #ffffff 0%, #fbfdff 100%);
    box-shadow: var(--billing-shadow-soft);
    overflow: hidden;
    transition: transform 0.18s ease, box-shadow 0.18s ease, border-color 0.18s ease;
}

#billingPage .nx-summary-card:hover,
#billingPage .billing-stat-card:hover {
    transform: translateY(-2px);
    border-color: rgba(37, 99, 235, 0.18);
    box-shadow: var(--billing-shadow-md);
}

#billingPage .nx-summary-top {
    width: 100%;
    display: flex;
    justify-content: space-between;
    gap: 14px;
    align-items: flex-start;
}

#billingPage .nx-summary-label,
#billingPage .billing-stat-label {
    color: var(--billing-muted);
    font-size: 10.5px;
    font-weight: 900;
    text-transform: uppercase;
    letter-spacing: 0.07em;
}

#billingPage .nx-summary-value,
#billingPage .billing-stat-value {
    margin-top: 5px;
    color: var(--billing-ink);
    font-size: clamp(20px, 1.9vw, 26px);
    font-weight: 950;
    line-height: 1.05;
    letter-spacing: -0.05em;
    font-variant-numeric: tabular-nums;
}

#billingPage .nx-summary-text,
#billingPage .billing-stat-help {
    margin-top: 5px;
    color: var(--billing-muted);
    font-size: 11.5px;
    line-height: 1.3;
}

#billingPage .nx-summary-icon,
#billingPage .billing-stat-icon {
    width: 42px;
    height: 42px;
    flex: 0 0 42px;
    display: grid;
    place-items: center;
    border-radius:3px;
    font-size: 18px;
    background: var(--billing-blue-soft);
    color: var(--billing-blue);
}

#billingPage .nx-summary-primary .nx-summary-icon,
#billingPage .billing-stat-primary .billing-stat-icon {
    background: var(--billing-blue-soft);
    color: var(--billing-blue);
}

#billingPage .nx-summary-success .nx-summary-icon,
#billingPage .billing-stat-success .billing-stat-icon {
    background: var(--billing-green-soft);
    color: var(--billing-green);
}

#billingPage .nx-summary-warning .nx-summary-icon,
#billingPage .billing-stat-warning .billing-stat-icon {
    background: var(--billing-amber-soft);
    color: var(--billing-amber-dark);
}

#billingPage .nx-summary-danger .nx-summary-icon,
#billingPage .billing-stat-danger .billing-stat-icon {
    background: var(--billing-red-soft);
    color: var(--billing-red);
}

/* =========================================================
   TABS / TOOLBAR / SEARCH
========================================================= */

#billingPage .billing-tabs-card {
    margin-bottom: 14px !important;
    border-radius:3px;
    border: 1px solid rgba(226, 232, 240, 0.86);
    background: rgba(255, 255, 255, 0.92);
    box-shadow: var(--billing-shadow-soft);
    backdrop-filter: blur(12px);
}

#billingPage .billing-tabs-card .card-body {
    padding: 12px;
}

#billingPage .billing-toolbar-grid,
#billingPage .billing-tabs-wrap {
    display: grid;
    grid-template-columns: minmax(0, auto) minmax(320px, 1fr);
    gap: 12px;
    align-items: center;
}

#billingPage .billing-tabs {
    width: fit-content;
    max-width: 100%;
    display: inline-flex;
    gap: 5px;
    padding: 5px;
    border-radius:3px;
    background:
            linear-gradient(180deg, #f8fafc 0%, #eef2f7 100%);
    border: 1px solid rgba(226, 232, 240, 0.90);
    overflow-x: auto;
    scrollbar-width: none;
}

#billingPage .billing-tabs::-webkit-scrollbar {
    display: none;
}

#billingPage .billing-tabs .nx-segment-item {
    border: 0;
    border-radius:3px;
    background: transparent;
    color: #475569;
    padding: 9px 13px;
    font-weight: 850;
    font-size: 12px;
    letter-spacing: -0.01em;
    white-space: nowrap;
    transition: all 0.18s ease;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 7px;
}

#billingPage .billing-tabs .nx-segment-item i {
    font-size: 13px;
}

#billingPage .billing-tabs .nx-segment-item:hover {
    color: var(--billing-blue-dark);
    background: rgba(255, 255, 255, 0.85);
}

#billingPage .billing-tabs .nx-segment-item.active {
    color: #ffffff;
    background: linear-gradient(135deg, var(--billing-blue), var(--billing-blue-dark));
    box-shadow: var(--billing-shadow-blue);
}

#billingPage .billing-tab-tools {
    min-width: 280px;
    width: 100%;
}

#billingPage .billing-search-box {
    position: relative;
    width: 100%;
}

#billingPage .billing-search-box-icon {
    position: absolute;
    left: 15px;
    top: 50%;
    transform: translateY(-50%);
    color: var(--billing-muted-soft);
    font-size: 14px;
    line-height: 1;
    pointer-events: none;
    z-index: 5;
}

#billingPage .billing-search-control {
    width: 100%;
    min-height: 42px;
    padding-left: 42px !important;
    padding-right: 14px;
    border-radius:3px !important;
    border: 1px solid rgba(203, 213, 225, 0.88);
    background: #ffffff;
    color: var(--billing-ink);
    font-size: 12.5px;
}

#billingPage .billing-search-control::placeholder {
    color: #94a3b8;
}

#billingPage .billing-search-control:focus {
    border-color: rgba(37, 99, 235, 0.55);
    box-shadow: 0 0 0 4px rgba(37, 99, 235, 0.10);
}

/* =========================================================
   PANELS / CARDS
========================================================= */

#billingPage .billing-panel {
    display: none;
    animation: billingFadeUp 0.18s ease both;
}

.billing-panel {
    border: 0 !important;
}

#billingPage .billing-panel.active {
    display: block;
}

@keyframes billingFadeUp {
    from {
        opacity: 0;
        transform: translateY(5px);
    }

    to {
        opacity: 1;
        transform: translateY(0);
    }
}

#billingPage .billing-card {
    border-radius:3px;
    overflow: hidden;
    border: 1px solid rgba(226, 232, 240, 0.88);
    background: #ffffff;
    box-shadow: var(--billing-shadow-soft);
}

#billingPage .billing-card-header {
    min-height: 60px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 14px;
    padding: 14px 18px;
    border-bottom: 1px solid rgba(226, 232, 240, 0.82);
    background:
            radial-gradient(circle at top right, rgba(37, 99, 235, 0.04), transparent 30%),
            linear-gradient(180deg, #ffffff 0%, #fbfdff 100%);
}

#billingPage .billing-card-header h6 {
    color: var(--billing-ink);
    font-size: 13.5px;
    font-weight: 900;
    letter-spacing: -0.02em;
}

#billingPage .billing-card-header small {
    font-size: 11.5px;
}

#billingPage .billing-panel-actions {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 10px;
    flex-wrap: nowrap;
    white-space: nowrap;
    min-width: max-content;
}

#billingPage .billing-panel-actions .btn {
    min-height: 36px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 4px;
    white-space: nowrap;
}

#billingPage .billing-panel-actions .billing-filter {
    flex: 0 0 auto;
}

#billingPage .billing-panel-actions-wide {
    min-width: max-content;
}

#billingPage .billing-filter {
    min-width: 150px;
    width: auto;
    min-height: 36px;
    font-size: 12px;
    font-weight: 700;
}

/* =========================================================
   OVERVIEW CLEAN LAYOUT
========================================================= */

#billingPage [data-billing-panel="overview"] > .row {
    margin-bottom: 14px !important;
}

#billingPage .billing-overview-card {
    height: auto;
}

#billingPage .billing-workspace {
    padding: 14px;
}

#billingPage .billing-action-tile {
    width: 100%;
    min-height: 76px;
    border: 1px solid rgba(226, 232, 240, 0.95);
    border-radius:3px;
    background:
            radial-gradient(circle at top right, rgba(37, 99, 235, 0.055), transparent 35%),
            linear-gradient(180deg, #ffffff 0%, #fbfdff 100%);
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 14px;
    text-align: left;
    cursor: pointer;
    transition: all 0.18s ease;
    box-shadow: 0 8px 18px rgba(15, 23, 42, 0.035);
}

#billingPage .billing-action-tile:hover {
    transform: translateY(-2px);
    border-color: rgba(37, 99, 235, 0.30);
    box-shadow: 0 14px 28px rgba(15, 23, 42, 0.065);
}

#billingPage .billing-action-icon {
    width: 40px;
    height: 40px;
    flex: 0 0 40px;
    display: grid;
    place-items: center;
    border-radius:3px;
    font-size: 18px;
    background: var(--billing-blue-soft);
    color: var(--billing-blue);
    border: 1px solid rgba(37, 99, 235, 0.08);
}

#billingPage .billing-action-title {
    color: #0f172a;
    font-size: 13px;
    font-weight: 900;
    margin-bottom: 2px;
}

#billingPage .billing-action-text {
    color: #64748b;
    font-size: 11.5px;
    line-height: 1.3;
}

#billingPage .billing-workspace-note {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    padding: 10px 12px;
    border-radius:3px;
    color: #334155;
    background: #f8fafc;
    border: 1px solid #e2e8f0;
    font-size: 12px;
}

#billingPage .billing-workspace-note > div,
#billingPage .billing-workspace-note span {
    display: inline-flex;
    align-items: center;
    gap: 8px;
}

#billingPage .billing-workspace-note i {
    color: #2563eb;
}

#billingPage .billing-health-list {
    padding: 12px;
    display: grid;
    gap: 9px;
}

#billingPage .billing-health-item {
    min-height: 62px;
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 11px 12px;
    border-radius:3px;
    border: 1px solid #e2e8f0;
    background: #ffffff;
    transition: all 0.18s ease;
}

#billingPage .billing-health-item:hover {
    background: #f8fafc;
    transform: translateY(-1px);
}

#billingPage .billing-health-icon {
    width: 38px;
    height: 38px;
    flex: 0 0 38px;
    display: grid;
    place-items: center;
    border-radius:3px;
    font-size: 17px;
}

/* =========================================================
   TABLES
========================================================= */

#billingPage .nx-table-wrap {
    background: #ffffff;
}

#billingPage .billing-table {
    font-size: 12.5px;
}

#billingPage .billing-table thead th {
    color: #64748b;
    background: #f8fafc;
    border-bottom: 1px solid #e2e8f0;
    font-size: 10px;
    font-weight: 900;
    text-transform: uppercase;
    letter-spacing: 0.065em;
    padding-top: 12px;
    padding-bottom: 12px;
    white-space: nowrap;
}

#billingPage .billing-table tbody td {
    border-bottom: 1px solid rgba(226, 232, 240, 0.72);
    padding-top: 13px;
    padding-bottom: 13px;
    vertical-align: middle;
}

#billingPage [data-billing-panel="overview"] .billing-table tbody td {
    padding-top: 12px;
    padding-bottom: 12px;
}

#billingPage .billing-table tbody tr {
    transition: background 0.14s ease;
}

#billingPage .billing-table tbody tr:hover {
    background: #f8fbff;
}

#billingPage .billing-table tbody tr:last-child td {
    border-bottom: 0;
}

#billingPage .billing-main-text {
    color: #0f172a;
    font-weight: 850;
    letter-spacing: -0.015em;
}

#billingPage .billing-sub-text {
    color: #64748b;
    font-size: 11px;
    line-height: 1.3;
}

#billingPage .billing-money {
    color: #0f172a;
    font-weight: 900;
    letter-spacing: -0.02em;
    font-variant-numeric: tabular-nums;
}

#billingPage .btn-group-sm > .btn,
#billingPage .btn-sm {
    padding: 0.35rem 0.55rem;
}

#billingPage .billing-table .btn-group {
    display: inline-flex;
    align-items: center;
    justify-content: flex-end;
    gap: 6px;
    flex-wrap: nowrap;
}

#billingPage .billing-table .btn-group > .btn {
    margin: 0 !important;
    border-radius:3px !important;
    min-width: 32px;
    min-height: 32px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
}

#billingPage .billing-table .btn-group > .btn:not(:first-child) {
    margin-left: 0 !important;
}

#billingPage .billing-table .btn-group > .btn:not(:last-child):not(.dropdown-toggle) {
    border-top-right-radius: 10px !important;
    border-bottom-right-radius: 10px !important;
}

#billingPage .billing-table .btn-group > .btn:nth-child(n + 3),
#billingPage .billing-table .btn-group > :not(.btn-check) + .btn {
    border-top-left-radius: 10px !important;
    border-bottom-left-radius: 10px !important;
}

/* =========================================================
   BADGES
========================================================= */

#billingPage .billing-badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 74px;
    padding: 5px 9px;
    border-radius:3px;
    font-size: 10px;
    font-weight: 900;
    text-transform: uppercase;
    letter-spacing: 0.045em;
    border: 1px solid transparent;
}

#billingPage .billing-badge.status-paid,
#billingPage .billing-badge.status-posted,
#billingPage .billing-badge.status-success,
#billingPage .billing-badge.status-created {
    color: #047857;
    background: #d1fae5;
    border-color: rgba(4, 120, 87, 0.10);
}

#billingPage .billing-badge.status-unpaid,
#billingPage .billing-badge.status-pending,
#billingPage .billing-badge.status-current {
    color: #1d4ed8;
    background: #dbeafe;
    border-color: rgba(29, 78, 216, 0.10);
}

#billingPage .billing-badge.status-partial,
#billingPage .billing-badge.status-skipped {
    color: #b45309;
    background: #fef3c7;
    border-color: rgba(180, 83, 9, 0.10);
}

#billingPage .billing-badge.status-overdue,
#billingPage .billing-badge.status-failed {
    color: #b91c1c;
    background: #fee2e2;
    border-color: rgba(185, 28, 28, 0.10);
}

#billingPage .billing-badge.status-cancelled,
#billingPage .billing-badge.status-voided,
#billingPage .billing-badge.status-refunded {
    color: #475569;
    background: #e2e8f0;
    border-color: rgba(71, 85, 105, 0.10);
}

#billingPage .billing-badge.status-credit,
#billingPage .billing-badge.status-discount,
#billingPage .billing-badge.status-rebate,
#billingPage .billing-badge.status-waiver {
    color: #047857;
    background: #d1fae5;
}

#billingPage .billing-badge.status-debit,
#billingPage .billing-badge.status-correction {
    color: #b45309;
    background: #fef3c7;
}

/* =========================================================
   RECENT PAYMENT FEED
========================================================= */

#billingPage .billing-payment-feed {
    padding: 10px;
}

#billingPage .billing-payment-item {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
    padding: 12px;
    border: 1px solid rgba(226, 232, 240, 0.86);
    border-radius:3px;
    background:
            linear-gradient(180deg, #ffffff 0%, #fbfdff 100%);
    margin-bottom: 9px;
    transition: transform 0.16s ease, box-shadow 0.16s ease, border-color 0.16s ease;
}

#billingPage .billing-payment-item:hover {
    transform: translateY(-1px);
    border-color: rgba(22, 163, 74, 0.18);
    box-shadow: 0 10px 20px rgba(15, 23, 42, 0.05);
}

#billingPage .billing-payment-item:last-child {
    margin-bottom: 0;
}

#billingPage .billing-payment-icon {
    width: 38px;
    height: 38px;
    flex: 0 0 38px;
    border-radius:3px;
    display: grid;
    place-items: center;
    background: #ecfdf5;
    color: #047857;
    font-size: 17px;
    border: 1px solid rgba(4, 120, 87, 0.08);
}

#billingPage .billing-empty-mini {
    padding: 24px;
    text-align: center;
    color: #64748b;
    font-weight: 600;
}

/* =========================================================
   COLLECTIONS AGING
========================================================= */

#billingPage .billing-aging-grid {
    margin-bottom: 14px;
}

#billingPage .billing-aging-card {
    position: relative;
    width: 100%;
    min-height: 104px;
    padding: 15px;
    border-radius:3px;
    border: 1px solid rgba(226, 232, 240, 0.90);
    background: #ffffff;
    box-shadow: var(--billing-shadow-soft);
    cursor: pointer;
    overflow: hidden;
    transition: transform 0.16s ease, box-shadow 0.16s ease, border-color 0.16s ease;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    text-align: left;
}

#billingPage .billing-aging-card::before {
    content: "";
    position: absolute;
    inset: 0;
    background: radial-gradient(circle at 95% 8%, rgba(37, 99, 235, 0.10), transparent 32%);
    pointer-events: none;
}

#billingPage .billing-aging-card:hover,
#billingPage .billing-aging-card.active {
    transform: translateY(-2px);
    border-color: rgba(37, 99, 235, 0.24);
    box-shadow: var(--billing-shadow-md);
}

#billingPage .billing-aging-card.active {
    background:
            radial-gradient(circle at top right, rgba(37, 99, 235, 0.12), transparent 30%),
            #ffffff;
}

#billingPage .billing-aging-label {
    position: relative;
    color: var(--billing-muted);
    font-size: 10.5px;
    font-weight: 900;
    text-transform: uppercase;
    letter-spacing: 0.06em;
}

#billingPage .billing-aging-value,
#billingPage .billing-aging-amount {
    position: relative;
    margin-top: 7px;
    color: var(--billing-ink);
    font-size: 21px;
    font-weight: 950;
    letter-spacing: -0.045em;
    font-variant-numeric: tabular-nums;
}

#billingPage .billing-aging-count {
    position: relative;
    margin-top: 4px;
    color: var(--billing-muted);
    font-size: 11.5px;
    font-weight: 700;
}

#billingPage .billing-aging-icon {
    position: relative;
    width: 40px;
    height: 40px;
    flex: 0 0 40px;
    display: grid;
    place-items: center;
    border-radius:3px;
    font-size: 18px;
}

#billingPage .billing-aging-current .billing-aging-icon {
    color: #059669;
    background: #ecfdf5;
}

#billingPage .billing-aging-warning .billing-aging-icon {
    color: #d97706;
    background: #fffbeb;
}

#billingPage .billing-aging-orange .billing-aging-icon {
    color: #ea580c;
    background: #fff7ed;
}

#billingPage .billing-aging-danger .billing-aging-icon {
    color: #dc2626;
    background: #fef2f2;
}

#billingPage .billing-aging-critical .billing-aging-icon {
    color: #7f1d1d;
    background: #fee2e2;
}

#billingPage .billing-collections-note {
    padding: 12px 16px;
    display: flex;
    justify-content: space-between;
    gap: 12px;
    align-items: center;
    color: #334155;
    background: #f8fafc;
    border-bottom: 1px solid #e2e8f0;
    font-size: 12.5px;
}

#billingPage .billing-collections-note > div {
    display: flex;
    align-items: center;
    gap: 8px;
}

#billingPage .billing-collections-note i {
    color: #2563eb;
}

#billingPage .billing-collections-asof {
    white-space: nowrap;
}

/* Aging badges */
#billingPage .billing-badge.status-aging-current {
    color: #047857;
    background: #d1fae5;
    border-color: rgba(4, 120, 87, 0.10);
}

#billingPage .billing-badge.status-aging-overdue_1_7 {
    color: #b45309;
    background: #fef3c7;
    border-color: rgba(180, 83, 9, 0.10);
}

#billingPage .billing-badge.status-aging-overdue_8_30 {
    color: #c2410c;
    background: #ffedd5;
    border-color: rgba(194, 65, 12, 0.10);
}

#billingPage .billing-badge.status-aging-overdue_31_60 {
    color: #b91c1c;
    background: #fee2e2;
    border-color: rgba(185, 28, 28, 0.10);
}

#billingPage .billing-badge.status-aging-overdue_60_plus {
    color: #7f1d1d;
    background: #fecaca;
    border-color: rgba(127, 29, 29, 0.10);
}

/* =========================================================
   SETTINGS
========================================================= */

#billingPage .billing-settings-form {
    padding: 18px;
}

#billingPage .billing-settings-form .form-label,
.billing-modal .form-label {
    color: #334155;
    font-size: 11px;
    font-weight: 900;
    text-transform: uppercase;
    letter-spacing: 0.055em;
}

#billingPage .billing-settings-form .form-control {
    min-height: 42px;
    border-radius:3px;
    border-color: #dbe3ef;
}

#billingPage .billing-toggle-card {
    min-height: 88px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 14px;
    padding: 15px;
    border-radius:3px;
    border: 1px solid #e2e8f0;
    background:
            radial-gradient(circle at top right, rgba(37, 99, 235, 0.045), transparent 34%),
            #f8fafc;
}

/* =========================================================
   MODALS
========================================================= */

.billing-modal {
    border: 0;
    border-radius:3px;
    overflow: hidden;
    box-shadow: 0 30px 80px rgba(15, 23, 42, 0.25);
}

.billing-modal .modal-header {
    padding: 20px 22px;
    border-bottom: 1px solid #e2e8f0;
    background:
            radial-gradient(circle at top left, rgba(37, 99, 235, 0.10), transparent 36%),
            radial-gradient(circle at top right, rgba(14, 165, 233, 0.08), transparent 30%),
            linear-gradient(180deg, #ffffff 0%, #f8fafc 100%);
}

.billing-modal .modal-title {
    color: #0f172a;
    font-weight: 900;
    letter-spacing: -0.025em;
}

.billing-modal .modal-body {
    padding: 22px;
    background: #f8fafc;
}

.billing-modal .modal-footer {
    padding: 16px 22px;
    border-top: 1px solid #e2e8f0;
    background: #ffffff;
}

.billing-custom-item-box,
.nx-section-card {
    padding: 16px;
    border-radius:3px;
    border: 1px solid #e2e8f0;
    background: #ffffff;
    box-shadow: 0 8px 20px rgba(15, 23, 42, 0.035);
    margin-bottom: 16px;
}

.nx-section-card:last-child {
    margin-bottom: 0;
}

.nx-section-title {
    display: flex;
    align-items: center;
    gap: 8px;
    color: #0f172a;
    font-size: 13px;
    font-weight: 900;
    letter-spacing: -0.015em;
}

.nx-grid-2 {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 14px;
}

.nx-span-2 {
    grid-column: span 2;
}

.billing-detail-grid {
    display: grid;
    grid-template-columns: 1.2fr 0.8fr;
    gap: 16px;
}

.billing-detail-box {
    border: 1px solid #e2e8f0;
    border-radius:3px;
    padding: 16px;
    background: #ffffff;
    box-shadow: 0 8px 20px rgba(15, 23, 42, 0.035);
}

.billing-detail-label {
    color: #64748b;
    font-size: 11px;
    font-weight: 900;
    text-transform: uppercase;
    letter-spacing: 0.055em;
}

.billing-detail-value {
    color: #0f172a;
    font-weight: 900;
}

.billing-mini-stat {
    padding: 12px;
    border-radius:3px;
    background: #f8fafc;
    border: 1px solid #e2e8f0;
}

/* =========================================================
   EMPTY STATES
========================================================= */

#billingPage td.text-center.text-muted.py-4,
#billingPage .billing-empty-state {
    color: #64748b !important;
    font-weight: 650;
}

#billingPage td.text-center.text-muted.py-4::before {
    content: "";
    display: block;
    width: 34px;
    height: 34px;
    margin: 0 auto 8px;
    border-radius:3px;
    background:
            linear-gradient(135deg, rgba(37, 99, 235, 0.12), rgba(14, 165, 233, 0.08));
}

/* =========================================================
   SMALL UTILITIES
========================================================= */

#billingPage .billing-clickable {
    cursor: pointer;
}

#billingPage .billing-soft-divider {
    height: 1px;
    background: var(--billing-line);
    margin: 14px 0;
}

#billingPage .billing-pill {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 6px 10px;
    border-radius:3px;
    color: var(--billing-muted);
    background: #f8fafc;
    border: 1px solid var(--billing-line);
    font-size: 12px;
    font-weight: 800;
}

/* =========================================================
   RESPONSIVE
========================================================= */

@media (min-width: 1400px) {
    #billingPage [data-billing-panel="overview"] > .row:first-child > .col-xl-8 {
        width: 68%;
    }

    #billingPage [data-billing-panel="overview"] > .row:first-child > .col-xl-4 {
        width: 32%;
    }
}

@media (max-width: 1200px) {
    #billingPage .billing-toolbar-grid,
    #billingPage .billing-tabs-wrap {
        grid-template-columns: 1fr;
    }

    #billingPage .billing-tabs {
        width: 100%;
    }

    #billingPage .billing-tabs .nx-segment-item {
        flex: 1 0 auto;
    }
}

@media (max-width: 992px) {
    #billingPage .nx-page-header,
    #billingPage .billing-card-header {
        align-items: stretch;
        flex-direction: column;
    }

    #billingPage .nx-page-actions,
    #billingPage .billing-hero-actions {
        justify-content: flex-start;
    }

    #billingPage .billing-tab-tools {
        min-width: 100%;
    }

    #billingPage .billing-search-box {
        width: 100%;
    }

    #billingPage .billing-panel-actions,
    #billingPage .billing-panel-actions-wide {
        width: 100%;
        min-width: 0;
        justify-content: flex-start;
        flex-wrap: wrap;
    }

    #billingPage .billing-panel-actions .billing-filter {
        flex: 0 0 auto;
    }

    #billingPage .billing-workspace-note,
    #billingPage .billing-collections-note {
        align-items: flex-start;
        flex-direction: column;
    }

    .billing-detail-grid,
    .nx-grid-2 {
        grid-template-columns: 1fr;
    }

    .nx-span-2 {
        grid-column: span 1;
    }
}

@media (max-width: 768px) {
    #billingPage .nx-page-header {
        padding: 20px;
    }

    #billingPage .billing-tabs {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        width: 100%;
    }

    #billingPage .billing-tabs .nx-segment-item {
        justify-content: center;
    }

    #billingPage .billing-card-header .d-flex {
        width: 100%;
    }

    #billingPage .billing-panel-actions {
        display: grid;
        grid-template-columns: 1fr;
        gap: 8px;
    }

    #billingPage .billing-panel-actions .btn,
    #billingPage .billing-panel-actions .billing-filter {
        width: 100%;
        min-width: 100%;
    }

    #billingPage .billing-filter {
        min-width: 100%;
    }

    #billingPage .billing-table {
        min-width: 860px;
    }

    #billingPage .billing-table .btn-group {
        gap: 7px;
    }

    #billingPage .billing-aging-card {
        min-height: 98px;
    }
}

@media (max-width: 576px) {
    #billingPage .nx-page-title {
        font-size: 20px;
    }

    #billingPage .nx-page-actions .btn,
    #billingPage .billing-hero-actions .btn {
        width: 100%;
        justify-content: center;
    }

    #billingPage .billing-tabs {
        grid-template-columns: 1fr;
    }

    #billingPage .nx-summary-card,
    #billingPage .billing-stat-card {
        min-height: 88px;
    }

    #billingPage .nx-summary-value,
    #billingPage .billing-stat-value {
        font-size: 21px;
    }

    #billingPage .billing-collections-asof {
        white-space: normal;
    }

    #billingPage .billing-payment-item {
        align-items: flex-start;
        flex-direction: column;
    }

    #billingPage .billing-payment-item .text-end {
        width: 100%;
        text-align: left !important;
    }
}

/* =========================================================
   BILLING DARK MODE POLISH
   Place at VERY BOTTOM of Billing.css
========================================================= */

html[data-theme="dark"] #billingPage {
    --billing-blue: #60a5fa;
    --billing-blue-dark: #3b82f6;
    --billing-blue-soft: rgba(59, 130, 246, .14);

    --billing-green: #4ade80;
    --billing-green-dark: #22c55e;
    --billing-green-soft: rgba(34, 197, 94, .14);

    --billing-amber: #fbbf24;
    --billing-amber-dark: #f59e0b;
    --billing-amber-soft: rgba(245, 158, 11, .16);

    --billing-orange: #fb923c;
    --billing-orange-soft: rgba(249, 115, 22, .15);

    --billing-red: #f87171;
    --billing-red-dark: #ef4444;
    --billing-red-soft: rgba(239, 68, 68, .14);

    --billing-purple: #a78bfa;
    --billing-purple-soft: rgba(124, 58, 237, .16);

    --billing-cyan: #67e8f9;
    --billing-cyan-soft: rgba(8, 145, 178, .16);

    --billing-ink: #f8fafc;
    --billing-ink-soft: #dbe4f0;
    --billing-muted: #9aabc1;
    --billing-muted-soft: #64748b;

    --billing-line: #2b3d56;
    --billing-line-soft: rgba(255, 255, 255, .06);

    --billing-surface: #182235;
    --billing-surface-soft: #101827;
    --billing-surface-glass: rgba(24, 34, 53, .88);

    --billing-shadow-xs: none;
    --billing-shadow-soft: 0 12px 26px rgba(0, 0, 0, .28);
    --billing-shadow-md: 0 18px 34px rgba(0, 0, 0, .34);
    --billing-shadow-lg: 0 24px 52px rgba(0, 0, 0, .42);
    --billing-shadow-blue: 0 14px 28px rgba(59, 130, 246, .18);

    color: var(--billing-ink);
}

/* Header */
html[data-theme="dark"] #billingPage .billing-hero {
    background:
            radial-gradient(circle at 5% 10%, rgba(59, 130, 246, .20), transparent 30%),
            radial-gradient(circle at 92% 18%, rgba(56, 189, 248, .13), transparent 28%),
            radial-gradient(circle at 75% 100%, rgba(167, 139, 250, .10), transparent 32%),
            linear-gradient(135deg, #182235 0%, #141f31 48%, #101827 100%) !important;
    border-color: var(--billing-line) !important;
    box-shadow: var(--billing-shadow-soft) !important;
}

html[data-theme="dark"] #billingPage .billing-hero::before {
    background-image:
            linear-gradient(rgba(96, 165, 250, .06) 1px, transparent 1px),
            linear-gradient(90deg, rgba(96, 165, 250, .06) 1px, transparent 1px);
}

html[data-theme="dark"] #billingPage .nx-page-title,
html[data-theme="dark"] #billingPage .billing-card-header h6,
html[data-theme="dark"] #billingPage .billing-action-title,
html[data-theme="dark"] #billingPage .billing-main-text,
html[data-theme="dark"] #billingPage .billing-money,
html[data-theme="dark"] #billingPage .billing-detail-value,
html[data-theme="dark"] .billing-modal .modal-title,
html[data-theme="dark"] .nx-section-title {
    color: var(--billing-ink) !important;
}

html[data-theme="dark"] #billingPage .nx-page-subtitle,
html[data-theme="dark"] #billingPage .billing-ph-note,
html[data-theme="dark"] #billingPage .billing-sub-text,
html[data-theme="dark"] #billingPage .billing-action-text,
html[data-theme="dark"] #billingPage .billing-stat-help,
html[data-theme="dark"] #billingPage .billing-detail-label,
html[data-theme="dark"] #billingPage .text-muted {
    color: var(--billing-muted) !important;
}

html[data-theme="dark"] #billingPage .billing-eyebrow {
    color: #93c5fd !important;
    background: rgba(59, 130, 246, .16) !important;
    border-color: rgba(96, 165, 250, .20) !important;
}

/* Cards / panels */
html[data-theme="dark"] #billingPage .nx-summary-card,
html[data-theme="dark"] #billingPage .billing-stat-card,
html[data-theme="dark"] #billingPage .billing-tabs-card,
html[data-theme="dark"] #billingPage .billing-card,
html[data-theme="dark"] #billingPage .billing-action-tile,
html[data-theme="dark"] #billingPage .billing-health-item,
html[data-theme="dark"] #billingPage .billing-payment-item,
html[data-theme="dark"] #billingPage .billing-aging-card,
html[data-theme="dark"] #billingPage .billing-detail-box,
html[data-theme="dark"] #billingPage .billing-mini-stat,
html[data-theme="dark"] #billingPage .billing-toggle-card,
html[data-theme="dark"] .billing-custom-item-box,
html[data-theme="dark"] .nx-section-card {
    background:
            radial-gradient(circle at 96% 8%, rgba(59, 130, 246, .08), transparent 28%),
            linear-gradient(180deg, #182235 0%, #141f31 100%) !important;
    border-color: var(--billing-line-soft) !important;
    color: var(--billing-ink) !important;
    box-shadow: var(--billing-shadow-soft) !important;
}

html[data-theme="dark"] #billingPage .nx-summary-card:hover,
html[data-theme="dark"] #billingPage .billing-stat-card:hover,
html[data-theme="dark"] #billingPage .billing-action-tile:hover,
html[data-theme="dark"] #billingPage .billing-health-item:hover,
html[data-theme="dark"] #billingPage .billing-payment-item:hover,
html[data-theme="dark"] #billingPage .billing-aging-card:hover,
html[data-theme="dark"] #billingPage .billing-aging-card.active {
    background:
            radial-gradient(circle at 96% 8%, rgba(96, 165, 250, .12), transparent 28%),
            linear-gradient(180deg, #202d44 0%, #182235 100%) !important;
    border-color: rgba(96, 165, 250, .35) !important;
    box-shadow: var(--billing-shadow-md) !important;
}

/* Card headers */
html[data-theme="dark"] #billingPage .billing-card-header,
html[data-theme="dark"] .billing-modal .modal-header {
    background:
            radial-gradient(circle at top right, rgba(59, 130, 246, .10), transparent 30%),
            linear-gradient(180deg, #182235 0%, #141f31 100%) !important;
    border-color: var(--billing-line-soft) !important;
}

/* Stats */
html[data-theme="dark"] #billingPage .nx-summary-label,
html[data-theme="dark"] #billingPage .billing-stat-label,
html[data-theme="dark"] #billingPage .billing-aging-label {
    color: var(--billing-muted) !important;
}

html[data-theme="dark"] #billingPage .nx-summary-value,
html[data-theme="dark"] #billingPage .billing-stat-value,
html[data-theme="dark"] #billingPage .billing-aging-value,
html[data-theme="dark"] #billingPage .billing-aging-amount {
    color: #ffffff !important;
}

/* Icons */
html[data-theme="dark"] #billingPage .nx-summary-icon,
html[data-theme="dark"] #billingPage .billing-stat-icon,
html[data-theme="dark"] #billingPage .billing-action-icon,
html[data-theme="dark"] #billingPage .billing-health-icon,
html[data-theme="dark"] #billingPage .billing-aging-icon,
html[data-theme="dark"] #billingPage .billing-payment-icon {
    border: 1px solid rgba(255, 255, 255, .06) !important;
    backdrop-filter: blur(6px);
}

html[data-theme="dark"] #billingPage .nx-summary-primary .nx-summary-icon,
html[data-theme="dark"] #billingPage .billing-stat-primary .billing-stat-icon,
html[data-theme="dark"] #billingPage .billing-action-icon {
    background: rgba(59, 130, 246, .12) !important;
    color: #60a5fa !important;
}

html[data-theme="dark"] #billingPage .nx-summary-success .nx-summary-icon,
html[data-theme="dark"] #billingPage .billing-stat-success .billing-stat-icon,
html[data-theme="dark"] #billingPage .billing-aging-current .billing-aging-icon,
html[data-theme="dark"] #billingPage .billing-payment-icon {
    background: rgba(34, 197, 94, .12) !important;
    color: #4ade80 !important;
}

html[data-theme="dark"] #billingPage .nx-summary-warning .nx-summary-icon,
html[data-theme="dark"] #billingPage .billing-stat-warning .billing-stat-icon,
html[data-theme="dark"] #billingPage .billing-aging-warning .billing-aging-icon {
    background: rgba(245, 158, 11, .14) !important;
    color: #fbbf24 !important;
}

html[data-theme="dark"] #billingPage .billing-aging-orange .billing-aging-icon {
    background: rgba(249, 115, 22, .14) !important;
    color: #fb923c !important;
}

html[data-theme="dark"] #billingPage .nx-summary-danger .nx-summary-icon,
html[data-theme="dark"] #billingPage .billing-stat-danger .billing-stat-icon,
html[data-theme="dark"] #billingPage .billing-aging-danger .billing-aging-icon,
html[data-theme="dark"] #billingPage .billing-aging-critical .billing-aging-icon {
    background: rgba(239, 68, 68, .12) !important;
    color: #f87171 !important;
}

/* Tabs / search */
html[data-theme="dark"] #billingPage .billing-tabs {
    background: #101827 !important;
    border-color: var(--billing-line) !important;
}

html[data-theme="dark"] #billingPage .billing-tabs .nx-segment-item {
    color: var(--billing-muted) !important;
}

html[data-theme="dark"] #billingPage .billing-tabs .nx-segment-item:hover {
    color: #bfdbfe !important;
    background: rgba(59, 130, 246, .12) !important;
}

html[data-theme="dark"] #billingPage .billing-tabs .nx-segment-item.active {
    color: #ffffff !important;
    background: linear-gradient(135deg, #3b82f6, #2563eb) !important;
    box-shadow: var(--billing-shadow-blue) !important;
}

html[data-theme="dark"] #billingPage .billing-search-control,
html[data-theme="dark"] #billingPage .form-control,
html[data-theme="dark"] #billingPage .form-select,
html[data-theme="dark"] .billing-modal .form-control,
html[data-theme="dark"] .billing-modal .form-select {
    background: #101827 !important;
    border-color: var(--billing-line) !important;
    color: var(--billing-ink) !important;
}

html[data-theme="dark"] #billingPage .billing-search-control::placeholder,
html[data-theme="dark"] #billingPage .form-control::placeholder {
    color: #64748b !important;
}

html[data-theme="dark"] #billingPage .billing-search-control:focus,
html[data-theme="dark"] #billingPage .form-control:focus,
html[data-theme="dark"] #billingPage .form-select:focus {
    border-color: #60a5fa !important;
    box-shadow: 0 0 0 4px rgba(96, 165, 250, .18) !important;
}

/* Notes */
html[data-theme="dark"] #billingPage .billing-workspace-note,
html[data-theme="dark"] #billingPage .billing-collections-note,
html[data-theme="dark"] #billingPage .billing-pill {
    background: #101827 !important;
    border-color: var(--billing-line) !important;
    color: var(--billing-muted) !important;
}

/* Tables */
html[data-theme="dark"] #billingPage .nx-table-wrap,
html[data-theme="dark"] #billingPage .billing-table,
html[data-theme="dark"] #billingPage table {
    background: #141f31 !important;
    color: var(--billing-ink) !important;
}

html[data-theme="dark"] #billingPage .billing-table thead th {
    background: #101827 !important;
    color: var(--billing-muted) !important;
    border-color: var(--billing-line) !important;
}

html[data-theme="dark"] #billingPage .billing-table tbody td {
    color: var(--billing-ink-soft) !important;
    border-color: var(--billing-line-soft) !important;
}

html[data-theme="dark"] #billingPage .billing-table tbody tr:hover {
    background: rgba(96, 165, 250, .07) !important;
}

/* Badges */
html[data-theme="dark"] #billingPage .billing-badge.status-paid,
html[data-theme="dark"] #billingPage .billing-badge.status-posted,
html[data-theme="dark"] #billingPage .billing-badge.status-success,
html[data-theme="dark"] #billingPage .billing-badge.status-created,
html[data-theme="dark"] #billingPage .billing-badge.status-credit,
html[data-theme="dark"] #billingPage .billing-badge.status-discount,
html[data-theme="dark"] #billingPage .billing-badge.status-rebate,
html[data-theme="dark"] #billingPage .billing-badge.status-waiver,
html[data-theme="dark"] #billingPage .billing-badge.status-aging-current {
    color: #4ade80 !important;
    background: rgba(34, 197, 94, .14) !important;
    border-color: rgba(74, 222, 128, .18) !important;
}

html[data-theme="dark"] #billingPage .billing-badge.status-unpaid,
html[data-theme="dark"] #billingPage .billing-badge.status-pending,
html[data-theme="dark"] #billingPage .billing-badge.status-current {
    color: #93c5fd !important;
    background: rgba(59, 130, 246, .14) !important;
    border-color: rgba(147, 197, 253, .18) !important;
}

html[data-theme="dark"] #billingPage .billing-badge.status-partial,
html[data-theme="dark"] #billingPage .billing-badge.status-skipped,
html[data-theme="dark"] #billingPage .billing-badge.status-debit,
html[data-theme="dark"] #billingPage .billing-badge.status-correction,
html[data-theme="dark"] #billingPage .billing-badge.status-aging-overdue_1_7 {
    color: #fbbf24 !important;
    background: rgba(245, 158, 11, .15) !important;
    border-color: rgba(251, 191, 36, .18) !important;
}

html[data-theme="dark"] #billingPage .billing-badge.status-aging-overdue_8_30 {
    color: #fb923c !important;
    background: rgba(249, 115, 22, .15) !important;
    border-color: rgba(251, 146, 60, .18) !important;
}

html[data-theme="dark"] #billingPage .billing-badge.status-overdue,
html[data-theme="dark"] #billingPage .billing-badge.status-failed,
html[data-theme="dark"] #billingPage .billing-badge.status-aging-overdue_31_60,
html[data-theme="dark"] #billingPage .billing-badge.status-aging-overdue_60_plus {
    color: #f87171 !important;
    background: rgba(239, 68, 68, .14) !important;
    border-color: rgba(248, 113, 113, .18) !important;
}

html[data-theme="dark"] #billingPage .billing-badge.status-cancelled,
html[data-theme="dark"] #billingPage .billing-badge.status-voided,
html[data-theme="dark"] #billingPage .billing-badge.status-refunded {
    color: #cbd5e1 !important;
    background: rgba(148, 163, 184, .13) !important;
    border-color: rgba(203, 213, 225, .14) !important;
}

/* Modals */
html[data-theme="dark"] .billing-modal {
    background: #182235 !important;
    color: var(--billing-ink) !important;
    border: 1px solid var(--billing-line) !important;
}

html[data-theme="dark"] .billing-modal .modal-body {
    background: #0b1220 !important;
}

html[data-theme="dark"] .billing-modal .modal-footer {
    background: #141f31 !important;
    border-color: var(--billing-line) !important;
}

html[data-theme="dark"] #billingPage .billing-settings-form .form-label,
html[data-theme="dark"] .billing-modal .form-label {
    color: var(--billing-muted) !important;
}

/* Empty states */
html[data-theme="dark"] #billingPage td.text-center.text-muted.py-4,
html[data-theme="dark"] #billingPage .billing-empty-state,
html[data-theme="dark"] #billingPage .billing-empty-mini {
    color: var(--billing-muted) !important;
}

html[data-theme="dark"] #billingPage td.text-center.text-muted.py-4::before {
    background:
            linear-gradient(135deg, rgba(59, 130, 246, .16), rgba(56, 189, 248, .10)) !important;
}

/* Dividers */
html[data-theme="dark"] #billingPage .billing-soft-divider {
    background: var(--billing-line-soft) !important;
}
/* =========================================================
   BILLING DARK MODE TABLE FIX
   Place at VERY BOTTOM of Billing.css
========================================================= */

html[data-theme="dark"] #billingPage .table-responsive,
html[data-theme="dark"] #billingPage .nx-table-wrap,
html[data-theme="dark"] #billingPage .billing-table,
html[data-theme="dark"] #billingPage .billing-table tbody,
html[data-theme="dark"] #billingPage .billing-table tr,
html[data-theme="dark"] #billingPage .billing-table td {
    background-color: #141f31 !important;
}

html[data-theme="dark"] #billingPage .billing-table thead,
html[data-theme="dark"] #billingPage .billing-table thead tr,
html[data-theme="dark"] #billingPage .billing-table thead th {
    background-color: #101827 !important;
    color: #9aabc1 !important;
    border-color: #2b3d56 !important;
}

html[data-theme="dark"] #billingPage .billing-table tbody td {
    color: #dbe4f0 !important;
    border-color: rgba(255, 255, 255, .06) !important;
}

html[data-theme="dark"] #billingPage .billing-table tbody tr:hover,
html[data-theme="dark"] #billingPage .billing-table tbody tr:hover td {
    background-color: #182235 !important;
}

html[data-theme="dark"] #billingPage .billing-table .billing-main-text,
html[data-theme="dark"] #billingPage .billing-table .billing-money {
    color: #f8fafc !important;
}

html[data-theme="dark"] #billingPage .billing-table .billing-sub-text {
    color: #9aabc1 !important;
}

/* Bootstrap striped/hover/table variants override */
html[data-theme="dark"] #billingPage .table > :not(caption) > * > * {
    background-color: transparent !important;
    color: inherit !important;
    box-shadow: none !important;
}

html[data-theme="dark"] #billingPage .table-striped > tbody > tr:nth-of-type(odd) > * {
    background-color: rgba(255, 255, 255, .018) !important;
    color: #dbe4f0 !important;
}

html[data-theme="dark"] #billingPage .table-hover > tbody > tr:hover > * {
    background-color: rgba(96, 165, 250, .08) !important;
    color: #f8fafc !important;
}

/* =========================================================
   1WAN OPERATIONS CONSOLE
========================================================= */

#billingPage {
    --billing-blue: #2563EB;
    --billing-green: #16845B;
    --billing-amber: #C47A00;
    --billing-red: #C5343A;
    --billing-ink: #101828;
    --billing-muted: #667085;
    --billing-muted-soft: #98A2B3;
    --billing-line: #D9DEE7;
    --billing-line-soft: #E9EDF2;
    --billing-radius-xl: 4px;
    --billing-radius-lg: 4px;
    --billing-radius-md: 3px;
    --billing-radius-sm: 2px;
    --billing-shadow-xs: none;
    --billing-shadow-soft: none;
    --billing-shadow-md: none;
    --billing-shadow-lg: none;
    --billing-shadow-blue: none;
    padding-bottom: 32px;
}

#billingPage .card,
#billingPage .btn,
#billingPage .btn-sm,
#billingPage .form-control,
#billingPage .form-select {
    border-radius: 3px;
    box-shadow: none;
}

#billingPage .btn {
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0;
}

#billingPage .btn:hover { transform: none; }

#billingPage .billing-hero {
    min-height: 104px;
    margin-bottom: 26px !important;
    overflow: visible;
    background: transparent;
    border: 0;
    border-radius: 0;
    box-shadow: none;
}

#billingPage .billing-hero::before,
#billingPage .billing-hero::after { display: none; }

#billingPage .nx-page-header {
    min-height: 104px;
    padding: 0;
    align-items: flex-start;
}

#billingPage .billing-eyebrow {
    margin: 0 0 5px;
    padding: 0;
    color: var(--billing-blue);
    background: transparent;
    border: 0;
    border-radius: 0;
    font-size: 10px;
    font-weight: 600;
    letter-spacing: .08em;
}

#billingPage .nx-page-title {
    font-size: 28px;
    font-weight: 600;
    letter-spacing: -.03em;
}

#billingPage .nx-page-subtitle {
    margin-top: 3px;
    font-size: 12px;
}

#billingPage .billing-ph-note {
    margin-top: 7px;
    color: var(--billing-muted);
    font-size: 9px;
    font-weight: 500;
}

#billingPage .billing-hero-actions {
    max-width: 620px;
    padding-top: 16px;
    gap: 7px;
}

#billingPage .nx-header-btn {
    min-height: 36px;
    padding-inline: 11px;
    box-shadow: none;
}

#billingPage .billing-stats-grid {
    margin: 0 0 28px !important;
    background: #fff;
    border-block: 1px solid var(--billing-line);
}

#billingPage .billing-stats-grid > div { padding: 0; }

#billingPage .billing-stat-card {
    min-height: 104px;
    padding: 16px 20px;
    background: #fff;
    border: 0;
    border-radius: 0;
    box-shadow: none;
}

#billingPage .billing-stats-grid > div + div .billing-stat-card {
    border-left: 1px solid var(--billing-line-soft);
}

#billingPage .billing-stat-card:hover {
    transform: none;
    border-color: transparent;
    box-shadow: none;
}

#billingPage .billing-stat-icon { display: none; }

#billingPage .billing-stat-label {
    margin-bottom: 7px;
    color: var(--billing-muted);
    font-size: 9px;
    font-weight: 600;
    letter-spacing: .07em;
    text-transform: uppercase;
}

#billingPage .billing-stat-value {
    color: var(--billing-ink);
    font-size: 27px;
    line-height: 1.1;
    font-weight: 600;
    letter-spacing: -.035em;
}

#billingPage .billing-stat-help {
    margin-top: 3px;
    color: var(--billing-muted);
    font-size: 10px;
}

#billingPage .billing-tabs-card {
    margin-bottom: 26px !important;
    background: transparent;
    border: 0;
    border-radius: 0;
    box-shadow: none;
}

#billingPage .billing-tabs-card .card-body { padding: 0; }

#billingPage .billing-tabs {
    gap: 26px;
    padding: 0;
    background: transparent;
    border: 0;
    border-bottom: 1px solid var(--billing-line);
    border-radius: 0;
}

#billingPage .billing-tabs .nx-segment-item {
    min-width: auto;
    min-height: 38px;
    padding: 0 0 10px;
    color: var(--billing-muted);
    background: transparent;
    border: 0;
    border-bottom: 2px solid transparent;
    border-radius: 0;
    font-size: 10px;
    font-weight: 500;
}

#billingPage .billing-tabs .nx-segment-item i { display: none; }

#billingPage .billing-tabs .nx-segment-item:hover {
    color: var(--billing-ink);
    background: transparent;
}

#billingPage .billing-tabs .nx-segment-item.active {
    color: var(--billing-blue);
    background: transparent;
    border-bottom-color: var(--billing-blue);
    box-shadow: none;
}

#billingPage .billing-search-control {
    min-height: 36px;
    border-radius: 3px !important;
    font-size: 10px;
}

#billingPage .billing-card,
#billingPage .billing-overview-card {
    background: #fff;
    border: 1px solid var(--billing-line);
    border-radius: 0;
    box-shadow: none;
}

#billingPage .billing-card-header {
    min-height: 58px;
    padding: 13px 16px;
    border-bottom: 1px solid var(--billing-line);
}

#billingPage .billing-card-header h6 {
    font-size: 13px;
    font-weight: 600 !important;
}

#billingPage .billing-card-header small { font-size: 9px; }

#billingPage .billing-action-tile,
#billingPage .billing-workspace-note,
#billingPage .billing-collection-card,
#billingPage .billing-run-card {
    border-radius: 3px;
    box-shadow: none;
}

#billingPage .billing-action-tile:hover,
#billingPage .billing-collection-card:hover,
#billingPage .billing-run-card:hover {
    transform: none;
    box-shadow: none;
}

#billingPage .billing-action-icon { border-radius: 2px; }

#billingPage .billing-table { font-size: 10px; }

#billingPage .billing-table thead th {
    color: var(--billing-muted);
    background: #F9FAFB;
    border-bottom: 1px solid var(--billing-line);
    font-size: 9px;
    font-weight: 600;
    letter-spacing: .05em;
    text-transform: uppercase;
}

#billingPage .billing-table tbody td {
    border-bottom-color: var(--billing-line-soft);
    font-variant-numeric: tabular-nums;
}

#billingPage .billing-modal .modal-content {
    border-radius: 3px;
    box-shadow: 0 12px 32px rgba(16, 24, 40, .16);
}

@media (max-width: 767.98px) {
    #billingPage .nx-page-header { display: block; }
    #billingPage .nx-page-title { font-size: 24px; }
    #billingPage .billing-stats-grid > div:nth-child(3) .billing-stat-card { border-left: 0; }
    #billingPage .billing-stats-grid > div:nth-child(n+3) .billing-stat-card { border-top: 1px solid var(--billing-line-soft); }
    #billingPage .billing-tabs { gap: 18px; }
}

/* =========================================================
   BORDER AUDIT
   Keep the page-level panels as the hierarchy anchors. Nested
   lists, notes, and modal detail boxes use separators/spacing
   instead of repeated outlines.
========================================================= */
#billingPage .billing-workspace-note,
#billingPage .billing-health-item,
#billingPage .billing-payment-item,
#billingPage .billing-detail-box,
#billingPage .billing-mini-stat,
#billingPage .nx-section-card {
    border: 0 !important;
    box-shadow: none !important;
}

#billingPage .billing-workspace-note {
    background: var(--billing-surface-soft, #f8fafc);
}

#billingPage .billing-health-item,
#billingPage .billing-payment-item {
    border-radius: 0 !important;
}

#billingPage .billing-health-item + .billing-health-item,
#billingPage .billing-payment-item + .billing-payment-item {
    border-top: 1px solid var(--billing-line-soft) !important;
}

#billingPage .billing-detail-box,
#billingPage .billing-mini-stat,
#billingPage .nx-section-card {
    background: var(--billing-surface, #fff);
}

html[data-theme="dark"] #billingPage .billing-workspace-note,
html[data-theme="dark"] #billingPage .billing-health-item,
html[data-theme="dark"] #billingPage .billing-payment-item,
html[data-theme="dark"] #billingPage .billing-detail-box,
html[data-theme="dark"] #billingPage .billing-mini-stat,
html[data-theme="dark"] #billingPage .nx-section-card {
    background: var(--billing-surface, #182235) !important;
    border-color: transparent !important;
}

html[data-theme="dark"] #billingPage .billing-health-item + .billing-health-item,
html[data-theme="dark"] #billingPage .billing-payment-item + .billing-payment-item {
    border-top-color: var(--billing-line-soft) !important;
}

/* The shared rectilinear guardrails run after module CSS and add a card
   outline back to these flat billing sections. Keep hierarchy through
   spacing and header separators instead of a second outer frame. */
body#nxApplication #nxRectilinearTheme #billingPage .billing-hero,
body#nxApplication #nxRectilinearTheme #billingPage .billing-tabs-card,
body#nxApplication #nxRectilinearTheme #billingPage .billing-card,
body#nxApplication #nxRectilinearTheme #billingPage .billing-overview-card {
    border: 0 !important;
    box-shadow: none !important;
}

#billingPage .billing-stats-grid {
    border-block: 0 !important;
}

html[data-theme="dark"] #billingPage .billing-hero,
html[data-theme="dark"] #billingPage .billing-tabs-card,
html[data-theme="dark"] #billingPage .billing-card,
html[data-theme="dark"] #billingPage .billing-overview-card,
html[data-theme="dark"] #billingPage .billing-stats-grid {
    border-color: transparent !important;
}

/* Overview feeds use their header and row separators as structure; the
   surrounding card outline is redundant and visually boxes the feeds in. */
body#nxApplication #nxRectilinearTheme #billingPage .billing-recent-card {
    border: 0 !important;
    box-shadow: none !important;
}

html[data-theme="dark"] #billingPage .billing-recent-card {
    border: 0 !important;
}

/* Keep the overview navigation present in the shared page layout. */
body#nxApplication #nxRectilinearTheme #billingPage .billing-tabs-card {
    display: block !important;
    visibility: visible !important;
}

#billingPage .billing-tabs {
    border: 1px solid var(--billing-line) !important;
    background: #f8fafc !important;
}

html[data-theme="dark"] #billingPage .billing-tabs {
    background: var(--billing-surface-soft) !important;
    border-color: var(--billing-line) !important;
}

/* Keep the page section open; each meaningful panel owns its own frame. */
body#nxApplication #nxRectilinearTheme #billingPage .billing-panel {
    border: 0 !important;
    border-radius: 0 !important;
    background: transparent !important;
    box-shadow: none !important;
}

body#nxApplication #nxRectilinearTheme #billingPage .billing-overview-card,
body#nxApplication #nxRectilinearTheme #billingPage .billing-recent-card {
    border: 1px solid var(--billing-line) !important;
    border-radius: 3px !important;
    box-shadow: none !important;
}

html[data-theme="dark"] #billingPage .billing-panel {
    border: 0 !important;
    background: transparent !important;
}

/* =========================================================
   AI-SLOP AUDIT
   Visual-only cleanup; border hierarchy above remains unchanged.
========================================================= */
#billingPage {
    font-family: var(--nx-font-body, "Source Sans 3", sans-serif);
    color: #172033;
}

#billingPage h1,
#billingPage h2,
#billingPage h3,
#billingPage h4,
#billingPage h5,
#billingPage h6,
#billingPage .billing-card-header h6,
#billingPage .billing-action-title,
#billingPage .billing-main-text {
    font-family: var(--nx-font-heading, "Manrope", sans-serif);
}

#billingPage .billing-card-header h6 { font-size: 14px; line-height: 1.25; }
#billingPage .billing-card-header small,
#billingPage .billing-action-text,
#billingPage .billing-sub-text { font-size: 11px; line-height: 1.35; }
#billingPage .billing-table { font-size: 12px; }
#billingPage .billing-table thead th { font-size: 10px; letter-spacing: .06em; }
#billingPage .billing-table tbody td { line-height: 1.35; }
#billingPage .btn { font-size: 13px; font-weight: 600; }
#billingPage .btn-sm { font-size: 12px; }
#billingPage .billing-search-control { font-size: 13px; }

/* Replace decorative gradients and floating-card effects with flat surfaces. */
#billingPage .billing-hero,
#billingPage .billing-stat-card,
#billingPage .billing-tabs-card,
#billingPage .billing-tabs,
#billingPage .billing-card,
#billingPage .billing-action-tile,
#billingPage .billing-payment-item,
#billingPage .billing-aging-card,
#billingPage .billing-modal .modal-content,
#billingPage .billing-modal .modal-header {
    background-image: none !important;
}

#billingPage .billing-hero,
#billingPage .billing-stat-card,
#billingPage .billing-card,
#billingPage .billing-action-tile,
#billingPage .billing-payment-item,
#billingPage .billing-aging-card {
    box-shadow: none !important;
}

#billingPage .billing-tabs .nx-segment-item.active {
    background: #2f5f8f !important;
    box-shadow: none !important;
}

#billingPage .billing-action-tile:hover,
#billingPage .billing-payment-item:hover,
#billingPage .billing-aging-card:hover {
    transform: none !important;
    box-shadow: none !important;
}

html[data-theme="dark"] #billingPage {
    color: #e7edf5;
}

html[data-theme="dark"] #billingPage .billing-tabs .nx-segment-item.active {
    background: #3f6f9d !important;
}

html[data-theme="dark"] #billingPage .billing-card-header small,
html[data-theme="dark"] #billingPage .billing-action-text,
html[data-theme="dark"] #billingPage .billing-sub-text {
    color: #9aabc1 !important;
}

/* Keep the hero actions as one intentional action row on desktop. */
#billingPage .billing-hero-actions {
    max-width: none !important;
    flex-wrap: nowrap !important;
    gap: 6px !important;
    white-space: nowrap;
}

#billingPage .billing-hero-actions .nx-header-btn {
    flex: 0 0 auto;
    min-height: 36px;
    padding-inline: 10px;
    font-size: 12px !important;
    white-space: nowrap;
}

@media (max-width: 1100px) {
    #billingPage .billing-hero-actions {
        flex-wrap: wrap !important;
        justify-content: flex-start;
    }
}

/* Give summary cards a clear, even gutter instead of making them touch. */
#billingPage .billing-stats-grid {
    display: flex;
    gap: 12px;
    margin-inline: 0 !important;
}

#billingPage .billing-stats-grid > div {
    flex: 1 1 0;
    width: auto;
    padding-inline: 0 !important;
}

@media (max-width: 767.98px) {
    #billingPage .billing-stats-grid { gap: 10px; }
    #billingPage .billing-stats-grid > div { flex-basis: calc(50% - 5px); }
}

/* Billing-specific exceptions only. The shared visual system is owned by nx.css. */
#billingPage .billing-hero::before,
#billingPage .billing-hero::after {
    display: none !important;
}

#billingPage .billing-hero,
#billingPage .billing-card,
#billingPage .billing-stat-card,
#billingPage .billing-tabs-card,
#billingPage .billing-action-tile,
#billingPage .billing-health-item,
#billingPage .billing-payment-item,
#billingPage .billing-aging-card,
#billingPage .billing-detail-box,
#billingPage .billing-mini-stat,
#billingPage .billing-toggle-card,
#billingPage .billing-workspace,
#billingPage .billing-recent-card,
#billingPage .billing-panel,
#billingPage .billing-collection-card,
#billingPage .billing-run-card {
    background: var(--nx-panel-surface-light) !important;
    border-color: var(--nx-panel-border-light) !important;
    box-shadow: none !important;
    background-image: none !important;
}

html[data-theme="dark"] #billingPage .billing-hero,
html[data-theme="dark"] #billingPage .billing-card,
html[data-theme="dark"] #billingPage .billing-stat-card,
html[data-theme="dark"] #billingPage .billing-tabs-card,
html[data-theme="dark"] #billingPage .billing-action-tile,
html[data-theme="dark"] #billingPage .billing-health-item,
html[data-theme="dark"] #billingPage .billing-payment-item,
html[data-theme="dark"] #billingPage .billing-aging-card,
html[data-theme="dark"] #billingPage .billing-detail-box,
html[data-theme="dark"] #billingPage .billing-mini-stat,
html[data-theme="dark"] #billingPage .billing-toggle-card,
html[data-theme="dark"] #billingPage .billing-workspace,
html[data-theme="dark"] #billingPage .billing-recent-card,
html[data-theme="dark"] #billingPage .billing-panel,
html[data-theme="dark"] #billingPage .billing-collection-card,
html[data-theme="dark"] #billingPage .billing-run-card {
    background: var(--nx-panel-surface-dark) !important;
    border-color: var(--nx-panel-border-dark) !important;
    box-shadow: none !important;
    background-image: none !important;
}
