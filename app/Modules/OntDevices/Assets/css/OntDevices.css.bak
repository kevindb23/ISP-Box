#ontDevicesPage {
    --ont-blue: #2563eb;
    --ont-blue-dark: #1d4ed8;
    --ont-ink: #0f172a;
    --ont-muted: #64748b;
    --ont-line: #e2e8f0;
    --ont-surface: #ffffff;
    --ont-surface-soft: #f8fafc;
    --ont-shadow-soft: 0 12px 28px rgba(15, 23, 42, 0.05);
    --ont-shadow-lg: 0 20px 40px rgba(15, 23, 42, 0.08);
}

/* =========================================================
   MAIN PAGE SURFACES
========================================================= */
#ontDevicesPage .nx-surface-card,
#ontDevicesPage .nx-toolbar-card,
#ontDevicesPage .nx-content-card,
#ontDevicesPage .nx-page-header-card {
    border-radius:3px;
    overflow: hidden;
    border: 1px solid rgba(226, 232, 240, 0.9);
    background: linear-gradient(180deg, #ffffff 0%, #fbfdff 100%);
    box-shadow: var(--ont-shadow-soft);
}

/* =========================================================
   HERO / HEADER
========================================================= */
#ontDevicesPage .nx-page-header-card {
    border: 1px solid rgba(37, 99, 235, 0.08);
    background:
            radial-gradient(circle at top right, rgba(37, 99, 235, 0.10), transparent 28%),
            linear-gradient(180deg, rgba(255,255,255,1) 0%, rgba(248,250,252,0.94) 100%);
    box-shadow: var(--ont-shadow-lg);
}

#ontDevicesPage .nx-page-header {
    min-height: 124px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    padding: 24px 28px;
}

#ontDevicesPage .nx-page-header-left {
    max-width: 820px;
}

#ontDevicesPage .ont-hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 7px 12px;
    border-radius:3px;
    background: rgba(37, 99, 235, 0.08);
    color: var(--ont-blue-dark);
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    margin-bottom: 14px;
}

#ontDevicesPage .ont-hero-badge i {
    font-size: 11px;
    line-height: 1;
}

#ontDevicesPage .nx-page-title {
    margin: 0 0 6px;
    font-size: 18px;
    font-weight: 800;
    color: var(--ont-ink);
    line-height: 1.2;
}

#ontDevicesPage .nx-page-subtitle {
    margin: 0;
    font-size: 14px;
    color: var(--ont-muted);
    line-height: 1.55;
}

#ontDevicesPage .nx-page-actions {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-wrap: wrap;
}

#ontDevicesPage .nx-header-btn {
    height: 40px;
    min-height: 40px;
    padding: 0 16px;
    border-radius:3px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    font-size: 14px;
    font-weight: 700;
    line-height: 1;
    vertical-align: middle;
    box-shadow: none;
}

#ontDevicesPage .btn-primary.nx-header-btn {
    background: linear-gradient(135deg, #3b82f6 0%, #2563eb 100%);
    border-color: #2563eb;
}

#ontDevicesPage .btn-primary.nx-header-btn:hover,
#ontDevicesPage .btn-primary.nx-header-btn:focus {
    background: linear-gradient(135deg, #2563eb 0%, #1d4ed8 100%);
    border-color: #1d4ed8;
}

#ontDevicesPage .btn-light.nx-header-btn {
    background: #fff;
    border-color: #dbe3ef;
    color: #0f172a;
}

#ontDevicesPage .btn-light.nx-header-btn:hover,
#ontDevicesPage .btn-light.nx-header-btn:focus {
    background: #f8fafc;
    border-color: #cbd5e1;
    color: #0f172a;
}

/* =========================================================
   SEGMENT / TOP CONTROL
========================================================= */
#ontDevicesPage .nx-segment-control {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 6px;
    border-radius:3px;
    background: #eef3f8;
    border: 1px solid #dbe5ef;
    box-shadow: inset 0 1px 0 rgba(255,255,255,0.9);
}

#ontDevicesPage .nx-segment-item {
    min-width: 110px;
    height: 40px;
    padding: 0 18px;
    border-radius:3px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    font-size: 14px;
    font-weight: 700;
    color: #2563eb;
    text-decoration: none;
    transition: all .18s ease;
}

#ontDevicesPage .nx-segment-item:hover {
    color: #1d4ed8;
    background: rgba(255,255,255,0.6);
}

#ontDevicesPage .nx-segment-item.active {
    color: #fff;
    background: linear-gradient(135deg, #3b82f6 0%, #2563eb 100%);
    box-shadow: 0 10px 20px rgba(37, 99, 235, 0.22);
}

/* =========================================================
   TOOLBAR
========================================================= */
#ontDevicesPage .nx-toolbar-card {
    border: 1px solid rgba(226, 232, 240, 0.9);
    background: linear-gradient(180deg, #ffffff 0%, #fbfdff 100%);
    box-shadow: var(--ont-shadow-soft);
}

#ontDevicesPage .nx-toolbar-card .card-body {
    padding: 14px 18px 16px;
    overflow: hidden;
}

#ontDevicesPage #ontToolbarArea {
    padding: 0;
    margin-top: 10px;
}

#ontDevicesPage .ont-toolbar-grid {
    display: grid;
    grid-template-columns: minmax(280px, 420px) minmax(0, 1fr);
    gap: 14px;
    align-items: center;
    width: 100%;
}

#ontDevicesPage .ont-toolbar-search {
    display: flex;
    align-items: center;
    min-width: 0;
}

#ontDevicesPage .ont-search-wrap {
    position: relative;
    width: 100%;
    min-width: 0;
}

#ontDevicesPage .ont-search-icon {
    position: absolute;
    top: 50%;
    left: 14px;
    transform: translateY(-50%);
    font-size: 14px;
    color: #94a3b8;
    pointer-events: none;
}

#ontDevicesPage .ont-toolbar-control {
    height: 42px;
    min-height: 42px;
    border-radius:3px;
    border-color: #dbe3ef;
    font-size: 14px;
    box-shadow: none;
}

#ontDevicesPage .ont-search-control {
    padding-left: 40px;
}

#ontDevicesPage .ont-toolbar-control:focus {
    border-color: #93c5fd;
    box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.10);
}

#ontDevicesPage .ont-toolbar-meta {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 12px;
    min-width: 0;
}

#ontDevicesPage .ont-toolbar-note {
    font-size: 13px;
    line-height: 1.45;
    color: #64748b;
    white-space: nowrap;
}

#ontDevicesPage .ont-toolbar-actions {
    display: flex;
    justify-content: flex-end;
    white-space: nowrap;
}

#ontDevicesPage .ont-toolbar-btn {
    height: 40px;
    border-radius:3px;
    padding: 0 14px;
    font-size: 13px;
    font-weight: 700;
    border-color: #dbe3ef;
    color: #64748b;
    background: #fff;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    box-shadow: none;
}

#ontDevicesPage .ont-toolbar-btn:hover,
#ontDevicesPage .ont-toolbar-btn:focus {
    background: #f8fafc;
    border-color: #cbd5e1;
    color: #334155;
}

/* =========================================================
   FILTER CHIPS
========================================================= */
#ontDevicesPage .nx-filter-bar {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-wrap: wrap;
    margin-bottom: 14px;
}

#ontDevicesPage .nx-filter-chip {
    height: 30px;
    padding: 0 12px;
    border-radius:3px;
    border: 1px solid #dbe3ef;
    background: #fff;
    color: #475569;
    font-size: 12px;
    font-weight: 700;
    line-height: 1;
    transition: all .18s ease;
}

#ontDevicesPage .nx-filter-chip:hover {
    background: #f8fafc;
    border-color: #cbd5e1;
    color: #334155;
}

#ontDevicesPage .nx-filter-chip.active {
    background: linear-gradient(135deg, #3b82f6 0%, #2563eb 100%);
    border-color: #2563eb;
    color: #fff;
    box-shadow: 0 10px 20px rgba(37, 99, 235, 0.16);
}

/* =========================================================
   SUMMARY CARDS
========================================================= */
#ontDevicesPage .nx-summary-card {
    position: relative;
    min-height: 142px;
    border-radius:3px;
    background: linear-gradient(180deg, #ffffff 0%, #fbfdff 100%);
    border: 1px solid rgba(226, 232, 240, 0.9);
    box-shadow: var(--ont-shadow-soft);
    overflow: hidden;
    padding: 22px 24px;
}

#ontDevicesPage .nx-summary-card::before {
    content: "";
    position: absolute;
    inset: 0 auto 0 0;
    width: 5px;
    border-radius:3px;
}

#ontDevicesPage .nx-summary-primary::before {
    background: linear-gradient(180deg, #3b82f6 0%, #1d4ed8 100%);
}

#ontDevicesPage .nx-summary-success::before {
    background: linear-gradient(180deg, #22c55e 0%, #15803d 100%);
}

#ontDevicesPage .nx-summary-danger::before {
    background: linear-gradient(180deg, #ef4444 0%, #dc2626 100%);
}

#ontDevicesPage .nx-summary-cyan::before {
    background: linear-gradient(180deg, #06b6d4 0%, #0891b2 100%);
}

#ontDevicesPage .nx-summary-slate::before {
    background: linear-gradient(180deg, #64748b 0%, #334155 100%);
}

#ontDevicesPage .nx-summary-online::before {
    background: linear-gradient(180deg, #22c55e 0%, #15803d 100%);
}

#ontDevicesPage .nx-summary-matched::before {
    background: linear-gradient(180deg, #06b6d4 0%, #0891b2 100%);
}

#ontDevicesPage .nx-summary-top {
    position: relative;
    z-index: 1;
    display: flex;
    justify-content: space-between;
    gap: 16px;
}

#ontDevicesPage .nx-summary-label {
    font-size: 12px;
    font-weight: 700;
    color: #64748b;
    margin-bottom: 8px;
    letter-spacing: .02em;
}

#ontDevicesPage .nx-summary-value {
    font-size: 20px;
    font-weight: 800;
    color: #0f172a;
    line-height: 1.1;
    margin-bottom: 8px;
}

#ontDevicesPage .nx-summary-text,
#ontDevicesPage .nx-summary-subtext {
    font-size: 13px;
    color: #6b7280;
    line-height: 1.45;
    max-width: 240px;
}

#ontDevicesPage .nx-summary-icon {
    width: 38px;
    height: 38px;
    border-radius:3px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: #eff6ff;
    color: #2563eb;
    font-size: 15px;
    flex: 0 0 auto;
    margin-top: 2px;
}

/* =========================================================
   TABLE / CONTENT CARD
========================================================= */
#ontDevicesPage .nx-surface-card .card-body:has(#inventoryTable),
#ontDevicesPage .nx-surface-card .card-body:has(#discoveryTable),
#ontDevicesPage .nx-surface-card .card-body:has(#remoteManagementTable) {
    padding: 0;
}

#ontDevicesPage #inventoryTable,
#ontDevicesPage #discoveryTable,
#ontDevicesPage #remoteManagementTable {
    min-height: 180px;
}

#ontDevicesPage .nx-table-wrap {
    overflow-x: auto;
    overflow-y: hidden;
}

#ontDevicesPage table {
    width: 100%;
    table-layout: fixed;
    margin-bottom: 0;
}

#ontDevicesPage .table th,
#ontDevicesPage .table td {
    vertical-align: middle;
}

#ontDevicesPage .table thead th {
    white-space: nowrap;
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 0.10em;
    text-transform: uppercase;
    color: #475569;
    border-bottom-color: #e2e8f0;
    padding-top: 18px;
    padding-bottom: 14px;
    background: #f8fafc;
}

#ontDevicesPage .table tbody td {
    padding-top: 16px;
    padding-bottom: 16px;
    border-bottom-color: #edf2f7;
}

#ontDevicesPage .table td:last-child,
#ontDevicesPage .table th:last-child {
    text-align: right;
    white-space: nowrap;
}

#ontDevicesPage .sort-indicator {
    font-size: 11px;
    margin-left: 4px;
    color: #64748b;
}

/* =========================================================
   COPY INLINE / ACTIONS
========================================================= */
#ontDevicesPage .nx-copy-inline {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-width: 0;
}

#ontDevicesPage .nx-copy-inline .fw-semibold {
    color: #0f172a;
    font-weight: 700 !important;
}

#ontDevicesPage .nx-copy-btn {
    width: 28px;
    height: 28px;
    border: 1px solid #dbe3ef;
    border-radius:3px;
    background: #fff;
    color: #64748b;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    transition: all .18s ease;
}

#ontDevicesPage .nx-copy-btn:hover {
    background: #eff6ff;
    border-color: #bfdbfe;
    color: #1d4ed8;
}

#ontDevicesPage .nx-icon-btn {
    width: 36px;
    height: 36px;
    min-width: 36px;
    min-height: 36px;
    padding: 0;
    border-radius:3px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    line-height: 1;
    box-shadow: none;
}

#ontDevicesPage .nx-icon-btn i {
    font-size: 13px;
    line-height: 1;
    display: inline-flex;
    align-items: center;
    justify-content: center;
}

#ontDevicesPage .btn-outline-secondary.nx-icon-btn {
    border-color: #d9e1ec;
    color: #64748b;
    background: #fff;
}

#ontDevicesPage .btn-outline-secondary.nx-icon-btn:hover {
    background: #f8fafc;
    border-color: #cbd5e1;
    color: #334155;
}

#ontDevicesPage .btn-outline-primary.nx-icon-btn {
    border-color: #bfdbfe;
    color: #2563eb;
    background: #fff;
}

#ontDevicesPage .btn-outline-primary.nx-icon-btn:hover {
    background: #eff6ff;
    border-color: #93c5fd;
    color: #1d4ed8;
}

#ontDevicesPage .btn-outline-success.nx-icon-btn {
    border-color: #bbf7d0;
    color: #16a34a;
    background: #fff;
}

#ontDevicesPage .btn-outline-success.nx-icon-btn:hover {
    background: #f0fdf4;
    border-color: #86efac;
    color: #15803d;
}

#ontDevicesPage .btn-outline-danger.nx-icon-btn {
    border-color: #fecaca;
    color: #ef4444;
    background: #fff;
}

#ontDevicesPage .btn-outline-danger.nx-icon-btn:hover {
    background: #fef2f2;
    border-color: #fca5a5;
    color: #dc2626;
}

/* =========================================================
   BADGES
========================================================= */
#ontDevicesPage .nx-soft-badge,
#ontDevicesPage .badge {
    font-size: 11px;
    padding: 5px 10px;
    border-radius:3px;
    font-weight: 800;
    letter-spacing: .02em;
    min-width: 96px;
    justify-content: center;
    display: inline-flex;
    align-items: center;
}

#ontDevicesPage .nx-soft-badge-success {
    background: #e8f8ef;
    color: #15803d;
}

#ontDevicesPage .nx-soft-badge-danger {
    background: #fef2f2;
    color: #dc2626;
}

#ontDevicesPage .nx-soft-badge-warning {
    background: #fffbeb;
    color: #b45309;
}

#ontDevicesPage .nx-soft-badge-info {
    background: #ecfeff;
    color: #0891b2;
}

/* =========================================================
   EMPTY STATE
========================================================= */
#ontDevicesPage .nx-empty-state {
    padding: 36px 20px;
    text-align: center;
}

#ontDevicesPage .nx-empty-icon {
    width: 64px;
    height: 64px;
    margin: 0 auto 14px;
    border-radius:3px;
    background: #eff6ff;
    color: #2563eb;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 24px;
}

#ontDevicesPage .nx-empty-title {
    font-size: 18px;
    font-weight: 800;
    color: #0f172a;
    margin-bottom: 6px;
}

#ontDevicesPage .nx-empty-text {
    font-size: 14px;
    color: #64748b;
    line-height: 1.55;
    margin-bottom: 16px;
}

/* =========================================================
   MODALS
========================================================= */
#ontDevicesPage .nx-modal .modal-dialog {
    max-width: 1100px;
}

#ontDevicesPage .nx-modal-content {
    border: 0;
    border-radius:3px;
    box-shadow: 0 20px 50px rgba(15, 23, 42, 0.18);
    overflow: hidden;
}

#ontDevicesPage .nx-modal-header {
    padding: 18px 22px;
    border-bottom: 1px solid #eef2f7;
    background: #fff;
}

#ontDevicesPage .nx-modal-body {
    background: #f8fafc;
    padding: 20px;
}

#ontDevicesPage .nx-modal-footer {
    padding: 16px 22px;
    border-top: 1px solid #eef2f7;
    background: #fff;
}

#ontDevicesPage .nx-section-card {
    background: #fff;
    border: 1px solid #edf2f7;
    border-radius:3px;
    padding: 18px 18px 14px;
    margin-bottom: 18px;
    box-shadow: 0 4px 18px rgba(15, 23, 42, 0.04);
}

#ontDevicesPage .nx-grid-2 {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px 18px;
}

#ontDevicesPage .nx-span-2 {
    grid-column: 1 / -1;
}

#ontDevicesPage .nx-field label {
    display: block;
    font-size: 12px;
    font-weight: 600;
    color: #6b7280;
    margin-bottom: 6px;
    text-transform: uppercase;
    letter-spacing: .04em;
}

#ontDevicesPage .nx-field div {
    min-height: 42px;
    display: flex;
    align-items: center;
    padding: 10px 12px;
    background: #f8fafc;
    border: 1px solid #eef2f7;
    border-radius:3px;
    color: #111827;
    word-break: break-word;
}

/* =========================================================
   SWEETALERT
========================================================= */
.swal2-popup.nx-toast-popup {
    border-radius:3px !important;
    box-shadow: 0 16px 36px rgba(15, 23, 42, .16) !important;
}

/* =========================
   ACS DEVICE DETAIL PAGE
   ========================= */

#ontAcsDevicePage {
    padding-bottom: 16px;
}

#ontAcsDevicePage .nx-surface-card {
    border-radius:3px;
}

#acsDeviceHeader .card-body,
#acsDeviceContent .card-body {
    padding: 20px 22px;
}

#acsDeviceTabs.nx-segment-control {
    display: flex;
    width: 100%;
    justify-content: flex-start;
    gap: 6px;
    padding: 4px;
    background: #eef3f8;
    border: 1px solid #dbe5ef;
    border-radius:3px;
    margin-bottom: 0;
}

#acsDeviceTabs .nx-segment-item {
    min-width: 104px;
    height: 34px;
    padding: 0 16px;
    border-radius:3px;
    font-size: 13px;
    font-weight: 700;
    display: inline-flex !important;
    align-items: center !important;
    justify-content: center !important;
    gap: 8px !important;
}

#acsDeviceTabs .nx-segment-item.active {
    background: #0d6efd;
    color: #fff;
    box-shadow: 0 4px 12px rgba(13,110,253,.20);
}

#acsDeviceTabs .nx-segment-item i {
    margin-right: 0 !important;
    font-size: 13px !important;
    line-height: 1 !important;
}

.ont-acs-hero {
    border-radius:3px;
    overflow: hidden;
    background: #fff;
    border: 1px solid #e5e7eb;
    box-shadow: 0 8px 28px rgba(15,23,42,.06);
}

.ont-acs-hero-title {
    font-size: 15px;
    font-weight: 600;
    color: #6b7280;
    margin-bottom: 4px;
}

.ont-acs-hero-serial {
    font-size: 34px;
    font-weight: 800;
    line-height: 1.05;
    color: #111827;
    margin-bottom: 18px;
}

.ont-acs-pill-row {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
}

.ont-acs-pill {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 12px 14px;
    background: #ffffff;
    border: 1px solid #e5e7eb;
    border-radius:3px;
    min-width: 200px;
    box-shadow: 0 2px 6px rgba(15,23,42,.03);
}

.ont-acs-pill-icon {
    width: 34px;
    height: 34px;
    border-radius:3px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #eff6ff;
    color: #2563eb;
    font-size: 16px;
    flex: 0 0 auto;
}

.ont-acs-pill-label {
    font-size: 12px;
    color: #6b7280;
    line-height: 1.1;
    margin-bottom: 2px;
}

.ont-acs-pill-value {
    font-size: 14px;
    font-weight: 700;
    color: #111827;
    line-height: 1.2;
}

.ont-acs-action-stack {
    display: grid;
    gap: 10px;
}

.ont-acs-action-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    height: 38px;
    border-radius:3px;
    font-weight: 700;
    font-size: 13px;
    background: #fff;
}

.ont-acs-section-title {
    display: flex !important;
    align-items: flex-start !important;
    justify-content: space-between !important;
    gap: 12px !important;
    margin-bottom: 14px !important;
}

.ont-acs-section-title h5,
.ont-acs-section-title h4 {
    margin: 0;
    font-weight: 800;
    color: #111827;
}

.ont-acs-section-title h4 {
    font-size: 16px !important;
    line-height: 1.2 !important;
}

.ont-acs-section-title .text-muted.small {
    margin-top: 3px !important;
    font-size: 12px !important;
    color: #6b7280 !important;
    line-height: 1.2 !important;
}

.ont-acs-interface-card {
    border: 1px solid #e5e7eb;
    border-radius:3px;
    padding: 20px;
    background: #fff;
    box-shadow: 0 4px 14px rgba(15,23,42,.04);
}

.ont-acs-interface-head {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 14px;
    flex-wrap: wrap;
    margin-bottom: 20px;
}

.ont-acs-interface-name {
    font-size: 28px;
    font-weight: 800;
    color: #111827;
    line-height: 1.1;
    margin-bottom: 6px;
}

.ont-acs-interface-sub {
    font-size: 14px;
    color: #6b7280;
}

.ont-acs-actions-inline {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
}

.ont-acs-info-grid {
    display: grid;
    grid-template-columns: repeat(2,minmax(0,1fr));
    gap: 22px 28px;
    margin-bottom: 22px;
}

.ont-acs-info-item {
    min-width: 0;
}

.ont-acs-info-label {
    font-size: 13px;
    color: #6b7280;
    margin-bottom: 4px;
}

.ont-acs-info-value {
    font-size: 16px;
    font-weight: 700;
    color: #111827;
    word-break: break-word;
}

.ont-acs-subpanel {
    border: 1px solid #e5e7eb;
    border-radius:3px;
    padding: 18px;
    background: #f8fafc;
}

.ont-acs-subpanel-title {
    font-size: 16px;
    font-weight: 800;
    color: #111827;
    margin-bottom: 16px;
    display: flex;
    align-items: center;
    gap: 8px;
}

.ont-acs-metric-grid {
    display: grid;
    grid-template-columns: repeat(4,minmax(0,1fr));
    gap: 14px;
}

.ont-acs-metric-card {
    border: 1px solid #e5e7eb;
    border-radius:3px;
    padding: 16px;
    background: #fff;
    min-height: 96px;
}

.ont-acs-metric-label {
    font-size: 12px;
    color: #6b7280;
    margin-bottom: 8px;
}

.ont-acs-metric-value {
    font-size: 22px;
    font-weight: 800;
    color: #111827;
    line-height: 1.1;
}

.ont-acs-bigpanel {
    border: 1px solid #e5e7eb;
    border-radius:3px;
    padding: 22px;
    background: #fff;
    box-shadow: 0 4px 14px rgba(15,23,42,.04);
}

.ont-acs-wifi-head {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 14px;
    flex-wrap: wrap;
    margin-bottom: 20px;
}

.ont-acs-wifi-left {
    display: flex;
    align-items: flex-start;
    gap: 14px;
}

.ont-acs-wifi-icon {
    width: 52px;
    height: 52px;
    border-radius:3px;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 1px solid #dbe5ef;
    background: #f8fafc;
    color: #2563eb;
    font-size: 22px;
}

.ont-acs-wifi-title {
    font-size: 30px;
    font-weight: 800;
    color: #111827;
    line-height: 1.1;
    margin-bottom: 4px;
}

.ont-acs-wifi-sub {
    font-size: 14px;
    color: #6b7280;
}

.ont-acs-btn-row {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
}

.ont-acs-enable-box {
    border: 1px solid #e5e7eb;
    border-radius:3px;
    padding: 16px;
    background: #f8fafc;
}

.ont-acs-actions-grid {
    display: grid;
    grid-template-columns: repeat(2,minmax(0,1fr));
    gap: 18px;
}

.ont-acs-danger-card,
.ont-acs-primary-card {
    border-radius:3px;
    padding: 22px;
    height: 100%;
    border: 1px solid transparent;
}

.ont-acs-primary-card {
    background: #eaf2ff;
    border-color: #cfe0ff;
}

.ont-acs-danger-card {
    background: #fdecec;
    border-color: #f7c7c7;
}

.ont-acs-action-card-title {
    font-size: 30px;
    font-weight: 800;
    line-height: 1.1;
    color: #111827;
    margin-bottom: 8px;
}

.ont-acs-action-card-sub {
    font-size: 14px;
    color: #4b5563;
    margin-bottom: 16px;
}

.ont-acs-action-card-list {
    padding-left: 18px;
    margin: 0;
    color: #4b5563;
    font-size: 13px;
    line-height: 1.7;
}

.ont-acs-stat-grid {
    display: grid;
    grid-template-columns: repeat(4,minmax(0,1fr));
    gap: 16px;
}

.ont-acs-stat-box {
    border: 1px solid #e5e7eb;
    border-radius:3px;
    padding: 18px;
    background: #fff;
    min-height: 108px;
}

.ont-acs-stat-box .small {
    font-size: 12px;
    color: #6b7280;
    margin-bottom: 8px;
}

.ont-acs-stat-box .fw-semibold {
    font-size: 16px;
    font-weight: 800 !important;
    color: #111827;
    word-break: break-word;
}

.ont-acs-clients-table thead th {
    font-size: 12px;
    font-weight: 800;
    letter-spacing: .04em;
    text-transform: none;
    background: #f8fafc;
}

.ont-acs-clients-table tbody td {
    font-size: 14px;
}

.placeholder {
    display: inline-block;
    height: 14px;
    border-radius:3px;
    background: #e5e7eb;
}

/* ===== ACS SUMMARY FIX ===== */

.acs-stats-row {
    display: grid !important;
    grid-template-columns: repeat(2, minmax(0, 1fr)) !important;
    gap: 16px !important;
    margin-bottom: 16px !important;
}

.acs-stat-card {
    display: flex !important;
    align-items: center !important;
    gap: 12px !important;
    padding: 16px 18px !important;
    border-radius:3px !important;
    background: #f8fafc !important;
    border: 1px solid #e5e7eb !important;
    min-height: 86px !important;
    transition: all .18s ease !important;
}

.acs-stat-card:hover {
    background: #f1f5f9 !important;
    border-color: #dbe5ef !important;
}

.acs-stat-card.success {
    background: #ecfdf5 !important;
    border-color: #bbf7d0 !important;
}

.acs-stat-card.primary {
    background: #eff6ff !important;
    border-color: #bfdbfe !important;
}

.acs-stat-icon {
    width: 42px !important;
    height: 42px !important;
    border-radius:3px !important;
    display: flex !important;
    align-items: center !important;
    justify-content: center !important;
    background: #ffffff !important;
    border: 1px solid #e5e7eb !important;
    flex: 0 0 42px !important;
    margin-right: 0 !important;
    opacity: 1 !important;
}

.acs-stat-icon i {
    font-size: 16px !important;
    color: #2563eb !important;
}

.acs-stat-card.success .acs-stat-icon i {
    color: #16a34a !important;
}

.acs-stat-text {
    display: flex !important;
    flex-direction: column !important;
    min-width: 0 !important;
}

.acs-stat-label {
    font-size: 11px !important;
    font-weight: 700 !important;
    text-transform: uppercase !important;
    letter-spacing: .03em !important;
    color: #9ca3af !important;
    opacity: 1 !important;
    margin-bottom: 3px !important;
    line-height: 1.15 !important;
}

.acs-stat-value {
    font-size: 22px !important;
    font-weight: 800 !important;
    color: #111827 !important;
    line-height: 1.15 !important;
    word-break: break-word !important;
}

.acs-overview-grid {
    display: grid !important;
    grid-template-columns: repeat(2, minmax(0, 1fr)) !important;
    gap: 14px 16px !important;
}

.acs-overview-item {
    min-width: 0 !important;
    padding: 14px 16px !important;
    border: 1px solid #e5e7eb !important;
    border-radius:3px !important;
    background: #ffffff !important;
    box-shadow: none !important;
}

.acs-overview-label {
    font-size: 11px !important;
    font-weight: 700 !important;
    text-transform: none !important;
    letter-spacing: 0 !important;
    color: #9ca3af !important;
    opacity: 1 !important;
    margin-bottom: 5px !important;
    line-height: 1.1 !important;
}

.acs-overview-value {
    font-size: 18px !important;
    font-weight: 800 !important;
    color: #111827 !important;
    line-height: 1.25 !important;
    word-break: break-word !important;
}

/* ===== Optical ===== */

.ont-optical-card {
    border: 1px solid #e5e7eb !important;
    background: #ffffff !important;
    box-shadow: 0 8px 24px rgba(15,23,42,.06) !important;
}

.ont-optical-header {
    align-items: center !important;
    margin-bottom: 12px !important;
}

.ont-optical-title-block {
    display: flex;
    flex-direction: column;
    gap: 2px;
}

.ont-optical-title-block h4 {
    margin: 0 !important;
}

.ont-optical-title-block .text-muted.small {
    margin: 0 !important;
}

.ont-optical-card .card-body {
    padding-top: 14px !important;
}

.ont-optical-card .acs-stats-row {
    margin-top: 4px !important;
}

#opticalRx,
#opticalTx {
    font-size: 24px !important;
    font-weight: 900 !important;
    line-height: 1 !important;
}

#opticalRxWrap {
    display: flex !important;
    align-items: center !important;
    gap: 8px !important;
    flex-wrap: wrap !important;
}

#opticalRxBadge {
    display: inline-flex !important;
    align-items: center !important;
}

#opticalRxBadge .badge {
    font-size: 10px !important;
    font-weight: 800 !important;
    letter-spacing: .03em !important;
    padding: 5px 8px !important;
    border-radius:3px !important;
    line-height: 1 !important;
}

.optical-good {
    color: #198754 !important;
    font-weight: 800 !important;
}

.optical-warning {
    color: #d97706 !important;
    font-weight: 800 !important;
}

.optical-critical {
    color: #dc2626 !important;
    font-weight: 800 !important;
}

#refreshOpticalBtn {
    white-space: nowrap !important;
    font-size: 12px !important;
    font-weight: 700 !important;
    border-radius:3px !important;
    padding: 6px 12px !important;
    box-shadow: none !important;
}

/* =========================================================
   RESPONSIVE
========================================================= */
@media (max-width: 1199px) {
    #ontDevicesPage table {
        table-layout: auto;
        min-width: 1080px;
    }

    #ontDevicesPage .ont-toolbar-grid {
        grid-template-columns: 1fr;
    }

    #ontDevicesPage .ont-toolbar-meta {
        justify-content: space-between;
        white-space: normal;
    }

    .ont-acs-metric-grid,
    .ont-acs-stat-grid {
        grid-template-columns: repeat(2,minmax(0,1fr));
    }
}

@media (max-width: 992px) {
    #ontDevicesPage .nx-page-header {
        flex-direction: column;
        align-items: flex-start;
    }

    #ontDevicesPage .nx-page-actions {
        width: 100%;
    }

    #ontDevicesPage .nx-grid-2 {
        grid-template-columns: 1fr;
    }

    #ontDevicesPage .ont-toolbar-meta {
        flex-direction: column;
        align-items: flex-start;
        justify-content: flex-start;
    }

    .acs-stats-row {
        grid-template-columns: 1fr !important;
    }

    .acs-overview-grid {
        grid-template-columns: 1fr !important;
    }
}

@media (max-width: 768px) {
    #ontDevicesPage .nx-summary-card {
        min-height: 128px;
        padding: 20px 22px;
    }

    #ontDevicesPage .nx-segment-control {
        width: 100%;
        flex-wrap: wrap;
    }

    #ontDevicesPage .nx-segment-item {
        flex: 1 1 calc(50% - 8px);
        min-width: unset;
    }

    .ont-acs-pill-row {
        flex-direction: column;
    }

    .ont-acs-pill {
        min-width: unset;
        width: 100%;
    }

    .ont-acs-info-grid,
    .ont-acs-metric-grid,
    .ont-acs-stat-grid,
    .ont-acs-actions-grid {
        grid-template-columns: 1fr;
    }

    .ont-acs-interface-name,
    .ont-acs-wifi-title,
    .ont-acs-action-card-title {
        font-size: 24px;
    }

    #acsDeviceTabs .nx-segment-item {
        min-width: unset;
        flex: 1 1 auto;
        gap: 6px !important;
    }

    #acsDeviceTabs .nx-segment-item i {
        font-size: 13px !important;
    }

    .ont-acs-action-stack {
        width: 100%;
        display: grid;
        gap: 10px;
    }

    .ont-acs-action-btn {
        width: 100%;
    }
}

/* =========================================================
   ONT DEVICES DARK MODE
   Place at VERY BOTTOM of OntDevices.css
========================================================= */

html[data-theme="dark"] #ontDevicesPage,
html[data-theme="dark"] #ontAcsDevicePage {
    --ont-blue: #60a5fa;
    --ont-blue-dark: #3b82f6;
    --ont-ink: #f8fafc;
    --ont-muted: #94a3b8;
    --ont-line: #2b3d56;
    --ont-surface: #182235;
    --ont-surface-soft: #101827;
    --ont-shadow-soft: 0 12px 26px rgba(0, 0, 0, .28);
    --ont-shadow-lg: 0 18px 36px rgba(0, 0, 0, .34);
}

/* Surfaces */
html[data-theme="dark"] #ontDevicesPage .nx-surface-card,
html[data-theme="dark"] #ontDevicesPage .nx-toolbar-card,
html[data-theme="dark"] #ontDevicesPage .nx-content-card,
html[data-theme="dark"] #ontDevicesPage .nx-page-header-card,
html[data-theme="dark"] #ontDevicesPage .nx-summary-card,
html[data-theme="dark"] #ontDevicesPage .nx-section-card,
html[data-theme="dark"] #ontAcsDevicePage .nx-surface-card,
html[data-theme="dark"] .ont-acs-hero,
html[data-theme="dark"] .ont-acs-interface-card,
html[data-theme="dark"] .ont-acs-bigpanel,
html[data-theme="dark"] .ont-optical-card {
    background:
            radial-gradient(circle at top right, rgba(59,130,246,.10), transparent 30%),
            linear-gradient(180deg, #182235 0%, #141f31 100%) !important;
    border-color: rgba(255,255,255,.06) !important;
    color: var(--ont-ink) !important;
    box-shadow: var(--ont-shadow-soft) !important;
}

/* Text */
html[data-theme="dark"] #ontDevicesPage .nx-page-title,
html[data-theme="dark"] #ontDevicesPage .nx-summary-value,
html[data-theme="dark"] #ontDevicesPage .nx-empty-title,
html[data-theme="dark"] #ontDevicesPage .nx-copy-inline .fw-semibold,
html[data-theme="dark"] #ontDevicesPage .nx-field div,
html[data-theme="dark"] .ont-acs-hero-serial,
html[data-theme="dark"] .ont-acs-pill-value,
html[data-theme="dark"] .ont-acs-section-title h4,
html[data-theme="dark"] .ont-acs-section-title h5,
html[data-theme="dark"] .ont-acs-interface-name,
html[data-theme="dark"] .ont-acs-info-value,
html[data-theme="dark"] .ont-acs-subpanel-title,
html[data-theme="dark"] .ont-acs-metric-value,
html[data-theme="dark"] .ont-acs-wifi-title,
html[data-theme="dark"] .ont-acs-action-card-title,
html[data-theme="dark"] .ont-acs-stat-box .fw-semibold,
html[data-theme="dark"] .acs-stat-value,
html[data-theme="dark"] .acs-overview-value {
    color: #f8fafc !important;
}

html[data-theme="dark"] #ontDevicesPage .nx-page-subtitle,
html[data-theme="dark"] #ontDevicesPage .nx-summary-label,
html[data-theme="dark"] #ontDevicesPage .nx-summary-text,
html[data-theme="dark"] #ontDevicesPage .nx-summary-subtext,
html[data-theme="dark"] #ontDevicesPage .nx-empty-text,
html[data-theme="dark"] #ontDevicesPage .sort-indicator,
html[data-theme="dark"] #ontDevicesPage .ont-toolbar-note,
html[data-theme="dark"] #ontDevicesPage .nx-field label,
html[data-theme="dark"] .ont-acs-hero-title,
html[data-theme="dark"] .ont-acs-pill-label,
html[data-theme="dark"] .ont-acs-interface-sub,
html[data-theme="dark"] .ont-acs-info-label,
html[data-theme="dark"] .ont-acs-wifi-sub,
html[data-theme="dark"] .ont-acs-action-card-sub,
html[data-theme="dark"] .ont-acs-action-card-list,
html[data-theme="dark"] .ont-acs-stat-box .small,
html[data-theme="dark"] .acs-stat-label,
html[data-theme="dark"] .acs-overview-label {
    color: #94a3b8 !important;
}

/* Hero badge */
html[data-theme="dark"] #ontDevicesPage .ont-hero-badge {
    background: rgba(59,130,246,.16) !important;
    color: #93c5fd !important;
    border: 1px solid rgba(147,197,253,.18) !important;
}

/* Segments / filters */
html[data-theme="dark"] #ontDevicesPage .nx-segment-control,
html[data-theme="dark"] #acsDeviceTabs.nx-segment-control {
    background: #101827 !important;
    border-color: #334155 !important;
    box-shadow: none !important;
}

html[data-theme="dark"] #ontDevicesPage .nx-segment-item {
    color: #93c5fd !important;
}

html[data-theme="dark"] #ontDevicesPage .nx-segment-item:hover {
    background: rgba(59,130,246,.14) !important;
    color: #bfdbfe !important;
}

html[data-theme="dark"] #ontDevicesPage .nx-segment-item.active,
html[data-theme="dark"] #acsDeviceTabs .nx-segment-item.active {
    color: #ffffff !important;
    background: linear-gradient(135deg, #3b82f6, #2563eb) !important;
}

/* Forms */
html[data-theme="dark"] #ontDevicesPage .form-control,
html[data-theme="dark"] #ontDevicesPage .form-select,
html[data-theme="dark"] #ontDevicesPage .ont-toolbar-control {
    background: #101827 !important;
    border-color: #334155 !important;
    color: #f8fafc !important;
}

html[data-theme="dark"] #ontDevicesPage .form-control::placeholder {
    color: #64748b !important;
}

/* Tables */
html[data-theme="dark"] #ontDevicesPage .nx-table-wrap,
html[data-theme="dark"] #ontDevicesPage table,
html[data-theme="dark"] #ontDevicesPage .table,
html[data-theme="dark"] .ont-acs-clients-table {
    background: #141f31 !important;
    color: #dbe4f0 !important;
}

html[data-theme="dark"] #ontDevicesPage .table thead,
html[data-theme="dark"] #ontDevicesPage .table thead tr,
html[data-theme="dark"] #ontDevicesPage .table thead th,
html[data-theme="dark"] .ont-acs-clients-table thead th {
    background: #101827 !important;
    color: #9aabc1 !important;
    border-color: #2b3d56 !important;
}

html[data-theme="dark"] #ontDevicesPage .table tbody,
html[data-theme="dark"] #ontDevicesPage .table tbody tr,
html[data-theme="dark"] #ontDevicesPage .table tbody td,
html[data-theme="dark"] .ont-acs-clients-table tbody td {
    background: #141f31 !important;
    color: #dbe4f0 !important;
    border-color: rgba(255,255,255,.06) !important;
}

html[data-theme="dark"] #ontDevicesPage .table tbody tr:hover,
html[data-theme="dark"] #ontDevicesPage .table tbody tr:hover td {
    background: #182235 !important;
    color: #ffffff !important;
}

html[data-theme="dark"] #ontDevicesPage .table > :not(caption) > * > * {
    background-color: transparent !important;
    color: inherit !important;
    box-shadow: none !important;
}

/* Buttons */
html[data-theme="dark"] #ontDevicesPage .btn-light.nx-header-btn,
html[data-theme="dark"] #ontDevicesPage .ont-toolbar-btn,
html[data-theme="dark"] #ontDevicesPage .nx-filter-chip,
html[data-theme="dark"] #ontDevicesPage .nx-copy-btn,
html[data-theme="dark"] .ont-acs-action-btn {
    background: #182235 !important;
    border-color: #334155 !important;
    color: #e5e7eb !important;
}

html[data-theme="dark"] #ontDevicesPage .btn-light.nx-header-btn:hover,
html[data-theme="dark"] #ontDevicesPage .ont-toolbar-btn:hover,
html[data-theme="dark"] #ontDevicesPage .nx-filter-chip:hover,
html[data-theme="dark"] #ontDevicesPage .nx-copy-btn:hover,
html[data-theme="dark"] .ont-acs-action-btn:hover {
    background: #22324b !important;
    border-color: #475569 !important;
    color: #ffffff !important;
}

html[data-theme="dark"] #ontDevicesPage .nx-filter-chip.active {
    background: linear-gradient(135deg, #3b82f6, #2563eb) !important;
    border-color: #3b82f6 !important;
    color: #ffffff !important;
}

/* Icon buttons */
html[data-theme="dark"] #ontDevicesPage .btn-outline-secondary.nx-icon-btn,
html[data-theme="dark"] #ontDevicesPage .btn-outline-primary.nx-icon-btn,
html[data-theme="dark"] #ontDevicesPage .btn-outline-success.nx-icon-btn,
html[data-theme="dark"] #ontDevicesPage .btn-outline-danger.nx-icon-btn {
    background: #182235 !important;
    border-color: #334155 !important;
}

html[data-theme="dark"] #ontDevicesPage .btn-outline-secondary.nx-icon-btn {
    color: #cbd5e1 !important;
}

html[data-theme="dark"] #ontDevicesPage .btn-outline-primary.nx-icon-btn {
    color: #60a5fa !important;
}

html[data-theme="dark"] #ontDevicesPage .btn-outline-success.nx-icon-btn {
    color: #4ade80 !important;
}

html[data-theme="dark"] #ontDevicesPage .btn-outline-danger.nx-icon-btn {
    color: #f87171 !important;
}

/* Badges */
html[data-theme="dark"] #ontDevicesPage .nx-soft-badge-success {
    background: rgba(34,197,94,.14) !important;
    color: #4ade80 !important;
}

html[data-theme="dark"] #ontDevicesPage .nx-soft-badge-danger {
    background: rgba(239,68,68,.14) !important;
    color: #f87171 !important;
}

html[data-theme="dark"] #ontDevicesPage .nx-soft-badge-warning {
    background: rgba(245,158,11,.16) !important;
    color: #fbbf24 !important;
}

html[data-theme="dark"] #ontDevicesPage .nx-soft-badge-info {
    background: rgba(56,189,248,.14) !important;
    color: #7dd3fc !important;
}

/* ACS cards */
html[data-theme="dark"] .ont-acs-pill,
html[data-theme="dark"] .ont-acs-subpanel,
html[data-theme="dark"] .ont-acs-metric-card,
html[data-theme="dark"] .ont-acs-stat-box,
html[data-theme="dark"] .acs-stat-card,
html[data-theme="dark"] .acs-overview-item,
html[data-theme="dark"] .ont-acs-enable-box {
    background: #101827 !important;
    border-color: #334155 !important;
    color: #f8fafc !important;
}

html[data-theme="dark"] .acs-stat-card.success {
    background: rgba(34,197,94,.12) !important;
    border-color: rgba(74,222,128,.25) !important;
}

html[data-theme="dark"] .acs-stat-card.primary {
    background: rgba(59,130,246,.12) !important;
    border-color: rgba(96,165,250,.25) !important;
}

html[data-theme="dark"] .acs-stat-icon,
html[data-theme="dark"] .ont-acs-pill-icon,
html[data-theme="dark"] .ont-acs-wifi-icon {
    background: rgba(59,130,246,.14) !important;
    border-color: rgba(96,165,250,.20) !important;
    color: #60a5fa !important;
}

html[data-theme="dark"] .ont-acs-primary-card {
    background: rgba(59,130,246,.14) !important;
    border-color: rgba(96,165,250,.25) !important;
}

html[data-theme="dark"] .ont-acs-danger-card {
    background: rgba(239,68,68,.13) !important;
    border-color: rgba(248,113,113,.25) !important;
}

/* Optical */
html[data-theme="dark"] .optical-good {
    color: #4ade80 !important;
}

html[data-theme="dark"] .optical-warning {
    color: #fbbf24 !important;
}

html[data-theme="dark"] .optical-critical {
    color: #f87171 !important;
}

/* Empty / placeholder */
html[data-theme="dark"] #ontDevicesPage .nx-empty-icon {
    background: rgba(59,130,246,.14) !important;
    color: #60a5fa !important;
}

html[data-theme="dark"] .placeholder {
    background: #26364b !important;
}

/* Modals */
html[data-theme="dark"] #ontDevicesPage .nx-modal-content {
    background: #182235 !important;
    color: #f8fafc !important;
    border: 1px solid #2b3d56 !important;
}

html[data-theme="dark"] #ontDevicesPage .nx-modal-header,
html[data-theme="dark"] #ontDevicesPage .nx-modal-footer {
    background: #141f31 !important;
    border-color: #2b3d56 !important;
}

html[data-theme="dark"] #ontDevicesPage .nx-modal-body {
    background: #0b1220 !important;
}

html[data-theme="dark"] #ontDevicesPage .nx-field div {
    background: #101827 !important;
    border-color: #334155 !important;
}

/* Canonical ONT table layout. */
#ontDevicesPage .nx-table-wrap > table,
#ontDevicesPage .nx-table-wrap > .table {
    width: 100% !important;
    min-width: 0 !important;
    table-layout: fixed !important;
}

#ontDevicesPage .nx-table-wrap table thead th {
    height: 44px !important;
    padding: 0 12px !important;
    font-size: 11px !important;
    line-height: 1.2 !important;
    vertical-align: middle !important;
}

#ontDevicesPage .nx-table-wrap table tbody td {
    padding: 12px !important;
    line-height: 1.35 !important;
    vertical-align: middle !important;
    overflow: hidden !important;
    text-overflow: ellipsis !important;
}

#ontDevicesPage .nx-table-wrap table th:last-child .sort-indicator {
    display: none !important;
}

#ontDevicesPage .ont-table-actions {
    display: inline-flex !important;
    align-items: center !important;
    justify-content: flex-end !important;
    gap: 6px !important;
    flex-wrap: nowrap !important;
    white-space: nowrap !important;
}

#ontDevicesPage .nx-table-wrap .nx-copy-inline {
    width: 100% !important;
    max-width: 100% !important;
    gap: 5px !important;
}

#ontDevicesPage .nx-table-wrap .nx-copy-inline .fw-semibold {
    min-width: 0 !important;
    overflow: hidden !important;
    text-overflow: ellipsis !important;
    white-space: nowrap !important;
}

#ontDevicesPage .nx-table-wrap .nx-copy-btn {
    width: 24px !important;
    height: 24px !important;
    flex: 0 0 24px !important;
}

#ontDevicesPage .ont-discovery-olt-select {
    width: 230px !important;
    min-width: 200px !important;
    height: 40px !important;
    font-size: 12px !important;
}

#ontDevicesPage #inventoryTable th:first-child,
#ontDevicesPage #inventoryTable td:first-child {
    width: 160px !important;
}

#ontDevicesPage #inventoryTable th:nth-child(2),
#ontDevicesPage #inventoryTable td:nth-child(2) {
    width: 78px !important;
}

#ontDevicesPage #inventoryTable th:nth-child(3),
#ontDevicesPage #inventoryTable td:nth-child(3) {
    width: 68px !important;
}

#ontDevicesPage #inventoryTable th:nth-child(4),
#ontDevicesPage #inventoryTable td:nth-child(4) {
    width: 110px !important;
}

#ontDevicesPage #inventoryTable th:nth-child(5),
#ontDevicesPage #inventoryTable td:nth-child(5) {
    width: 105px !important;
}

#ontDevicesPage #inventoryTable th:nth-child(6),
#ontDevicesPage #inventoryTable td:nth-child(6) {
    width: 130px !important;
}

#ontDevicesPage #inventoryTable th:nth-child(7),
#ontDevicesPage #inventoryTable td:nth-child(7) {
    width: 130px !important;
}

#ontDevicesPage #inventoryTable th:last-child,
#ontDevicesPage #inventoryTable td:last-child {
    width: 144px !important;
    min-width: 144px !important;
    text-align: right !important;
}

#ontDevicesPage #discoveryTable th:first-child,
#ontDevicesPage #discoveryTable td:first-child {
    width: 42px !important;
    padding-left: 10px !important;
    padding-right: 10px !important;
    text-align: center !important;
}

#ontDevicesPage #discoveryTable thead tr {
    height: 44px !important;
}

#ontDevicesPage #discoveryTable tbody tr,
#ontDevicesPage #discoveryTable tbody td {
    height: 68px !important;
}

#ontDevicesPage #discoveryTable th:first-child .sort-indicator {
    display: none !important;
}

#ontDevicesPage #discoveryTable th:nth-child(2),
#ontDevicesPage #discoveryTable td:nth-child(2) {
    width: 190px !important;
}

#ontDevicesPage #discoveryTable th:nth-child(3),
#ontDevicesPage #discoveryTable td:nth-child(3) {
    width: 88px !important;
}

#ontDevicesPage #discoveryTable th:nth-child(4),
#ontDevicesPage #discoveryTable td:nth-child(4) {
    width: 74px !important;
}

#ontDevicesPage #discoveryTable th:nth-child(5),
#ontDevicesPage #discoveryTable td:nth-child(5) {
    width: 66px !important;
}

#ontDevicesPage #discoveryTable th:nth-child(6),
#ontDevicesPage #discoveryTable td:nth-child(6) {
    width: 170px !important;
    white-space: nowrap !important;
}

#ontDevicesPage #discoveryTable th:nth-child(7),
#ontDevicesPage #discoveryTable td:nth-child(7) {
    width: 132px !important;
}

#ontDevicesPage #discoveryTable th:last-child,
#ontDevicesPage #discoveryTable td:last-child {
    width: 118px !important;
    min-width: 118px !important;
    text-align: right !important;
}

#ontDevicesPage #remoteManagementTable th:first-child,
#ontDevicesPage #remoteManagementTable td:first-child {
    width: 210px !important;
}

#ontDevicesPage #remoteManagementTable th:last-child,
#ontDevicesPage #remoteManagementTable td:last-child {
    width: 84px !important;
    text-align: right !important;
}

@media (max-width: 991.98px) {
    #ontDevicesPage .nx-table-wrap > table,
    #ontDevicesPage .nx-table-wrap > .table {
        min-width: 900px !important;
        table-layout: auto !important;
    }
}
