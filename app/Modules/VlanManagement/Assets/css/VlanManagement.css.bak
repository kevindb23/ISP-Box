    color: #f8fafc !important;
}

html[data-theme="dark"] .swal2-popup.vlan-output-popup .swal2-html-container {
    color: #dbeafe !important;
}

.vlan-output-code {
    display: block;
    width: 100%;
    max-height: 320px;
    overflow: auto;
    padding: 16px;
    border-radius:3px;
    background: #020617 !important;
    color: #dbeafe !important;
    border: 1px solid #334155 !important;
    font-size: 13px;
    line-height: 1.55;
    white-space: pre-wrap;
    word-break: break-word;
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, "Liberation Mono", monospace;
}

.vlan-output-code::selection {
    background: rgba(96, 165, 250, .35);
    color: #ffffff;
}

/* UI AI-SLOP AUDIT: remove decorative gradients and redundant card outlines. */
#vlanManagementApp .nx-page-header-card,
#vlanManagementApp .nx-toolbar-card,
#vlanManagementApp .nx-content-card,
#vlanManagementApp .nx-summary-card {
    border: 0 !important;
    border-radius: 3px;
    box-shadow: none !important;
    background: #fff !important;
    background-image: none !important;
}

#vlanManagementApp .vlan-hero-body,
#vlanManagementApp .nx-toolbar-card .card-body { padding: 16px 20px; }
#vlanManagementApp .nx-toolbar-card .form-control,
#vlanManagementApp .nx-toolbar-card .form-select,
#vlanManagementApp .nx-content-card .form-control,
#vlanManagementApp .nx-content-card .form-select {
    border-radius: 3px;
    box-shadow: none !important;
}
#vlanManagementApp .form-control:focus,
#vlanManagementApp .form-select:focus {
    border-color: #64748b !important;
    box-shadow: 0 0 0 2px rgba(100,116,139,.14) !important;
}

html[data-theme="dark"] #vlanManagementApp .nx-page-header-card,
html[data-theme="dark"] #vlanManagementApp .nx-toolbar-card,
html[data-theme="dark"] #vlanManagementApp .nx-content-card,
html[data-theme="dark"] #vlanManagementApp .nx-summary-card {
    background: #182235 !important;
    background-image: none !important;
}


/* VLAN filter tabs: match the contained CGNAT tab treatment. */
#vlanManagementApp .nx-toolbar-card {
    background: transparent !important;
    background-image: none !important;
}

#vlanManagementApp .nx-toolbar-card .card-body {
    padding: 0 0 24px !important;
}

#vlanManagementApp .vlan-toolbar-grid {
    grid-template-columns: minmax(0, 1fr) minmax(320px, 1fr) !important;
}

#vlanManagementApp .vlan-toolbar-meta {
    display: none !important;
}

#vlanManagementApp .nx-segment-control {
    display: inline-flex !important;
    align-items: stretch !important;
    gap: 2px !important;
    padding: 4px !important;
    margin: 0 !important;
    border: 1px solid var(--nx-border) !important;
    border-radius: 8px !important;
    background: var(--nx-bg-soft) !important;
    background-image: none !important;
    box-shadow: none !important;
    outline: none !important;
}

#vlanManagementApp .nx-segment-control > .nx-segment-item {
    min-width: 118px !important;
    min-height: 40px !important;
    padding: .65rem 1rem !important;
    border: 0 !important;
    border-radius: 5px !important;
    background: transparent !important;
    background-image: none !important;
    color: var(--nx-text-soft) !important;
    font-size: .88rem !important;
    font-weight: 600 !important;
    box-shadow: none !important;
    outline: none !important;
    transition: background-color .16s ease, color .16s ease, box-shadow .16s ease !important;
}

#vlanManagementApp .nx-segment-control > .nx-segment-item:hover {
    background: rgba(37, 99, 235, .08) !important;
    color: var(--nx-primary) !important;
}

#vlanManagementApp .nx-segment-control > .nx-segment-item.active {
    background: var(--nx-primary-2) !important;
    color: #fff !important;
    box-shadow: 0 2px 8px rgba(37, 99, 235, .22) !important;
}

#vlanManagementApp .nx-segment-control > .nx-segment-item:focus-visible {
    outline: none !important;
    box-shadow: 0 0 0 2px rgba(59, 130, 246, .38) !important;
}

#vlanManagementApp .nx-table-wrap,
#vlanManagementApp .nx-table-wrap table,
#vlanManagementApp .nx-table-wrap tbody,
#vlanManagementApp .nx-table-wrap tbody tr,
#vlanManagementApp .nx-table-wrap tbody td {
    background: transparent !important;
    background-image: none !important;
}

#vlanManagementApp .nx-table-wrap tbody tr:hover td {
    background: transparent !important;
}

html[data-theme="dark"] #vlanManagementApp .nx-toolbar-card {
    background: transparent !important;
    background-image: none !important;
}

html[data-theme="dark"] #vlanManagementApp .nx-segment-control {
    border-color: #334155 !important;
    background: #1b2533 !important;
}

html[data-theme="dark"] #vlanManagementApp .nx-segment-control > .nx-segment-item {
    color: #cbd5e1 !important;
}

html[data-theme="dark"] #vlanManagementApp .nx-segment-control > .nx-segment-item:hover {
    background: rgba(59, 130, 246, .14) !important;
    color: #dbeafe !important;
}

html[data-theme="dark"] #vlanManagementApp .nx-segment-control > .nx-segment-item.active {
    background: #3b82f6 !important;
    color: #fff !important;
    box-shadow: 0 2px 10px rgba(59, 130, 246, .30) !important;
}

html[data-theme="dark"] #vlanManagementApp .nx-table-wrap,
html[data-theme="dark"] #vlanManagementApp .nx-table-wrap table,
html[data-theme="dark"] #vlanManagementApp .nx-table-wrap tbody,
