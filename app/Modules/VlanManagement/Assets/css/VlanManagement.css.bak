#vlanManagementApp {
    --subs-blue: #2563eb;
    --subs-blue-dark: #1d4ed8;
    --subs-ink: #0f172a;
    --subs-muted: #64748b;
    --subs-line: #e2e8f0;
    --subs-surface: #ffffff;
    --subs-surface-soft: #f8fafc;
    --subs-shadow-soft: 0 12px 28px rgba(15, 23, 42, 0.05);
    --subs-shadow-lg: 0 20px 40px rgba(15, 23, 42, 0.08);
}

/* =========================================================
   HERO / HEADER
========================================================= */
#vlanManagementApp .nx-page-header-card,
#vlanManagementApp .nx-toolbar-card,
#vlanManagementApp .nx-content-card {
    border-radius:3px;
    overflow: hidden;
}

#vlanManagementApp .nx-page-header-card {
    border: 1px solid rgba(37, 99, 235, 0.08);
    background:
            radial-gradient(circle at top right, rgba(37, 99, 235, 0.10), transparent 28%),
            linear-gradient(180deg, rgba(255,255,255,1) 0%, rgba(248,250,252,0.94) 100%);
    box-shadow: var(--subs-shadow-lg);
}

#vlanManagementApp .vlan-hero-body {
    min-height: 124px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    padding: 24px 28px;
}

#vlanManagementApp .vlan-hero-left {
    max-width: 820px;
}

#vlanManagementApp .vlan-hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 7px 12px;
    border-radius:3px;
    background: rgba(37, 99, 235, 0.08);
    color: var(--subs-blue-dark);
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    margin-bottom: 14px;
}

#vlanManagementApp .vlan-hero-badge i {
    font-size: 11px;
    line-height: 1;
}

#vlanManagementApp .vlan-hero-title {
    margin: 0 0 6px;
    font-size: 18px;
    font-weight: 800;
    color: var(--subs-ink);
    line-height: 1.2;
}

#vlanManagementApp .vlan-hero-text {
    margin: 0;
    font-size: 14px;
    color: var(--subs-muted);
    line-height: 1.55;
}

#vlanManagementApp .vlan-hero-actions {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-wrap: wrap;
}

#vlanManagementApp .vlan-hero-actions .btn {
    height: 40px;
    min-height: 40px;
    padding: 0 16px;
    border-radius:3px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    font-size: 14px;
    font-weight: 700;
    line-height: 1;
    vertical-align: middle;
    box-shadow: none;
}

#vlanManagementApp .vlan-hero-actions .btn-primary {
    background: linear-gradient(135deg, #3b82f6 0%, #2563eb 100%);
    border-color: #2563eb;
}

#vlanManagementApp .vlan-hero-actions .btn-primary:hover,
#vlanManagementApp .vlan-hero-actions .btn-primary:focus {
    background: linear-gradient(135deg, #2563eb 0%, #1d4ed8 100%);
    border-color: #1d4ed8;
}

#vlanManagementApp .vlan-hero-actions .btn-light {
    background: #fff;
    border-color: #dbe3ef;
    color: #0f172a;
}

#vlanManagementApp .vlan-hero-actions .btn-light:hover,
#vlanManagementApp .vlan-hero-actions .btn-light:focus {
    background: #f8fafc;
    border-color: #cbd5e1;
    color: #0f172a;
}

/* =========================================================
   SUMMARY CARDS
========================================================= */
#vlanManagementApp .nx-summary-card {
    position: relative;
    min-height: 142px;
    border-radius:3px;
    background: linear-gradient(180deg, #ffffff 0%, #fbfdff 100%);
    border: 1px solid rgba(226, 232, 240, 0.9);
    box-shadow: var(--subs-shadow-soft);
    overflow: hidden;
    padding: 22px 28px;
}

#vlanManagementApp .nx-summary-card::before {
    content: "";
    position: absolute;
    inset: 0 auto 0 0;
    width: 5px;
    border-radius:3px;
}

#vlanManagementApp .nx-summary-primary::before {
    background: linear-gradient(180deg, #3b82f6 0%, #1d4ed8 100%);
}

#vlanManagementApp .nx-summary-success::before {
    background: linear-gradient(180deg, #22c55e 0%, #15803d 100%);
}

#vlanManagementApp .nx-summary-danger::before {
    background: linear-gradient(180deg, #ef4444 0%, #dc2626 100%);
}

#vlanManagementApp .nx-summary-cyan::before {
    background: linear-gradient(180deg, #06b6d4 0%, #0891b2 100%);
}

#vlanManagementApp .nx-summary-slate::before {
    background: linear-gradient(180deg, #64748b 0%, #475569 100%);
}

#vlanManagementApp .nx-summary-top {
    position: relative;
    z-index: 1;
    display: flex;
    justify-content: space-between;
    gap: 16px;
}

#vlanManagementApp .nx-summary-label {
    font-size: 12px;
    font-weight: 700;
    color: #64748b;
    margin-bottom: 8px;
    letter-spacing: 0.02em;
}

#vlanManagementApp .nx-summary-value {
    font-size: 20px;
    font-weight: 800;
    color: #0f172a;
    line-height: 1.1;
    margin-bottom: 8px;
}

#vlanManagementApp .nx-summary-text {
    font-size: 13px;
    color: #6b7280;
    line-height: 1.45;
    max-width: 240px;
}

#vlanManagementApp .nx-summary-icon {
    width: 38px;
    height: 38px;
    border-radius:3px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: #eff6ff;
    color: #2563eb;
    font-size: 15px;
    flex: 0 0 auto;
    margin-top: 2px;
}

/* =========================================================
   TOOLBAR
========================================================= */
#vlanManagementApp .nx-toolbar-card {
    border: 1px solid rgba(226, 232, 240, 0.9);
    background: linear-gradient(180deg, #ffffff 0%, #fbfdff 100%);
    box-shadow: var(--subs-shadow-soft);
}

#vlanManagementApp .nx-toolbar-card .card-body {
    padding: 20px 22px;
}

#vlanManagementApp .vlan-toolbar-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(320px, 0.9fr) minmax(220px, auto);
    gap: 12px;
    align-items: center;
}

#vlanManagementApp .vlan-toolbar-left {
    min-width: 0;
}

#vlanManagementApp .nx-segment-control {
    display: inline-flex;
    gap: 6px;
    flex-wrap: wrap;
    padding: 5px;
    border-radius:3px;
    background: #eff6ff;
    border: 1px solid #dbeafe;
}

#vlanManagementApp .nx-segment-item {
    appearance: none;
    border: 0;
    background: transparent;
    color: #475569;
    font-size: 13px;
    font-weight: 800;
    letter-spacing: 0.02em;
    padding: 10px 16px;
    border-radius:3px;
    transition: all 0.2s ease;
    white-space: nowrap;
}

#vlanManagementApp .nx-segment-item:hover {
    color: #1d4ed8;
    background: rgba(255, 255, 255, 0.85);
}

#vlanManagementApp .nx-segment-item.active {
    color: #fff;
    background: linear-gradient(135deg, #3b82f6 0%, #2563eb 100%);
    box-shadow: 0 8px 18px rgba(37, 99, 235, 0.18);
}

#vlanManagementApp .vlan-search-wrap {
    position: relative;
    min-width: 0;
}

#vlanManagementApp .vlan-search-icon {
    position: absolute;
    top: 50%;
    left: 14px;
    transform: translateY(-50%);
    font-size: 14px;
    color: #94a3b8;
    pointer-events: none;
}

#vlanManagementApp .vlan-toolbar-control,
#vlanManagementApp #vlanManagementSearch {
    height: 42px;
    min-height: 42px;
    border-radius:3px;
    border-color: #dbe3ef;
    font-size: 14px;
    box-shadow: none;
}

#vlanManagementApp .vlan-search-control {
    padding-left: 40px;
}

#vlanManagementApp #vlanManagementSearch:focus,
#vlanManagementApp .form-control:focus,
#vlanManagementApp .form-select:focus,
#vlanManagementApp textarea.form-control:focus {
    border-color: #93c5fd;
    box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.10);
}

#vlanManagementApp .vlan-toolbar-meta {
    text-align: right;
}

#vlanManagementApp .vlan-toolbar-note {
    font-size: 13px;
    line-height: 1.45;
    color: #64748b;
}

/* =========================================================
   CONTENT CARD
========================================================= */
#vlanManagementApp .nx-content-card {
    position: relative;
    border: 1px solid rgba(226, 232, 240, 0.9);
    background: linear-gradient(180deg, #ffffff 0%, #fbfdff 100%);
    box-shadow: var(--subs-shadow-lg);
    margin-bottom: 16px;
}

#vlanManagementApp .subs-table-topline {
    height: 4px;
    background: linear-gradient(90deg, #3b82f6 0%, #2563eb 25%, rgba(37,99,235,0.10) 100%);
}

#vlanManagementApp .nx-content-card .card-body {
    padding: 10px 18px 14px;
}

#vlanManagementApp .nx-content-card .card-body.border-bottom {
    padding: 18px 18px 14px;
    background: transparent;
    border-bottom: 1px solid #e2e8f0 !important;
}

/* =========================================================
   TABLE
========================================================= */
#vlanManagementApp .nx-table-wrap {
    overflow-x: auto;
    overflow-y: hidden;
}

#vlanManagementApp table {
    width: 100%;
    table-layout: fixed;
}

#vlanManagementApp .table {
    margin-bottom: 0;
}

#vlanManagementApp .table th,
#vlanManagementApp .table td {
    vertical-align: middle;
}

#vlanManagementApp .table thead th {
    white-space: nowrap;
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 0.10em;
    text-transform: uppercase;
    color: #475569;
    border-bottom-color: #e2e8f0;
    padding-top: 18px;
    padding-bottom: 14px;
    background: #f8fafc;
}

#vlanManagementApp .table tbody td {
    padding-top: 16px;
    padding-bottom: 16px;
    border-bottom-color: #edf2f7;
}

#vlanManagementApp .table td:last-child,
#vlanManagementApp .table th:last-child {
    text-align: right;
    white-space: nowrap;
}

#vlanManagementApp .table tbody tr:hover td {
    background: rgba(37, 99, 235, 0.02);
}

#vlanManagementApp #cVlanTable th:nth-child(1),
#vlanManagementApp #cVlanTable td:nth-child(1),
#vlanManagementApp #sVlanTable th:nth-child(1),
#vlanManagementApp #sVlanTable td:nth-child(1) {
    width: 18%;
}

#vlanManagementApp #cVlanTable th:nth-child(2),
#vlanManagementApp #cVlanTable td:nth-child(2),
#vlanManagementApp #sVlanTable th:nth-child(2),
#vlanManagementApp #sVlanTable td:nth-child(2) {
    width: 14%;
}

#vlanManagementApp #cVlanTable th:nth-child(3),
#vlanManagementApp #cVlanTable td:nth-child(3),
#vlanManagementApp #sVlanTable th:nth-child(3),
#vlanManagementApp #sVlanTable td:nth-child(3) {
    width: 20%;
}

#vlanManagementApp #cVlanTable th:nth-child(4),
#vlanManagementApp #cVlanTable td:nth-child(4),
#vlanManagementApp #sVlanTable th:nth-child(4),
#vlanManagementApp #sVlanTable td:nth-child(4) {
    width: 24%;
}

#vlanManagementApp #cVlanTable th:nth-child(5),
#vlanManagementApp #cVlanTable td:nth-child(5),
#vlanManagementApp #sVlanTable th:nth-child(5),
#vlanManagementApp #sVlanTable td:nth-child(5) {
    width: 14%;
}

#vlanManagementApp #cVlanTable th:nth-child(6),
#vlanManagementApp #cVlanTable td:nth-child(6),
#vlanManagementApp #sVlanTable th:nth-child(6),
#vlanManagementApp #sVlanTable td:nth-child(6) {
    width: 20%;
    min-width: 210px;
}

/* =========================================================
   CELL STYLES
========================================================= */
#vlanManagementApp .nx-cell-stack {
    display: flex;
    flex-direction: column;
    gap: 3px;
    min-width: 0;
}

#vlanManagementApp .nx-cell-title {
    font-size: 14px;
    font-weight: 700;
    color: #0f172a;
    line-height: 1.2;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

#vlanManagementApp .nx-cell-sub {
    font-size: 12px;
    color: #64748b;
    line-height: 1.25;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

#vlanManagementApp .nx-text-mono {
    white-space: nowrap;
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, "Liberation Mono", monospace;
}

/* =========================================================
   ACTION BUTTONS
========================================================= */
#vlanManagementApp .nx-vlan-actions {
    display: inline-flex;
    align-items: center;
    justify-content: flex-end;
    gap: 6px;
    flex-wrap: nowrap;
    white-space: nowrap;
    min-width: 168px;
}

#vlanManagementApp .nx-icon-btn {
    width: 36px;
    height: 36px;
    min-width: 36px;
    min-height: 36px;
    padding: 0;
    border-radius:3px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    line-height: 1;
    box-shadow: none;
}

#vlanManagementApp .nx-icon-btn i {
    font-size: 13px;
    line-height: 1;
    display: inline-flex;
    align-items: center;
    justify-content: center;
}

#vlanManagementApp .btn-outline-secondary.nx-icon-btn {
    border-color: #d9e1ec;
    color: #64748b;
    background: #fff;
}

#vlanManagementApp .btn-outline-secondary.nx-icon-btn:hover {
    background: #f8fafc;
    border-color: #cbd5e1;
    color: #334155;
}

#vlanManagementApp .btn-outline-primary.nx-icon-btn {
    border-color: #bfdbfe;
    color: #2563eb;
    background: #fff;
}

#vlanManagementApp .btn-outline-primary.nx-icon-btn:hover {
    background: #eff6ff;
    border-color: #93c5fd;
    color: #1d4ed8;
}

#vlanManagementApp .btn-outline-success.nx-icon-btn {
    border-color: #bbf7d0;
    color: #16a34a;
    background: #fff;
}

#vlanManagementApp .btn-outline-success.nx-icon-btn:hover {
    background: #f0fdf4;
    border-color: #86efac;
    color: #15803d;
}

#vlanManagementApp .btn-outline-danger.nx-icon-btn {
    border-color: #fecaca;
    color: #ef4444;
    background: #fff;
}

#vlanManagementApp .btn-outline-danger.nx-icon-btn:hover {
    background: #fef2f2;
    border-color: #fca5a5;
    color: #dc2626;
}

/* =========================================================
   BADGES
========================================================= */
#vlanManagementApp .nx-soft-badge,
#vlanManagementApp .nx-soft-badge-success,
#vlanManagementApp .nx-soft-badge-danger,
#vlanManagementApp .nx-soft-badge-warning,
#vlanManagementApp .nx-soft-badge-info {
    font-size: 11px;
    padding: 5px 10px;
    border-radius:3px;
    font-weight: 800;
    letter-spacing: 0.02em;
    min-width: 96px;
    justify-content: center;
    display: inline-flex;
    align-items: center;
}

#vlanManagementApp .nx-soft-badge-success {
    background: #e8f8ef;
    color: #15803d;
}

#vlanManagementApp .nx-soft-badge-danger {
    background: #fef2f2;
    color: #dc2626;
}

#vlanManagementApp .nx-soft-badge-warning {
    background: #fffbeb;
    color: #b45309;
}

#vlanManagementApp .nx-soft-badge-info {
    background: #ecfeff;
    color: #0891b2;
}

/* =========================================================
   EMPTY STATE
========================================================= */
#vlanManagementApp .nx-empty-state {
    padding: 36px 20px;
    text-align: center;
}

#vlanManagementApp .nx-empty-icon {
    width: 64px;
    height: 64px;
    margin: 0 auto 14px;
    border-radius:3px;
    background: #eff6ff;
    color: #2563eb;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 24px;
}

#vlanManagementApp .nx-empty-title {
    font-size: 18px;
    font-weight: 800;
    color: #0f172a;
    margin-bottom: 6px;
}

#vlanManagementApp .nx-empty-text {
    font-size: 14px;
    color: #64748b;
    line-height: 1.55;
    margin-bottom: 0;
}

/* =========================================================
   FORMS / SWEETALERT
========================================================= */
#vlanManagementApp .form-control,
#vlanManagementApp .form-select,
#vlanManagementApp textarea.form-control {
    border-radius:3px;
    border-color: #dbe3ef;
    font-size: 14px;
    box-shadow: none;
    min-height: 42px;
}

#vlanManagementApp textarea.form-control {
    min-height: 110px;
}

#vlanManagementApp .swal2-html-container .form-label {
    display: block;
    font-size: 12px;
    font-weight: 600;
    color: #6b7280;
    margin-bottom: 6px;
    text-transform: uppercase;
    letter-spacing: .04em;
}

#vlanManagementApp .swal2-html-container .form-text {
    font-size: 12px;
    color: #64748b;
    line-height: 1.45;
}

#vlanManagementApp .swal2-html-container .text-start {
    text-align: left !important;
}

/* =========================================================
   SWEETALERT
========================================================= */
.swal2-popup.nx-toast-popup {
    border-radius:3px !important;
    box-shadow: 0 16px 36px rgba(15, 23, 42, .16) !important;
}

/* =========================================================
   RESPONSIVE
========================================================= */
@media (max-width: 1199px) {
    #vlanManagementApp table {
        table-layout: auto;
        min-width: 980px;
    }

    #vlanManagementApp .vlan-toolbar-grid {
        grid-template-columns: 1fr;
    }

    #vlanManagementApp .vlan-toolbar-meta {
        text-align: left;
    }
}

@media (max-width: 992px) {
    #vlanManagementApp .vlan-hero-body {
        flex-direction: column;
        align-items: flex-start;
    }

    #vlanManagementApp .vlan-hero-actions {
        width: 100%;
    }
}

@media (max-width: 767px) {
    #vlanManagementApp .nx-summary-card {
        min-height: 128px;
        padding: 20px 22px;
    }

    #vlanManagementApp .nx-content-card .card-body,
    #vlanManagementApp .nx-toolbar-card .card-body {
        padding-left: 14px;
        padding-right: 14px;
    }

    #vlanManagementApp .nx-segment-control {
        width: 100%;
        border-radius:3px;
    }

    #vlanManagementApp .nx-segment-item {
        flex: 1 1 calc(50% - 6px);
        text-align: center;
    }
}
/* =========================================================
   VLAN MANAGEMENT DARK MODE
   Place at VERY BOTTOM
========================================================= */

html[data-theme="dark"] #vlanManagementApp {
    --subs-blue: #60a5fa;
    --subs-blue-dark: #3b82f6;
    --subs-ink: #f8fafc;
    --subs-muted: #9aabc1;
    --subs-line: #2b3d56;
    --subs-surface: #182235;
    --subs-surface-soft: #101827;
    --subs-shadow-soft: 0 12px 26px rgba(0,0,0,.28);
    --subs-shadow-lg: 0 18px 36px rgba(0,0,0,.34);
}

/* Cards / surfaces */
html[data-theme="dark"] #vlanManagementApp .nx-page-header-card,
html[data-theme="dark"] #vlanManagementApp .nx-toolbar-card,
html[data-theme="dark"] #vlanManagementApp .nx-content-card,
html[data-theme="dark"] #vlanManagementApp .nx-summary-card {
    background:
            radial-gradient(circle at top right, rgba(59,130,246,.10), transparent 30%),
            linear-gradient(180deg, #182235 0%, #141f31 100%) !important;
    border-color: rgba(255,255,255,.06) !important;
    box-shadow: var(--subs-shadow-soft) !important;
}

/* Prevent decorative full-width accent rails; hierarchy comes from spacing and headings. */
#vlanManagementApp .subs-table-topline {
    display: none !important;
    height: 0 !important;
    background: none !important;
    border: 0 !important;
    box-shadow: none !important;
}

/* Text */
html[data-theme="dark"] #vlanManagementApp .vlan-hero-title,
html[data-theme="dark"] #vlanManagementApp .nx-summary-value,
html[data-theme="dark"] #vlanManagementApp .nx-cell-title,
html[data-theme="dark"] #vlanManagementApp .nx-empty-title {
    color: var(--subs-ink) !important;
}

html[data-theme="dark"] #vlanManagementApp .vlan-hero-text,
html[data-theme="dark"] #vlanManagementApp .nx-summary-label,
html[data-theme="dark"] #vlanManagementApp .nx-summary-text,
html[data-theme="dark"] #vlanManagementApp .vlan-toolbar-note,
html[data-theme="dark"] #vlanManagementApp .nx-cell-sub,
html[data-theme="dark"] #vlanManagementApp .nx-empty-text {
    color: var(--subs-muted) !important;
}

/* Hero badge */
html[data-theme="dark"] #vlanManagementApp .vlan-hero-badge {
    background: rgba(59,130,246,.16) !important;
    color: #93c5fd !important;
    border: 1px solid rgba(147,197,253,.18) !important;
}

/* Segment tabs */
html[data-theme="dark"] #vlanManagementApp .nx-segment-control {
    background: #101827 !important;
    border-color: #334155 !important;
}

html[data-theme="dark"] #vlanManagementApp .nx-segment-item {
    color: #9aabc1 !important;
}

html[data-theme="dark"] #vlanManagementApp .nx-segment-item:hover {
    background: #182235 !important;
    color: #f8fafc !important;
}

html[data-theme="dark"] #vlanManagementApp .nx-segment-item.active {
    color: #ffffff !important;
}

/* Forms */
html[data-theme="dark"] #vlanManagementApp .form-control,
html[data-theme="dark"] #vlanManagementApp .form-select,
html[data-theme="dark"] #vlanManagementApp textarea.form-control,
html[data-theme="dark"] #vlanManagementApp #vlanManagementSearch {
    background: #101827 !important;
    border-color: #334155 !important;
    color: #f8fafc !important;
}

html[data-theme="dark"] #vlanManagementApp .form-control::placeholder,
html[data-theme="dark"] #vlanManagementApp #vlanManagementSearch::placeholder {
    color: #64748b !important;
}

html[data-theme="dark"] #vlanManagementApp .vlan-search-icon {
    color: #64748b !important;
}

/* Card headers */
html[data-theme="dark"] #vlanManagementApp .nx-content-card .card-body.border-bottom {
    border-bottom-color: #2b3d56 !important;
}

/* Tables */
html[data-theme="dark"] #vlanManagementApp .nx-table-wrap,
html[data-theme="dark"] #vlanManagementApp table,
html[data-theme="dark"] #vlanManagementApp .table {
    background: #141f31 !important;
