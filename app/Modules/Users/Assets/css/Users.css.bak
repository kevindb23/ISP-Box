/* Module override layer: shared shell, panels, tables, controls, and theme
   tokens are defined in public/assets/css/nx.css. Keep this file scoped to
   users-specific layout and visual exceptions only. */
#usersPage {
    --users-blue: #2563eb;
    --users-ink: #0f172a;
    --users-muted: #64748b;
    --users-line: #e2e8f0;
    --users-shadow: 0 12px 28px rgba(15, 23, 42, 0.05);
}

#usersPage .nx-page-header-card,
#usersPage .nx-toolbar-card,
#usersPage .nx-content-card {
    border-radius: var(--nx-panel-radius);
    overflow: hidden;
    border: 1px solid var(--nx-panel-border-light);
    background: var(--nx-panel-surface-light);
    box-shadow: none;
}

#usersPage .nx-page-header {
    min-height: 124px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    padding: 24px 28px;
}

#usersPage .users-hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 7px 12px;
    border-radius:3px;
    background: rgba(37, 99, 235, 0.08);
    color: #1d4ed8;
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    margin-bottom: 14px;
}

#usersPage .nx-page-title {
    margin: 0 0 6px;
    font-size: 18px;
    font-weight: 800;
    color: var(--users-ink);
}

#usersPage .nx-page-subtitle {
    font-size: 14px;
    color: var(--users-muted);
}

#usersPage .nx-page-actions {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-wrap: wrap;
}

#usersPage .nx-header-btn {
    height: 40px;
    padding: 0 16px;
    border-radius:3px;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 14px;
    font-weight: 700;
}

#usersPage .users-toolbar-grid {
    display: grid;
    grid-template-columns: minmax(280px, 420px) minmax(0, 1fr);
    gap: 14px;
    align-items: center;
}

#usersPage .users-search-wrap {
    position: relative;
    width: 100%;
}

#usersPage .users-search-icon {
    position: absolute;
    top: 50%;
    left: 14px;
    transform: translateY(-50%);
    color: #94a3b8;
    pointer-events: none;
}

#usersPage .users-toolbar-control {
    height: 42px;
    border-radius:3px;
    border-color: #dbe3ef;
    font-size: 14px;
    box-shadow: none;
}

#usersPage .users-search-control {
    padding-left: 40px;
}

#usersPage .users-toolbar-meta {
    display: flex;
    justify-content: flex-end;
}

#usersPage .users-toolbar-note {
    font-size: 13px;
    color: var(--users-muted);
}

#usersPage .users-summary-card {
    position: relative;
    min-height: 118px;
    border-radius:3px;
    background: #fff;
    border: 1px solid var(--users-line);
    box-shadow: var(--users-shadow);
    padding: 22px 24px;
    overflow: hidden;
}

#usersPage .users-summary-card::before {
    content: "";
    position: absolute;
    inset: 0 auto 0 0;
    width: 5px;
}

#usersPage .users-summary-primary::before {
    background: #2563eb;
}

#usersPage .users-summary-success::before {
    background: #16a34a;
}

#usersPage .users-summary-danger::before {
    background: #dc2626;
}

#usersPage .users-summary-info::before {
    background: #0891b2;
}

#usersPage .users-summary-label {
    font-size: 12px;
    font-weight: 800;
    color: #64748b;
    margin-bottom: 10px;
}

#usersPage .users-summary-value {
    font-size: 26px;
    font-weight: 900;
    color: #0f172a;
}

#usersPage .nx-content-card .card-body {
    padding: 0;
}

#usersPage .table thead th {
    white-space: nowrap;
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 0.10em;
    text-transform: uppercase;
    color: #475569;
    border-bottom-color: #e2e8f0;
    padding: 18px 16px 14px;
    background: #f8fafc;
}

#usersPage .table tbody td {
    padding: 16px;
    border-bottom-color: #edf2f7;
    vertical-align: middle;
}

#usersPage .users-main-cell {
    display: flex;
    align-items: center;
    gap: 12px;
}

#usersPage .users-avatar {
    width: 38px;
    height: 38px;
    border-radius:3px;
    background: #eff6ff;
    color: #2563eb;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-weight: 900;
}

#usersPage .nx-icon-btn {
    width: 36px;
    height: 36px;
    border-radius:3px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
}

#usersPage .nx-modal-content {
    border: 0;
    border-radius:3px;
    box-shadow: 0 20px 50px rgba(15, 23, 42, 0.18);
    overflow: hidden;
}

#usersPage .nx-modal-header {
    padding: 18px 22px;
    border-bottom: 1px solid #eef2f7;
}

#usersPage .nx-modal-body {
    background: #f8fafc;
    padding: 20px;
}

#usersPage .nx-modal-footer {
    padding: 16px 22px;
    border-top: 1px solid #eef2f7;
}

@media (max-width: 992px) {
    #usersPage .nx-page-header {
        flex-direction: column;
        align-items: flex-start;
    }

    #usersPage .users-toolbar-grid {
        grid-template-columns: 1fr;
    }

    #usersPage .users-toolbar-meta {
        justify-content: flex-start;
    }
}
/* =========================================================
   USERS DARK MODE
========================================================= */

html[data-theme="dark"] #usersPage {
    --users-ink: #f8fafc;
    --users-muted: #9ca3af;
    --users-line: #334155;
}

/* Cards */
html[data-theme="dark"] #usersPage .nx-page-header-card,
html[data-theme="dark"] #usersPage .nx-toolbar-card,
html[data-theme="dark"] #usersPage .nx-content-card,
html[data-theme="dark"] #usersPage .users-summary-card {
    background: var(--nx-panel-surface-dark) !important;
    border-color: var(--nx-panel-border-dark) !important;
    color: var(--nx-text) !important;
}

html[data-theme="dark"] #usersPage .card-header,
html[data-theme="dark"] #usersPage .card-footer {
    background: var(--nx-panel-surface-dark) !important;
    border-color: var(--nx-panel-border-dark) !important;
    color: var(--nx-text) !important;
}

html[data-theme="dark"] #usersPage .card-body {
    background: transparent;
    color: #dbe4f0;
}

/* Header */
html[data-theme="dark"] #usersPage .nx-page-title,
html[data-theme="dark"] #usersPage .users-summary-value {
    color: #ffffff !important;
}

html[data-theme="dark"] #usersPage .nx-page-subtitle,
html[data-theme="dark"] #usersPage .users-summary-label,
html[data-theme="dark"] #usersPage .users-toolbar-note {
    color: #9ca3af !important;
}

html[data-theme="dark"] #usersPage .users-hero-badge {
    background: rgba(59,130,246,.15);
    color: #93c5fd;
}

/* Toolbar */
html[data-theme="dark"] #usersPage .form-control,
html[data-theme="dark"] #usersPage .form-select,
html[data-theme="dark"] #usersPage .users-toolbar-control {
    background: var(--nx-control-surface-dark) !important;
    border-color: var(--nx-control-border-dark) !important;
    color: var(--nx-text) !important;
}

html[data-theme="dark"] #usersPage .form-control::placeholder {
    color: #64748b;
}

html[data-theme="dark"] #usersPage .users-search-icon {
    color: #64748b;
}

/* Tables */
html[data-theme="dark"] #usersPage .table {
    color: #dbe4f0;
}

html[data-theme="dark"] #usersPage .table thead th {
    background: var(--nx-table-head-surface-dark) !important;
    color: var(--nx-text-muted) !important;
    border-color: var(--nx-table-border-dark) !important;
}

html[data-theme="dark"] #usersPage .table tbody td {
    background: var(--nx-table-row-surface-dark) !important;
    color: var(--nx-text-soft) !important;
    border-color: var(--nx-table-border-dark) !important;
}

html[data-theme="dark"] #usersPage .table tbody tr:hover td {
    background: #22324b !important;
}

html[data-theme="dark"] #usersPage .table > :not(caption) > * > * {
    background-color: transparent !important;
    box-shadow: none !important;
}

/* Avatar */
html[data-theme="dark"] #usersPage .users-avatar {
    background: rgba(37,99,235,.18);
    color: #93c5fd;
}

/* Buttons */
html[data-theme="dark"] #usersPage .btn-light,
html[data-theme="dark"] #usersPage .btn-outline-secondary {
    background: #182235 !important;
    border-color: #334155 !important;
    color: #f8fafc !important;
}

html[data-theme="dark"] #usersPage .btn-light:hover,
html[data-theme="dark"] #usersPage .btn-outline-secondary:hover {
    background: #22324b !important;
    border-color: #475569 !important;
}

html[data-theme="dark"] #usersPage .btn-outline-primary {
    border-color: #3b82f6;
    color: #93c5fd;
}

html[data-theme="dark"] #usersPage .btn-outline-primary:hover {
    background: rgba(59,130,246,.15);
}

/* Modal */
html[data-theme="dark"] #usersPage .nx-modal-content,
html[data-theme="dark"] #usersPage .modal-content {
    background: #182235 !important;
    border: 1px solid #2b3d56 !important;
}

html[data-theme="dark"] #usersPage .nx-modal-header,
html[data-theme="dark"] #usersPage .modal-header {
    background: #141f31 !important;
    border-color: #2b3d56 !important;
    color: #f8fafc !important;
}

html[data-theme="dark"] #usersPage .nx-modal-body,
html[data-theme="dark"] #usersPage .modal-body {
    background: #0b1220 !important;
    color: #dbe4f0 !important;
}

html[data-theme="dark"] #usersPage .nx-modal-footer,
html[data-theme="dark"] #usersPage .modal-footer {
    background: #141f31 !important;
    border-color: #2b3d56 !important;
}

/* Inputs inside modal */
html[data-theme="dark"] #usersPage input,
html[data-theme="dark"] #usersPage select,
html[data-theme="dark"] #usersPage textarea {
    background: #101827 !important;
    border-color: #334155 !important;
    color: #f8fafc !important;
}

html[data-theme="dark"] #usersPage input[readonly] {
    background: #141f31 !important;
    color: #f8fafc !important;
}

/* Text */
html[data-theme="dark"] #usersPage h1,
html[data-theme="dark"] #usersPage h2,
html[data-theme="dark"] #usersPage h3,
html[data-theme="dark"] #usersPage h4,
html[data-theme="dark"] #usersPage h5,
html[data-theme="dark"] #usersPage h6,
html[data-theme="dark"] #usersPage strong {
    color: #ffffff !important;
}

html[data-theme="dark"] #usersPage .text-muted,
html[data-theme="dark"] #usersPage small {
    color: #9ca3af !important;
}

/* Users-specific layer ends here. Shared surfaces and controls stay in nx.css. */
html[data-theme="dark"] #usersPage .users-card,
html[data-theme="dark"] #usersPage .users-panel,
html[data-theme="dark"] #usersPage .nx-content-card,
html[data-theme="dark"] #usersPage .nx-toolbar-card {
    background: var(--nx-panel-surface-dark) !important;
    border-color: var(--nx-panel-border-dark) !important;
    box-shadow: none !important;
}

html[data-theme="dark"] #usersPage input,
html[data-theme="dark"] #usersPage select,
html[data-theme="dark"] #usersPage textarea {
    background: var(--nx-control-surface-dark) !important;
    border-color: var(--nx-control-border-dark) !important;
    color: var(--nx-text) !important;
}
