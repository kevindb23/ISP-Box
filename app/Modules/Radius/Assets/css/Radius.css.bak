/* Module override layer: shared shell, panels, tables, controls, and theme
   tokens are defined in public/assets/css/nx.css. Keep this file scoped to
   radius-specific layout and visual exceptions only. */
#radiusPage {
    --subs-blue: #2563eb;
    --subs-blue-dark: #1d4ed8;
    --subs-ink: #0f172a;
    --subs-muted: #64748b;
    --subs-line: #e2e8f0;
    --subs-surface: #ffffff;
    --subs-surface-soft: #f8fafc;
    --subs-shadow-soft: 0 12px 28px rgba(15, 23, 42, 0.05);
    --subs-shadow-lg: 0 20px 40px rgba(15, 23, 42, 0.08);
}

/* =========================================================
   HERO / HEADER
========================================================= */
#radiusPage .nx-page-header-card,
#radiusPage .nx-toolbar-card,
#radiusPage .nx-content-card {
    border-radius:3px;
    overflow: hidden;
}

#radiusPage .nx-page-header-card {
    border: 1px solid rgba(37, 99, 235, 0.08);
    background:
            radial-gradient(circle at top right, rgba(37, 99, 235, 0.10), transparent 28%),
            linear-gradient(180deg, rgba(255,255,255,1) 0%, rgba(248,250,252,0.94) 100%);
    box-shadow: var(--subs-shadow-lg);
}

#radiusPage .radius-hero-body {
    min-height: 0 !important;
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 24px;
    padding: 12px 0 10px !important;
}

html body#nxApplication .main-content #radiusPage > .nx-page-header-card > .radius-hero-body {
    min-height: 79px !important;
    align-items: flex-start !important;
    /* padding: 12px 0 10px !important; */
}

html body#nxApplication .main-content #radiusPage > .nx-page-header-card > .card-body.radius-hero-body {
    min-height: 79px !important;
    height: 79px !important;
}

#radiusPage .radius-hero-left {
    max-width: 820px;
}

#radiusPage .radius-hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 7px 12px;
    border-radius:3px;
    background: rgba(37, 99, 235, 0.08);
    color: var(--subs-blue-dark);
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    margin-bottom: 14px;
}

/* Keep the title row compact like the VLAN page. The eyebrow is decorative
   and must not reserve vertical space above the heading. */
#radiusPage .radius-hero-badge {
    display: none;
    margin: 0;
    padding: 0;
}

#radiusPage .radius-hero-badge i {
    font-size: 11px;
    line-height: 1;
}

#radiusPage .radius-hero-title {
    margin: 0 0 6px;
    font-size: 18px;
    font-weight: 800;
    color: var(--subs-ink);
    line-height: 1.2;
}

#radiusPage .radius-hero-text {
    margin: 0;
    font-size: 14px;
    color: var(--subs-muted);
    line-height: 1.55;
}

#radiusPage .radius-hero-actions {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-wrap: wrap;
}

#radiusPage .radius-hero-actions .btn {
    height: 40px;
    min-height: 40px;
    padding: 0 16px;
    border-radius:3px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    font-size: 14px;
    font-weight: 700;
    line-height: 1;
    vertical-align: middle;
    box-shadow: none;
}

#radiusPage .radius-hero-actions .btn-primary {
    background: linear-gradient(135deg, #3b82f6 0%, #2563eb 100%);
    border-color: #2563eb;
}

#radiusPage .radius-hero-actions .btn-primary:hover,
#radiusPage .radius-hero-actions .btn-primary:focus {
    background: linear-gradient(135deg, #2563eb 0%, #1d4ed8 100%);
    border-color: #1d4ed8;
}

#radiusPage .radius-hero-actions .btn-light {
    background: #fff;
    border-color: #dbe3ef;
    color: #0f172a;
}

#radiusPage .radius-hero-actions .btn-light:hover,
#radiusPage .radius-hero-actions .btn-light:focus {
    background: #f8fafc;
    border-color: #cbd5e1;
    color: #0f172a;
}

/* =========================================================
   SUMMARY CARDS
========================================================= */
#radiusPage .nx-summary-card {
    position: relative;
    min-height: 142px;
    border-radius:3px;
    background: linear-gradient(180deg, #ffffff 0%, #fbfdff 100%);
    border: 1px solid rgba(226, 232, 240, 0.9);
    box-shadow: var(--subs-shadow-soft);
    overflow: hidden;
    padding: 22px 28px;
}

#radiusPage .nx-summary-card::before {
    content: "";
    position: absolute;
    inset: 0 auto 0 0;
    width: 5px;
    border-radius:3px;
}

#radiusPage .nx-summary-primary::before {
    background: linear-gradient(180deg, #3b82f6 0%, #1d4ed8 100%);
}

#radiusPage .nx-summary-success::before {
    background: linear-gradient(180deg, #22c55e 0%, #15803d 100%);
}

#radiusPage .nx-summary-danger::before {
    background: linear-gradient(180deg, #ef4444 0%, #dc2626 100%);
}

#radiusPage .nx-summary-cyan::before {
    background: linear-gradient(180deg, #06b6d4 0%, #0891b2 100%);
}

#radiusPage .nx-summary-slate::before {
    background: linear-gradient(180deg, #64748b 0%, #475569 100%);
}

#radiusPage .nx-summary-top {
    position: relative;
    z-index: 1;
    display: flex;
    justify-content: space-between;
    gap: 16px;
}

#radiusPage .nx-summary-label {
    font-size: 12px;
    font-weight: 700;
    color: #64748b;
    margin-bottom: 8px;
    letter-spacing: 0.02em;
}

#radiusPage .nx-summary-value {
    font-size: 20px;
    font-weight: 800;
    color: #0f172a;
    line-height: 1.1;
    margin-bottom: 8px;
}

#radiusPage .nx-summary-text {
    font-size: 13px;
    color: #6b7280;
    line-height: 1.45;
    max-width: 240px;
}

#radiusPage .nx-summary-icon {
    width: 38px;
    height: 38px;
    border-radius:3px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: #eff6ff;
    color: #2563eb;
    font-size: 15px;
    flex: 0 0 auto;
    margin-top: 2px;
}

/* =========================================================
   TOOLBAR
========================================================= */
#radiusPage .nx-toolbar-card {
    border: 1px solid rgba(226, 232, 240, 0.9);
    background: linear-gradient(180deg, #ffffff 0%, #fbfdff 100%);
    box-shadow: var(--subs-shadow-soft);
}

#radiusPage .nx-toolbar-card .card-body {
    padding: 20px 22px;
}

#radiusPage .radius-toolbar-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(320px, 0.9fr) minmax(220px, auto);
    gap: 12px;
    align-items: center;
}

#radiusPage .radius-toolbar-left {
    min-width: 0;
}

#radiusPage .nx-segment-control {
    display: inline-flex;
    gap: 6px;
    flex-wrap: wrap;
    padding: 5px;
    border-radius:3px;
    background: #eff6ff;
    border: 1px solid #dbeafe;
}

#radiusPage .nx-segment-item {
    appearance: none;
    border: 0;
    background: transparent;
    color: #475569;
    font-size: 13px;
    font-weight: 800;
    letter-spacing: 0.02em;
    padding: 10px 16px;
    border-radius:3px;
    transition: all 0.2s ease;
    white-space: nowrap;
}

#radiusPage .nx-segment-item:hover {
    color: #1d4ed8;
    background: rgba(255, 255, 255, 0.85);
}

#radiusPage .nx-segment-item.active {
    color: #fff;
    background: linear-gradient(135deg, #3b82f6 0%, #2563eb 100%);
    box-shadow: 0 8px 18px rgba(37, 99, 235, 0.18);
}

#radiusPage .radius-search-wrap {
    position: relative;
    min-width: 0;
}

#radiusPage .radius-search-icon {
    position: absolute;
    top: 50%;
    left: 14px;
    transform: translateY(-50%);
    font-size: 14px;
    color: #94a3b8;
    pointer-events: none;
}

#radiusPage .radius-toolbar-control,
#radiusPage #radiusServerSearch {
    height: 42px;
    min-height: 42px;
    border-radius:3px;
    border-color: #dbe3ef;
    font-size: 14px;
    box-shadow: none;
}

#radiusPage .radius-search-control {
    padding-left: 40px;
}

#radiusPage #radiusServerSearch:focus,
#radiusPage .form-control:focus,
#radiusPage .form-select:focus,
#radiusPage textarea.form-control:focus {
    border-color: #93c5fd;
    box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.10);
}

#radiusPage .radius-toolbar-meta {
    text-align: right;
}

#radiusPage .radius-toolbar-note {
    font-size: 13px;
    line-height: 1.45;
    color: #64748b;
}

/* =========================================================
   CONTENT CARD
========================================================= */
#radiusPage .nx-content-card {
    position: relative;
    border: 1px solid rgba(226, 232, 240, 0.9);
    background: linear-gradient(180deg, #ffffff 0%, #fbfdff 100%);
    box-shadow: var(--subs-shadow-lg);
    margin-bottom: 16px;
}

#radiusPage .subs-table-topline {
    height: 4px;
    background: linear-gradient(90deg, #3b82f6 0%, #2563eb 25%, rgba(37,99,235,0.10) 100%);
}

#radiusPage .nx-content-card .card-body {
    padding: 10px 18px 14px;
}

#radiusPage .nx-content-card .card-body.border-bottom {
    padding: 18px 18px 14px;
    background: transparent;
    border-bottom: 1px solid #e2e8f0 !important;
}

/* =========================================================
   TABLE
========================================================= */
#radiusPage .nx-table-wrap {
    overflow-x: auto;
    overflow-y: hidden;
}

#radiusPage table {
    width: 100%;
    table-layout: fixed;
}

#radiusPage .table {
    margin-bottom: 0;
}

#radiusPage .table th,
#radiusPage .table td {
    vertical-align: middle;
}

#radiusPage .table thead th {
    white-space: nowrap;
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 0.10em;
    text-transform: uppercase;
    color: #475569;
    border-bottom-color: #e2e8f0;
    padding-top: 18px;
    padding-bottom: 14px;
    background: #f8fafc;
}

#radiusPage .table tbody td {
    padding-top: 16px;
    padding-bottom: 16px;
    border-bottom-color: #edf2f7;
}

#radiusPage .table td:last-child,
#radiusPage .table th:last-child {
    text-align: right;
    white-space: nowrap;
}

#radiusPage .table tbody tr:hover td {
    background: rgba(37, 99, 235, 0.02);
}

#radiusPage #radiusTable th:nth-child(1),
#radiusPage #radiusTable td:nth-child(1),
#radiusPage #radiusTable th:nth-child(1),
#radiusPage #radiusTable td:nth-child(1) {
    width: 18%;
}

#radiusPage #radiusTable th:nth-child(2),
#radiusPage #radiusTable td:nth-child(2),
#radiusPage #radiusTable th:nth-child(2),
#radiusPage #radiusTable td:nth-child(2) {
    width: 14%;
}

#radiusPage #radiusTable th:nth-child(3),
#radiusPage #radiusTable td:nth-child(3),
#radiusPage #radiusTable th:nth-child(3),
#radiusPage #radiusTable td:nth-child(3) {
    width: 20%;
}

#radiusPage #radiusTable th:nth-child(4),
#radiusPage #radiusTable td:nth-child(4),
#radiusPage #radiusTable th:nth-child(4),
#radiusPage #radiusTable td:nth-child(4) {
    width: 24%;
}

#radiusPage #radiusTable th:nth-child(5),
#radiusPage #radiusTable td:nth-child(5),
#radiusPage #radiusTable th:nth-child(5),
#radiusPage #radiusTable td:nth-child(5) {
    width: 14%;
}

#radiusPage #radiusTable th:nth-child(6),
#radiusPage #radiusTable td:nth-child(6),
#radiusPage #radiusTable th:nth-child(6),
#radiusPage #radiusTable td:nth-child(6) {
    width: 20%;
    min-width: 210px;
}

/* =========================================================
   CELL STYLES
========================================================= */
#radiusPage .nx-cell-stack {
    display: flex;
    flex-direction: column;
    gap: 3px;
    min-width: 0;
}

#radiusPage .nx-cell-title {
    font-size: 14px;
    font-weight: 700;
    color: #0f172a;
    line-height: 1.2;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

#radiusPage .nx-cell-sub {
    font-size: 12px;
    color: #64748b;
    line-height: 1.25;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

#radiusPage .nx-text-mono {
    white-space: nowrap;
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, "Liberation Mono", monospace;
}

/* =========================================================
   ACTION BUTTONS
========================================================= */
#radiusPage .nx-radius-actions {
    display: inline-flex;
    align-items: center;
    justify-content: flex-end;
    gap: 6px;
    flex-wrap: nowrap;
    white-space: nowrap;
    min-width: 168px;
}

#radiusPage .nx-icon-btn {
    width: 36px;
    height: 36px;
    min-width: 36px;
    min-height: 36px;
    padding: 0;
    border-radius:3px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    line-height: 1;
    box-shadow: none;
}

#radiusPage .nx-icon-btn i {
    font-size: 13px;
    line-height: 1;
    display: inline-flex;
    align-items: center;
    justify-content: center;
}

#radiusPage .btn-outline-secondary.nx-icon-btn {
    border-color: #d9e1ec;
    color: #64748b;
    background: #fff;
}

#radiusPage .btn-outline-secondary.nx-icon-btn:hover {
    background: #f8fafc;
    border-color: #cbd5e1;
    color: #334155;
}

#radiusPage .btn-outline-primary.nx-icon-btn {
    border-color: #bfdbfe;
    color: #2563eb;
    background: #fff;
}

#radiusPage .btn-outline-primary.nx-icon-btn:hover {
    background: #eff6ff;
    border-color: #93c5fd;
    color: #1d4ed8;
}

#radiusPage .btn-outline-success.nx-icon-btn {
    border-color: #bbf7d0;
    color: #16a34a;
    background: #fff;
}

#radiusPage .btn-outline-success.nx-icon-btn:hover {
    background: #f0fdf4;
    border-color: #86efac;
    color: #15803d;
}

#radiusPage .btn-outline-danger.nx-icon-btn {
    border-color: #fecaca;
    color: #ef4444;
    background: #fff;
}

#radiusPage .btn-outline-danger.nx-icon-btn:hover {
    background: #fef2f2;
    border-color: #fca5a5;
    color: #dc2626;
}

/* =========================================================
   BADGES
========================================================= */
#radiusPage .nx-soft-badge,
#radiusPage .nx-soft-badge-success,
#radiusPage .nx-soft-badge-danger,
#radiusPage .nx-soft-badge-warning,
#radiusPage .nx-soft-badge-info {
    font-size: 11px;
    padding: 5px 10px;
    border-radius:3px;
    font-weight: 800;
    letter-spacing: 0.02em;
    min-width: 96px;
    justify-content: center;
    display: inline-flex;
    align-items: center;
}

#radiusPage .nx-soft-badge-success {
    background: #e8f8ef;
    color: #15803d;
}

#radiusPage .nx-soft-badge-danger {
    background: #fef2f2;
    color: #dc2626;
}

#radiusPage .nx-soft-badge-warning {
    background: #fffbeb;
    color: #b45309;
}

#radiusPage .nx-soft-badge-info {
    background: #ecfeff;
    color: #0891b2;
}

/* =========================================================
   EMPTY STATE
========================================================= */
#radiusPage .nx-empty-state {
    padding: 36px 20px;
    text-align: center;
}

#radiusPage .nx-empty-icon {
    width: 64px;
    height: 64px;
    margin: 0 auto 14px;
    border-radius:3px;
    background: #eff6ff;
    color: #2563eb;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 24px;
}

#radiusPage .nx-empty-title {
    font-size: 18px;
    font-weight: 800;
    color: #0f172a;
    margin-bottom: 6px;
}

#radiusPage .nx-empty-text {
    font-size: 14px;
    color: #64748b;
    line-height: 1.55;
    margin-bottom: 0;
}

/* =========================================================
   FORMS / SWEETALERT
========================================================= */
#radiusPage .form-control,
#radiusPage .form-select,
#radiusPage textarea.form-control {
    border-radius:3px;
    border-color: #dbe3ef;
    font-size: 14px;
    box-shadow: none;
    min-height: 42px;
}

#radiusPage textarea.form-control {
    min-height: 110px;
}

#radiusPage .swal2-html-container .form-label {
    display: block;
    font-size: 12px;
    font-weight: 600;
    color: #6b7280;
    margin-bottom: 6px;
    text-transform: uppercase;
    letter-spacing: .04em;
}

#radiusPage .swal2-html-container .form-text {
    font-size: 12px;
    color: #64748b;
    line-height: 1.45;
}

#radiusPage .swal2-html-container .text-start {
    text-align: left !important;
}

/* =========================================================
   SWEETALERT
========================================================= */
.swal2-popup.nx-toast-popup {
    border-radius:3px !important;
    box-shadow: 0 16px 36px rgba(15, 23, 42, .16) !important;
}

/* =========================================================
   RESPONSIVE
========================================================= */
@media (max-width: 1199px) {
    #radiusPage table {
        table-layout: auto;
        min-width: 980px;
    }

    #radiusPage .radius-toolbar-grid {
        grid-template-columns: 1fr;
    }

    #radiusPage .radius-toolbar-meta {
        text-align: left;
    }
}

@media (max-width: 992px) {
    #radiusPage .radius-hero-body {
        flex-direction: column;
        align-items: flex-start;
    }

    #radiusPage .radius-hero-actions {
        width: 100%;
    }
}

@media (max-width: 767px) {
    #radiusPage .nx-summary-card {
        min-height: 128px;
        padding: 20px 22px;
    }

    #radiusPage .nx-content-card .card-body,
    #radiusPage .nx-toolbar-card .card-body {
        padding-left: 14px;
        padding-right: 14px;
    }

    #radiusPage .nx-segment-control {
        width: 100%;
        border-radius:3px;
    }

    #radiusPage .nx-segment-item {
        flex: 1 1 calc(50% - 6px);
        text-align: center;
    }
}
/* =========================================================
   VLAN MANAGEMENT DARK MODE
   Place at VERY BOTTOM
========================================================= */

html[data-theme="dark"] #radiusPage {
    --subs-blue: #60a5fa;
    --subs-blue-dark: #3b82f6;
    --subs-ink: #f8fafc;
    --subs-muted: #9aabc1;
    --subs-line: #2b3d56;
    --subs-surface: #182235;
    --subs-surface-soft: #101827;
    --subs-shadow-soft: 0 12px 26px rgba(0,0,0,.28);
    --subs-shadow-lg: 0 18px 36px rgba(0,0,0,.34);
}

/* Cards / surfaces */
html[data-theme="dark"] #radiusPage .nx-page-header-card,
html[data-theme="dark"] #radiusPage .nx-toolbar-card,
html[data-theme="dark"] #radiusPage .nx-content-card,
html[data-theme="dark"] #radiusPage .nx-summary-card {
    background:
            radial-gradient(circle at top right, rgba(59,130,246,.10), transparent 30%),
            linear-gradient(180deg, #182235 0%, #141f31 100%) !important;
    border-color: rgba(255,255,255,.06) !important;
    box-shadow: var(--subs-shadow-soft) !important;
}

/* Prevent decorative full-width accent rails; hierarchy comes from spacing and headings. */
#radiusPage .subs-table-topline {
    display: none !important;
    height: 0 !important;
    background: none !important;
    border: 0 !important;
    box-shadow: none !important;
}

/* Text */
html[data-theme="dark"] #radiusPage .radius-hero-title,
html[data-theme="dark"] #radiusPage .nx-summary-value,
html[data-theme="dark"] #radiusPage .nx-cell-title,
html[data-theme="dark"] #radiusPage .nx-empty-title {
    color: var(--subs-ink) !important;
}

html[data-theme="dark"] #radiusPage .radius-hero-text,
html[data-theme="dark"] #radiusPage .nx-summary-label,
html[data-theme="dark"] #radiusPage .nx-summary-text,
html[data-theme="dark"] #radiusPage .radius-toolbar-note,
html[data-theme="dark"] #radiusPage .nx-cell-sub,
html[data-theme="dark"] #radiusPage .nx-empty-text {
    color: var(--subs-muted) !important;
}

/* Hero badge */
html[data-theme="dark"] #radiusPage .radius-hero-badge {
    background: rgba(59,130,246,.16) !important;
    color: #93c5fd !important;
    border: 1px solid rgba(147,197,253,.18) !important;
}

/* Segment tabs */
html[data-theme="dark"] #radiusPage .nx-segment-control {
    background: #101827 !important;
    border-color: #334155 !important;
}

html[data-theme="dark"] #radiusPage .nx-segment-item {
    color: #9aabc1 !important;
}

html[data-theme="dark"] #radiusPage .nx-segment-item:hover {
    background: #182235 !important;
    color: #f8fafc !important;
}

html[data-theme="dark"] #radiusPage .nx-segment-item.active {
    color: #ffffff !important;
}

/* Forms */
html[data-theme="dark"] #radiusPage .form-control,
html[data-theme="dark"] #radiusPage .form-select,
html[data-theme="dark"] #radiusPage textarea.form-control,
html[data-theme="dark"] #radiusPage #radiusServerSearch {
    background: #101827 !important;
    border-color: #334155 !important;
    color: #f8fafc !important;
}

html[data-theme="dark"] #radiusPage .form-control::placeholder,
html[data-theme="dark"] #radiusPage #radiusServerSearch::placeholder {
    color: #64748b !important;
}

html[data-theme="dark"] #radiusPage .radius-search-icon {
    color: #64748b !important;
}

/* Card headers */
html[data-theme="dark"] #radiusPage .nx-content-card .card-body.border-bottom {
    border-bottom-color: #2b3d56 !important;
}

/* Tables */
html[data-theme="dark"] #radiusPage .nx-table-wrap,
html[data-theme="dark"] #radiusPage table,
html[data-theme="dark"] #radiusPage .table {
    background: #141f31 !important;
    color: #dbe4f0 !important;
}

html[data-theme="dark"] #radiusPage .table thead,
html[data-theme="dark"] #radiusPage .table thead tr,
html[data-theme="dark"] #radiusPage .table thead th {
    background: #101827 !important;
    color: #9aabc1 !important;
    border-color: #2b3d56 !important;
}

html[data-theme="dark"] #radiusPage .table tbody,
html[data-theme="dark"] #radiusPage .table tbody tr,
html[data-theme="dark"] #radiusPage .table tbody td {
    background: #141f31 !important;
    color: #dbe4f0 !important;
    border-color: rgba(255,255,255,.06) !important;
}

html[data-theme="dark"] #radiusPage .table tbody tr:hover td {
    background: #182235 !important;
    color: #ffffff !important;
}

html[data-theme="dark"] #radiusPage .table > :not(caption) > * > * {
    background-color: transparent !important;
    color: inherit !important;
    box-shadow: none !important;
}

/* Action buttons */
html[data-theme="dark"] #radiusPage .btn-outline-secondary.nx-icon-btn,
html[data-theme="dark"] #radiusPage .btn-outline-primary.nx-icon-btn,
html[data-theme="dark"] #radiusPage .btn-outline-success.nx-icon-btn,
html[data-theme="dark"] #radiusPage .btn-outline-danger.nx-icon-btn {
    background: #182235 !important;
    border-color: #334155 !important;
}

html[data-theme="dark"] #radiusPage .btn-outline-secondary.nx-icon-btn {
    color: #cbd5e1 !important;
}

html[data-theme="dark"] #radiusPage .btn-outline-primary.nx-icon-btn {
    color: #60a5fa !important;
}

html[data-theme="dark"] #radiusPage .btn-outline-success.nx-icon-btn {
    color: #4ade80 !important;
}

html[data-theme="dark"] #radiusPage .btn-outline-danger.nx-icon-btn {
    color: #f87171 !important;
}

html[data-theme="dark"] #radiusPage .nx-icon-btn:hover {
    background: #22324b !important;
    border-color: #475569 !important;
}

/* Badges */
html[data-theme="dark"] #radiusPage .nx-soft-badge-success {
    background: rgba(34,197,94,.14) !important;
    color: #4ade80 !important;
}

html[data-theme="dark"] #radiusPage .nx-soft-badge-danger {
    background: rgba(239,68,68,.14) !important;
    color: #f87171 !important;
}

html[data-theme="dark"] #radiusPage .nx-soft-badge-warning {
    background: rgba(245,158,11,.16) !important;
    color: #fbbf24 !important;
}

html[data-theme="dark"] #radiusPage .nx-soft-badge-info {
    background: rgba(56,189,248,.14) !important;
    color: #7dd3fc !important;
}

/* Empty state */
html[data-theme="dark"] #radiusPage .nx-empty-icon {
    background: rgba(59,130,246,.14) !important;
    color: #60a5fa !important;
}

/* SweetAlert form labels */
html[data-theme="dark"] #radiusPage .swal2-html-container .form-label {
    color: #cbd5e1 !important;
}

html[data-theme="dark"] #radiusPage .swal2-html-container .form-text {
    color: #9aabc1 !important;
}
/* =========================================================
   VLAN SWEETALERT OUTPUT DARK FIX
========================================================= */

html[data-theme="dark"] .swal2-popup.radius-output-popup {
    background: #182235 !important;
    color: #f8fafc !important;
    border: 1px solid #334155 !important;
}

html[data-theme="dark"] .swal2-popup.radius-output-popup .swal2-title {
    color: #f8fafc !important;
}

html[data-theme="dark"] .swal2-popup.radius-output-popup .swal2-html-container {
    color: #dbeafe !important;
}

.radius-output-code {
    display: block;
    width: 100%;
    max-height: 320px;
    overflow: auto;
    padding: 16px;
    border-radius:3px;
    background: #020617 !important;
    color: #dbeafe !important;
    border: 1px solid #334155 !important;
    font-size: 13px;
    line-height: 1.55;
    white-space: pre-wrap;
    word-break: break-word;
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, "Liberation Mono", monospace;
}

.radius-output-code::selection {
    background: rgba(96, 165, 250, .35);
    color: #ffffff;
}

/* UI AI-SLOP AUDIT: remove decorative gradients and redundant card outlines. */
#radiusPage .nx-page-header-card,
#radiusPage .nx-toolbar-card,
#radiusPage .nx-content-card,
#radiusPage .nx-summary-card {
    border: 0 !important;
    border-radius: 3px;
    box-shadow: none !important;
    background: #fff !important;
    background-image: none !important;
}

#radiusPage .radius-hero-body,
#radiusPage .nx-toolbar-card .card-body { padding: 16px 20px; }
#radiusPage .nx-toolbar-card .form-control,
#radiusPage .nx-toolbar-card .form-select,
#radiusPage .nx-content-card .form-control,
#radiusPage .nx-content-card .form-select {
    border-radius: 3px;
    box-shadow: none !important;
}
#radiusPage .form-control:focus,
#radiusPage .form-select:focus {
    border-color: #64748b !important;
    box-shadow: 0 0 0 2px rgba(100,116,139,.14) !important;
}

html[data-theme="dark"] #radiusPage .nx-page-header-card,
html[data-theme="dark"] #radiusPage .nx-toolbar-card,
html[data-theme="dark"] #radiusPage .nx-content-card,
html[data-theme="dark"] #radiusPage .nx-summary-card {
    background: #182235 !important;
    background-image: none !important;
}

/* Radius-specific content hooks retained by the CRUD view. These use the
   same spacing scale as the copied VLAN toolbar/table components. */
#radiusPage .radius-toolbar-group {
    min-width: 0;
}

#radiusPage .radius-toolbar-label {
    display: block;
    margin-bottom: 7px;
    color: #475569;
    font-size: 11px;
    font-weight: 800;
    letter-spacing: .08em;
    text-transform: uppercase;
}

#radiusPage .radius-table-topline {
    display: none;
}

#radiusPage .radius-section-head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 12px;
    padding: 14px 6px 8px;
}

#radiusPage .radius-section-title {
    margin: 0;
    color: #0f172a;
    font-size: 18px;
    font-weight: 800;
}

#radiusPage .radius-section-subtitle {
    margin: 4px 0 0;
    color: #64748b;
    font-size: 13px;
}

#radiusPage .radius-empty-row td {
    padding: 0;
}

/* Radius keeps only endpoint-specific layout here; shared shell/surfaces come from nx.css. */
#radiusPage .radius-hero-card,
#radiusPage .radius-toolbar-card,
#radiusPage .radius-content-card,
#radiusPage .nx-page-header-card,
#radiusPage .nx-toolbar-card,
#radiusPage .nx-content-card,
#radiusPage .card {
    background: var(--nx-panel-surface-light) !important;
    border-color: var(--nx-panel-border-light) !important;
    box-shadow: none !important;
}

html[data-theme="dark"] #radiusPage .radius-hero-card,
html[data-theme="dark"] #radiusPage .radius-toolbar-card,
html[data-theme="dark"] #radiusPage .radius-content-card,
html[data-theme="dark"] #radiusPage .nx-page-header-card,
html[data-theme="dark"] #radiusPage .nx-toolbar-card,
html[data-theme="dark"] #radiusPage .nx-content-card,
html[data-theme="dark"] #radiusPage .card {
    background: var(--nx-panel-surface-dark) !important;
    border-color: var(--nx-panel-border-dark) !important;
    box-shadow: none !important;
}

#radiusPage input,
#radiusPage select,
#radiusPage textarea {
    background: var(--nx-control-surface-light) !important;
    border-color: var(--nx-control-border-light) !important;
}

html[data-theme="dark"] #radiusPage input,
html[data-theme="dark"] #radiusPage select,
html[data-theme="dark"] #radiusPage textarea {
    background: var(--nx-control-surface-dark) !important;
    border-color: var(--nx-control-border-dark) !important;
    color: var(--nx-text) !important;
}




/* Final standard UI contract: match Subscribers and shared nx components. */
#radiusPage .nx-page-header-card,
#radiusPage .nx-toolbar-card,
#radiusPage .nx-content-card,
#radiusPage .nx-summary-card {
    border: 0 !important;
    border-radius: 3px !important;
    background: transparent !important;
    background-image: none !important;
    box-shadow: none !important;
}

#radiusPage .radius-hero-body {
    min-height: 112px !important;
    height: auto !important;
    padding: 20px 0 !important;
}

#radiusPage .radius-hero-title {
    margin: 0 0 6px !important;
    font-size: 21px !important;
    font-weight: 500 !important;
    line-height: 1.2 !important;
}

#radiusPage .radius-hero-text {
    margin: 0 !important;
    font-size: 13px !important;
    font-weight: 400 !important;
    line-height: 1.5 !important;
}

#radiusPage .radius-hero-actions .btn {
    height: 40px !important;
    min-height: 40px !important;
    border-radius: 3px !important;
    font-size: var(--nx-font-size-sm) !important;
    font-weight: 400 !important;
    box-shadow: none !important;
}

#radiusPage .nx-toolbar-card {
    margin-bottom: 16px !important;
}

#radiusPage .nx-toolbar-card .card-body {
    padding: 0 0 16px !important;
}

#radiusPage .radius-toolbar-grid {
    grid-template-columns: minmax(0, 1.1fr) minmax(320px, .9fr) auto !important;
    gap: 16px !important;
}

#radiusPage .radius-toolbar-label {
    margin-bottom: 7px !important;
    color: var(--nx-text-muted) !important;
    font-size: 11px !important;
    font-weight: 500 !important;
    letter-spacing: .07em !important;
}

#radiusPage .radius-toolbar-note,
#radiusPage .radius-toolbar-meta {
    color: var(--nx-text-muted) !important;
    font-size: var(--nx-font-size-sm) !important;
    font-weight: 400 !important;
    line-height: 1.5 !important;
}

#radiusPage .radius-toolbar-meta {
    white-space: nowrap;
}

#radiusPage .radius-toolbar-control,
#radiusPage #radiusServerSearch {
    height: 42px !important;
    min-height: 42px !important;
    padding-top: 0 !important;
    padding-bottom: 0 !important;
    border: 1px solid var(--nx-control-border-light) !important;
    border-radius: 3px !important;
    background: var(--nx-control-surface-light) !important;
    color: var(--nx-text) !important;
    font-size: var(--nx-font-size-sm) !important;
    font-weight: 400 !important;
    box-shadow: none !important;
}

#radiusPage .nx-content-card {
    margin-bottom: 16px !important;
}

#radiusPage .nx-content-card .card-body {
    padding: 0 !important;
}

#radiusPage .radius-section-head {
    padding: 0 0 14px !important;
}

#radiusPage .radius-section-title {
    margin: 0 !important;
    color: var(--nx-text) !important;
    font-size: 18px !important;
    font-weight: 500 !important;
    line-height: 1.3 !important;
}

#radiusPage .radius-section-subtitle {
    margin: 4px 0 0 !important;
    color: var(--nx-text-muted) !important;
    font-size: var(--nx-font-size-sm) !important;
    font-weight: 400 !important;
}

#radiusPage .radius-table-topline {
    display: none !important;
}

#radiusPage .nx-table-wrap {
    overflow-x: auto !important;
    overflow-y: hidden !important;
    border: 0 !important;
    border-radius: 0 !important;
    background: transparent !important;
    box-shadow: none !important;
}

#radiusPage #radiusTable {
    width: 100% !important;
    margin: 0 !important;
    table-layout: fixed !important;
    border: 1px solid var(--nx-table-border-light) !important;
    border-collapse: separate !important;
    border-spacing: 0 !important;
    background: transparent !important;
    font-size: var(--nx-font-size-sm) !important;
}

#radiusPage #radiusTable thead,
#radiusPage #radiusTable thead tr,
#radiusPage #radiusTable thead th {
    background: var(--nx-table-head-surface-light) !important;
    background-image: none !important;
    color: var(--nx-text-muted) !important;
    border-color: var(--nx-table-border-light) !important;
}

#radiusPage #radiusTable thead th {
    height: 37px !important;
    padding: 0 16px !important;
    border-width: 0 0 1px 0 !important;
    font-size: var(--nx-font-size-table-head) !important;
    font-weight: 500 !important;
    letter-spacing: .07em !important;
    line-height: 1.35 !important;
    text-transform: uppercase !important;
    vertical-align: middle !important;
    white-space: nowrap !important;
}

#radiusPage #radiusTable tbody,
#radiusPage #radiusTable tbody tr,
#radiusPage #radiusTable tbody td {
    background: var(--nx-table-row-surface-light) !important;
    background-image: none !important;
    color: var(--nx-text) !important;
}

#radiusPage #radiusTable tbody tr:nth-child(even),
#radiusPage #radiusTable tbody tr:nth-child(even) td {
    background: var(--nx-table-row-surface-light-alt) !important;
}

#radiusPage #radiusTable tbody td {
    min-height: 56px !important;
    padding: 16px !important;
    border: 0 !important;
    border-top: 1px solid var(--nx-border-soft) !important;
    font-size: var(--nx-font-size-sm) !important;
    font-weight: 400 !important;
    line-height: 1.5 !important;
    vertical-align: middle !important;
}

#radiusPage #radiusTable tbody tr:first-child td {
    border-top: 0 !important;
}

#radiusPage #radiusTable th:nth-child(1),
#radiusPage #radiusTable td:nth-child(1) { width: 18% !important; }
#radiusPage #radiusTable th:nth-child(2),
#radiusPage #radiusTable td:nth-child(2) { width: 14% !important; }
#radiusPage #radiusTable th:nth-child(3),
#radiusPage #radiusTable td:nth-child(3) { width: 18% !important; }
#radiusPage #radiusTable th:nth-child(4),
#radiusPage #radiusTable td:nth-child(4) { width: 14% !important; }
#radiusPage #radiusTable th:nth-child(5),
#radiusPage #radiusTable td:nth-child(5) { width: 18% !important; }
#radiusPage #radiusTable th:nth-child(6),
#radiusPage #radiusTable td:nth-child(6) { width: 18% !important; }

#radiusPage .nx-cell-title {
    color: var(--nx-text) !important;
    font-size: var(--nx-font-size-sm) !important;
    font-weight: 400 !important;
    line-height: 1.3 !important;
}

#radiusPage .nx-cell-sub {
    color: var(--nx-text-muted) !important;
    font-size: var(--nx-font-size-xs) !important;
    font-weight: 400 !important;
    line-height: 1.3 !important;
}

#radiusPage .radius-edit-btn,
#radiusPage .radius-delete-btn {
    width: 34px !important;
    height: 34px !important;
    min-width: 34px !important;
    min-height: 34px !important;
    padding: 0 !important;
    border: 1px solid #d7e0ea !important;
    border-radius: 2px !important;
    background: #f1f4f7 !important;
    color: #315b82 !important;
    box-shadow: none !important;
}

#radiusPage .radius-edit-btn:hover,
#radiusPage .radius-delete-btn:hover {
    background: #e7edf3 !important;
    border-color: #c3d0dd !important;
}

#radiusPage .radius-delete-btn {
    color: #a64b4b !important;
}

#radiusPage .badge {
    min-width: 0 !important;
    padding: 4px 10px !important;
    border: 0 !important;
    border-radius: 2px !important;
    font-size: 11px !important;
    font-weight: 500 !important;
    line-height: 1.2 !important;
}

#radiusPage .modal-content {
    border: 1px solid var(--nx-panel-border-light) !important;
    border-radius: 3px !important;
    background: var(--nx-panel-surface-light) !important;
    box-shadow: none !important;
}

#radiusPage .modal-header,
#radiusPage .modal-footer {
    border-color: var(--nx-border) !important;
}

#radiusPage .modal-title {
    font-size: 18px !important;
    font-weight: 500 !important;
}

#radiusPage .modal-body,
#radiusPage .modal-footer,
#radiusPage .modal-header {
    padding: 16px 20px !important;
}

html[data-theme="dark"] #radiusPage .nx-page-header-card,
html[data-theme="dark"] #radiusPage .nx-toolbar-card,
html[data-theme="dark"] #radiusPage .nx-content-card,
html[data-theme="dark"] #radiusPage .nx-summary-card {
    background: transparent !important;
    border-color: transparent !important;
}

html[data-theme="dark"] #radiusPage .radius-toolbar-control,
html[data-theme="dark"] #radiusPage #radiusServerSearch {
    border-color: var(--nx-control-border-dark) !important;
    background: var(--nx-control-surface-dark) !important;
    color: var(--nx-text) !important;
}

html[data-theme="dark"] #radiusPage #radiusTable {
    border-color: var(--nx-table-border-dark) !important;
}

html[data-theme="dark"] #radiusPage #radiusTable thead,
html[data-theme="dark"] #radiusPage #radiusTable thead tr,
html[data-theme="dark"] #radiusPage #radiusTable thead th {
    background: var(--nx-table-head-surface-dark) !important;
    color: #9aa9bc !important;
    border-color: var(--nx-table-border-dark) !important;
}

html[data-theme="dark"] #radiusPage #radiusTable tbody,
html[data-theme="dark"] #radiusPage #radiusTable tbody tr,
html[data-theme="dark"] #radiusPage #radiusTable tbody td {
    background: var(--nx-table-row-surface-dark) !important;
    color: #e5e7eb !important;
}

html[data-theme="dark"] #radiusPage #radiusTable tbody tr:nth-child(even),
html[data-theme="dark"] #radiusPage #radiusTable tbody tr:nth-child(even) td {
    background: var(--nx-table-row-surface-dark-alt) !important;
}

html[data-theme="dark"] #radiusPage #radiusTable tbody td {
    border-top-color: rgba(154, 169, 188, .12) !important;
}

html[data-theme="dark"] #radiusPage .radius-edit-btn,
html[data-theme="dark"] #radiusPage .radius-delete-btn {
    border-color: #344456 !important;
    background: #213247 !important;
    color: #a9c5dd !important;
}

html[data-theme="dark"] #radiusPage .radius-delete-btn {
    color: #f87171 !important;
}

html[data-theme="dark"] #radiusPage .modal-content {
    border-color: var(--nx-panel-border-dark) !important;
    background: var(--nx-panel-surface-dark) !important;
}

@media (max-width: 767.98px) {
    #radiusPage .radius-hero-body {
        min-height: 0 !important;
        padding: 18px 0 !important;
    }

    #radiusPage .radius-toolbar-grid {
        grid-template-columns: 1fr !important;
    }

    #radiusPage .radius-toolbar-meta {
        text-align: left !important;
    }

    #radiusPage #radiusTable {
        min-width: 860px !important;
    }
}



/* Radius workspace surfaces: transparent like the standard Subscribers layout. */
html body#nxApplication .main-content #radiusPage > .radius-hero-card,
html body#nxApplication .main-content #radiusPage > .nx-toolbar-card,
html body#nxApplication .main-content #radiusPage > .nx-content-card {
    margin-top: 0 !important;
    background: transparent !important;
    background-color: transparent !important;
    background-image: none !important;
    border: 0 !important;
    box-shadow: none !important;
}
html body#nxApplication .main-content #radiusPage > .radius-hero-card {
    margin-bottom: 16px !important;
    padding-top: 0 !important;
}
html body#nxApplication .main-content #radiusPage > .nx-toolbar-card,
html body#nxApplication .main-content #radiusPage > .nx-content-card {
    padding-top: 0 !important;
    margin-bottom: 16px !important;
}
html body#nxApplication .main-content #radiusPage > .nx-toolbar-card > .card-body,
html body#nxApplication .main-content #radiusPage > .nx-content-card > .card-body {
    padding-top: 0 !important;
    background: transparent !important;
    background-color: transparent !important;
    background-image: none !important;
}
html[data-theme="dark"] body#nxApplication .main-content #radiusPage > .radius-hero-card,
html[data-theme="dark"] body#nxApplication .main-content #radiusPage > .nx-toolbar-card,
html[data-theme="dark"] body#nxApplication .main-content #radiusPage > .nx-content-card,
html[data-theme="dark"] body#nxApplication .main-content #radiusPage > .nx-toolbar-card > .card-body,
html[data-theme="dark"] body#nxApplication .main-content #radiusPage > .nx-content-card > .card-body {
    background: transparent !important;
    background-color: transparent !important;
    background-image: none !important;
    border-color: transparent !important;
    box-shadow: none !important;
}




/* Match the standard page-to-topbar breathing room used by other modules. */
html body#nxApplication .main-content #radiusPage {
    padding-top: 16px !important;
}




/* Remove horizontal panel insets; keep the page-level top breathing room. */
html body#nxApplication .main-content #radiusPage > .nx-toolbar-card > .card-body,
html body#nxApplication .main-content #radiusPage > .nx-content-card > .card-body {
    padding-left: 0 !important;
    padding-right: 0 !important;
}
