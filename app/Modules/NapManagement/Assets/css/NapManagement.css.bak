/* =========================================================
   NAP MANAGEMENT — MODULE SPECIFIC CSS ONLY
========================================================= */

/* =========================
   MODULE BUTTON TWEAK
========================= */
.nap-header-btn{
    border-radius:3px;
    padding:.55rem .95rem;
    font-weight:700;
}

/* =========================
   SUMMARY CARD COLOR OVERRIDES
========================= */
.nap-summary-card.odf-summary .nx-summary-icon,
.nap-summary-card.odf-summary .nap-summary-icon{
    background:#e0f2fe;
    color:#0284c7;
}

/* =========================
   MODULE TABLE HELPERS
========================= */
.row-maintenance{
    background:rgba(251,146,60,.05);
}

.node-filter-pills{
    display:flex;
    flex-wrap:wrap;
    gap:8px;
}

/* =========================
   BOX CARD GRID
========================= */
.box-card-grid{
    display:grid;
    grid-template-columns:repeat(auto-fill,minmax(340px,1fr));
    gap:18px;
    align-items:stretch;
}

.infra-box-card{
    position:relative;
    overflow:hidden;
    display:flex;
    gap:14px;
    align-items:flex-start;
    padding:18px;
    min-height:345px;
    height:100%;
    background:linear-gradient(180deg,#ffffff 0%,#f8fafc 100%);
    border:1px solid #e5e7eb;
    border-radius:3px;
    box-shadow:0 10px 25px rgba(15,23,42,.05);
    cursor:pointer;
    transition:transform .18s ease, box-shadow .18s ease, border-color .18s ease;
}

.infra-box-card:hover{
    transform:translateY(-2px);
    box-shadow:0 16px 32px rgba(15,23,42,.09);
    border-color:#cbd5e1;
}

.infra-box-card.maintenance{
    border-color:#fdba74;
    background:linear-gradient(180deg,#fffaf5 0%,#fff7ed 100%);
}

.infra-maintenance-ribbon{
    position:absolute;
    top:10px;
    right:-34px;
    transform:rotate(35deg);
    background:#f97316;
    color:#fff;
    font-size:.66rem;
    font-weight:700;
    padding:4px 38px;
    letter-spacing:.04em;
}

.infra-box-icon-wrap{
    width:54px;
    height:54px;
    border-radius:3px;
    display:flex;
    align-items:center;
    justify-content:center;
    flex:0 0 auto;
    font-size:1.3rem;
}

.infra-box-icon-wrap.odf{
    background:#e0f2fe;
    color:#0284c7;
}

.infra-box-icon-wrap.lcp{
    background:#dbeafe;
    color:#1d4ed8;
}

.infra-box-icon-wrap.nap{
    background:#dcfce7;
    color:#15803d;
}

.infra-box-body{
    min-width:0;
    flex:1;
    display:flex;
    flex-direction:column;
    height:100%;
}

.infra-box-title-row{
    display:flex;
    align-items:flex-start;
    justify-content:space-between;
    gap:10px;
    margin-bottom:12px;
}

.infra-box-title{
    font-size:1.02rem;
    font-weight:800;
    color:#0f172a;
    line-height:1.25;
    word-break:break-word;
}

.infra-box-chip{
    border-radius:3px;
    padding:5px 10px;
    font-size:.72rem;
    font-weight:700;
    white-space:nowrap;
}

.infra-box-chip.odf{
    background:#e0f2fe;
    color:#0369a1;
}

.infra-box-chip.lcp{
    background:#dbeafe;
    color:#1d4ed8;
}

.infra-box-chip.nap{
    background:#dcfce7;
    color:#15803d;
}

.infra-box-meta{
    display:grid;
    gap:7px;
    font-size:.82rem;
    color:#64748b;
    margin-bottom:14px;
}

.infra-box-meta div{
    word-break:break-word;
    overflow-wrap:anywhere;
    line-height:1.45;
}

.infra-box-meta strong{
    color:#475569;
    font-weight:700;
}

.infra-box-stats{
    display:flex;
    flex-wrap:wrap;
    gap:8px;
    margin-top:2px;
    margin-bottom:14px;
}

.infra-stat{
    display:inline-flex;
    align-items:center;
    justify-content:center;
    min-height:28px;
    padding:5px 10px;
    border-radius:3px;
    font-size:.72rem;
    font-weight:800;
}

.infra-stat.used{
    background:#fef2f2;
    color:#b91c1c;
}

.infra-stat.free{
    background:#ecfdf5;
    color:#15803d;
}

.infra-stat.neutral{
    background:#eff6ff;
    color:#1d4ed8;
}

/* =========================
   CARD ACTIONS
========================= */
.infra-box-actions{
    margin-top:auto;
    display:grid;
    grid-template-columns:repeat(4,minmax(0,1fr));
    gap:8px;
    padding-top:10px;
}

.infra-action-btn{
    width:100%;
    min-height:38px !important;
    height:38px;
    padding:0 !important;
    border-radius:3px;
    display:inline-flex;
    align-items:center;
    justify-content:center;
    gap:6px;
    font-size:.78rem;
    font-weight:700;
    white-space:nowrap;
}

.infra-action-btn i{
    font-size:.82rem;
    line-height:1;
}

.infra-action-btn-wide{
    padding:0 10px !important;
}

.infra-action-btn-wide span{
    font-size:.74rem;
    font-weight:700;
    line-height:1;
}

/* =========================
   NODES CARD CONTENT HELPERS
========================= */
.infra-box-meta .meta-clamp-2{
    display:-webkit-box;
    -webkit-line-clamp:2;
    -webkit-box-orient:vertical;
    overflow:hidden;
}

.infra-box-meta .meta-clamp-3{
    display:-webkit-box;
    -webkit-line-clamp:3;
    -webkit-box-orient:vertical;
    overflow:hidden;
}

/* =========================
   NODES TAB FOOTER POLISH
========================= */
#nodesPageMeta{
    font-size:.82rem;
    color:#64748b;
    font-weight:600;
}

#nodesPerPageSelect{
    min-width:72px;
    width:72px !important;
    height:40px;
    border-radius:3px;
    border:1px solid #d9e3ee;
    background:#fff;
    font-size:.82rem;
    font-weight:700;
    text-align:center;
}

#nodesPrevBtn,
#nodesNextBtn{
    min-width:46px;
    height:40px;
    border-radius:3px;
    font-size:.82rem;
    font-weight:700;
}

#nodesPrevBtn:disabled,
#nodesNextBtn:disabled{
    opacity:.55;
    cursor:not-allowed;
}

/* =========================
   NODES TAB HEADER BAR
========================= */
#nodesSearchInput{
    min-height:42px;
    border-radius:3px;
}

#openCreateOdfBtn,
#openCreateLcpBtn,
#openCreateNapBtn{
    min-height:40px;
    border-radius:3px;
    font-size:.84rem;
    font-weight:700;
}

/* =========================
   PLANNER CANVAS BACKGROUNDS / INPUTS / ACTION COLORS
========================= */
#napManagementApp #plannerLogicalCanvas{
    --planner-grid-size:48px;
    --planner-grid-offset-x:0px;
    --planner-grid-offset-y:0px;
    background-color:#f4f7fa !important;
    background-image:
            linear-gradient(rgba(100,116,139,.12) 1px, transparent 1px),
            linear-gradient(90deg, rgba(100,116,139,.12) 1px, transparent 1px),
            linear-gradient(180deg,#f8fafc 0%,#eef2f7 100%) !important;
    background-position:
            var(--planner-grid-offset-x) var(--planner-grid-offset-y),
            var(--planner-grid-offset-x) var(--planner-grid-offset-y),
            0 0 !important;
    background-size:
            var(--planner-grid-size) var(--planner-grid-size),
            var(--planner-grid-size) var(--planner-grid-size),
            100% 100% !important;
    background-repeat:repeat, repeat, no-repeat !important;
}

#plannerMapCanvas{
    background:linear-gradient(180deg,#e0f2fe 0%,#f8fafc 100%);
}

.planner-node-odf{
    color:#0284c7;
}

#plannerOltSelect,
#plannerOltPortSelect{
    height:38px;
    font-size:.82rem;
    font-weight:600;
    border:1px solid #dbe2ea;
    border-radius:3px;
    background:#fff;
    color:#334155;
    padding:0 12px;
    flex:0 0 auto;
    box-shadow:none;
}

#plannerOltSelect:focus,
#plannerOltPortSelect:focus{
    outline:none;
    border-color:#93c5fd;
    box-shadow:0 0 0 .18rem rgba(37,99,235,.10);
}

#plannerOltSelect{
    min-width:180px;
    width:180px;
}

#plannerOltPortSelect{
    min-width:120px;
    width:120px;
}

#plannerAddObjectBtn{
    background:linear-gradient(135deg,#2563eb,#1d4ed8);
    border-color:transparent;
    color:#fff;
    box-shadow:0 10px 24px rgba(37,99,235,.18);
}

#plannerAddLinkBtn{
    background:linear-gradient(135deg,#16a34a,#15803d);
    border-color:transparent;
    color:#fff;
    box-shadow:0 10px 24px rgba(22,163,74,.16);
}

#plannerDeleteObjectBtn,
#plannerDeleteLinkBtn{
    background:#fff;
    border-color:#fecaca;
    color:#dc2626;
}

#plannerDeleteObjectBtn:hover,
#plannerDeleteLinkBtn:hover{
    background:#fef2f2;
    border-color:#fca5a5;
    color:#b91c1c;
}

#plannerRefreshBtn,
#plannerClearHighlightBtn{
    background:#fff;
    border-color:#cbd5e1;
    color:#475569;
}

#plannerSaveBtn{
    background:linear-gradient(135deg,#2563eb,#1d4ed8);
    border-color:transparent;
    color:#fff;
    box-shadow:0 10px 24px rgba(37,99,235,.18);
}

#napManagementApp[data-initial-tab="planner"] #napToolbarArea{
    margin-bottom:10px;
}



/* =========================
   BOX VIEWER / CABINET — FINAL PREMIUM
========================= */
.box-viewer-stage{
    background:linear-gradient(180deg,#f8fafc 0%,#eef2f7 100%);
    border-radius:3px;
    padding:16px;
    border:1px solid #e5e7eb;
    box-shadow:inset 0 1px 0 rgba(255,255,255,.65);
}

.cabinet-scene{
    display:flex;
    justify-content:center;
    align-items:flex-start;
    padding:6px 0;
}

.cabinet{
    position:relative;
    width:min(100%,1050px);
    min-height:390px;
    border-radius:3px;
    background:linear-gradient(135deg,#1e293b 0%,#0f172a 100%);
    box-shadow:0 22px 42px rgba(15,23,42,.20);
    padding:14px;
    overflow:hidden;
    transition:all .25s ease;
}

.cabinet.odf{
    box-shadow:0 22px 42px rgba(2,132,199,.14);
}

.cabinet.maintenance{
    box-shadow:0 22px 42px rgba(249,115,22,.16);
}

.cabinet-badge{
    display:inline-flex;
    flex-direction:column;
    gap:2px;
    padding:8px 12px;
    background:rgba(255,255,255,.08);
    border:1px solid rgba(255,255,255,.10);
    border-radius:3px;
    color:#fff;
    margin-bottom:12px;
    backdrop-filter:blur(8px);
}

.cabinet-badge-name{
    font-size:.96rem;
    font-weight:800;
    line-height:1.1;
}

.cabinet-badge-type{
    font-size:.7rem;
    opacity:.8;
    letter-spacing:.05em;
    text-transform:uppercase;
}

.cabinet-inside{
    position:relative;
    background:
            radial-gradient(circle at top left, rgba(255,255,255,.75) 0%, rgba(255,255,255,0) 28%),
            linear-gradient(180deg,#f8fafc 0%,#edf2f7 100%);
    border-radius:3px;
    border:1px solid rgba(255,255,255,.65);
    min-height:320px;
    padding:16px;
    z-index:2;
    box-shadow:inset 0 1px 0 rgba(255,255,255,.55);
}

.cabinet-inside-top{
    display:flex;
    align-items:flex-start;
    justify-content:space-between;
    gap:12px;
    flex-wrap:wrap;
    margin-bottom:12px;
}

.splitter-panel{
    display:flex;
    align-items:center;
    justify-content:space-between;
    gap:14px;
    background:linear-gradient(180deg,#ffffff 0%,#f8fafc 100%);
    border:1px solid #dbe2ea;
    border-radius:3px;
    padding:10px 14px;
    box-shadow:0 8px 20px rgba(15,23,42,.05);
}

.splitter-panel-title{
    font-size:.68rem;
    text-transform:uppercase;
    letter-spacing:.10em;
    color:#64748b;
    font-weight:800;
    margin-bottom:2px;
}

.splitter-panel-ratio{
    font-size:1.55rem;
    font-weight:800;
    color:#0f172a;
    line-height:1;
}

.splitter-status-legend{
    display:flex;
    flex-wrap:wrap;
    gap:6px;
    justify-content:flex-end;
}

.legend-chip{
    display:inline-flex;
    align-items:center;
    gap:6px;
    padding:5px 10px;
    border-radius:3px;
    background:rgba(255,255,255,.88);
    border:1px solid #dbe2ea;
    font-size:.7rem;
    font-weight:700;
    color:#334155;
    box-shadow:0 4px 10px rgba(15,23,42,.03);
    min-height:30px;
}

.legend-dot{
    width:8px;
    height:8px;
    border-radius:3px;
    display:inline-block;
    flex:0 0 auto;
}

.legend-dot.green{ background:#22c55e; }
.legend-dot.red{ background:#ef4444; }
.legend-dot.orange{ background:#f59e0b; }
.legend-dot.gray{ background:#94a3b8; }

/* default rows */
.splitter-row{
    display:grid;
    grid-template-columns:repeat(8,minmax(0,1fr));
    gap:10px;
    margin-bottom:10px;
}

/* dedicated uplink row */
.splitter-row.splitter-row-uplink{
    display:flex;
    align-items:stretch;
    gap:12px;
    margin-bottom:14px;
}

.splitter-port{
    position:relative;
    min-height:82px;
    border-radius:3px;
    border:1px solid #dbe2ea;
    background:linear-gradient(180deg,#ffffff 0%,#f8fafc 100%);
    padding:8px 8px 7px;
    text-align:center;
    box-shadow:0 6px 14px rgba(15,23,42,.04);
    overflow:hidden;
    display:flex;
    flex-direction:column;
    justify-content:flex-start;
    transition:transform .16s ease, box-shadow .16s ease, border-color .16s ease;
}

.splitter-port:hover{
    transform:translateY(-1px);
    box-shadow:0 12px 20px rgba(15,23,42,.07);
}

.splitter-port::after{
    content:'';
    position:absolute;
    left:0;
    top:0;
    width:100%;
    height:4px;
    background:#cbd5e1;
}

.splitter-port.free{
    background:linear-gradient(180deg,#f3fcf7 0%,#ecfdf5 100%);
    border-color:#86efac;
}

.splitter-port.free::after{
    background:#22c55e;
}

.splitter-port.used{
    background:linear-gradient(180deg,#fff6f6 0%,#fef2f2 100%);
    border-color:#fda4af;
}

.splitter-port.used::after{
    background:#ef4444;
}

.splitter-port.reserved{
    background:linear-gradient(180deg,#f5f8ff 0%,#eff6ff 100%);
    border-color:#93c5fd;
}

.splitter-port.reserved::after{
    background:#2563eb;
}

.splitter-port.maintenance{
    background:linear-gradient(180deg,#f8fafc 0%,#f1f5f9 100%);
    border-color:#cbd5e1;
}

.splitter-port.maintenance::after{
    background:#64748b;
}

.splitter-port-no{
    font-size:.95rem;
    font-weight:800;
    color:#0f172a;
    line-height:1;
    margin-bottom:6px;
}

.splitter-port-status{
    font-size:.60rem;
    font-weight:800;
    letter-spacing:.08em;
    color:#475569;
    text-transform:uppercase;
    margin-bottom:4px;
    line-height:1.15;
}

.splitter-port-linked{
    font-size:.68rem;
    color:#64748b;
    font-weight:600;
    line-height:1.18;
    word-break:break-word;
    overflow-wrap:anywhere;
    display:-webkit-box;
    -webkit-box-orient:vertical;
    -webkit-line-clamp:2;
    overflow:hidden;
    min-height:2.2em;
}

.splitter-port-linked.is-medium{
    font-size:.66rem;
    line-height:1.1;
}

.splitter-port-linked.is-long{
    font-size:.60rem;
    line-height:1.05;
}

.splitter-port-linked.is-empty{
    color:#94a3b8;
}

.splitter-port.used .splitter-port-linked,
.splitter-port.reserved .splitter-port-linked{
    font-weight:700;
}

/* premium uplink tile */
.splitter-port.uplink-port{
    position:relative;
    min-width:162px;
    max-width:162px;
    min-height:74px;
    border-radius:3px;
    border:1px solid rgba(79,70,229,.28);
    background:linear-gradient(180deg,rgba(255,255,255,.95) 0%,rgba(238,242,255,.98) 100%);
    box-shadow:
            0 10px 24px rgba(79,70,229,.12),
            inset 0 1px 0 rgba(255,255,255,.75);
    padding:10px 10px 8px;
    text-align:center;
    overflow:hidden;
}

.splitter-port.uplink-port::after{
    content:'';
    position:absolute;
    left:0;
    top:0;
    width:100%;
    height:4px;
    background:linear-gradient(90deg,#4f46e5,#2563eb);
}

.splitter-port.uplink-port .splitter-port-no{
    font-size:.95rem;
    line-height:1;
    font-weight:800;
    color:#1e3a8a;
    margin-bottom:4px;
    letter-spacing:.02em;
}

.splitter-port.uplink-port .splitter-port-status{
    font-size:.62rem;
    color:#4338ca;
    font-weight:800;
    letter-spacing:.08em;
    text-transform:uppercase;
    margin-bottom:5px;
}

.splitter-port.uplink-port .splitter-port-linked{
    font-size:.69rem;
    line-height:1.18;
    color:#334155;
    font-weight:700;
    word-break:break-word;
    overflow-wrap:anywhere;
    display:-webkit-box;
    -webkit-box-orient:vertical;
    -webkit-line-clamp:2;
    overflow:hidden;
    min-height:2.2em;
}

/* =========================
   VIEWER HEADER / META POLISH
========================= */
#boxViewerModal .modal-dialog{
    max-width:1180px;
}

#boxViewerModal .nx-modal-header{
    padding:14px 18px;
}

#boxViewerModal .nx-modal-body{
    padding:16px;
}

#boxViewerModal .nx-modal-footer{
    padding:14px 18px;
}

#boxViewerModal .modal-title,
#boxViewerTitle{
    font-size:1.5rem;
    font-weight:800;
    line-height:1.1;
    color:#0f172a;
}

#boxViewerSubtitle{
    font-size:.86rem;
    color:#64748b;
    margin-top:3px;
}

#boxViewerModal .btn{
    min-height:38px !important;
    border-radius:3px;
    font-size:.82rem;
    font-weight:700;
}

#boxViewerModal .btn-close{
    opacity:.7;
}

#boxViewerModal .btn-close:hover{
    opacity:1;
}

#boxViewerModal .nx-meta-tile{
    border-radius:3px;
    padding:12px 14px;
    min-height:84px;
    box-shadow:0 6px 16px rgba(15,23,42,.04);
    background:linear-gradient(180deg,#ffffff 0%,#f8fafc 100%);
    border:1px solid #dbe2ea;
}

#boxViewerModal .nx-meta-label{
    font-size:.68rem;
    letter-spacing:.06em;
    font-weight:800;
    margin-bottom:6px;
}

#boxViewerModal .nx-meta-value{
    font-size:1rem;
    font-weight:800;
    line-height:1.35;
}

#boxViewerExtraInfo .nx-meta-tile{
    padding:12px 14px;
    min-height:72px;
    background:linear-gradient(180deg,#ffffff 0%,#f8fafc 100%);
    border:1px solid #dbe2ea;
    border-radius:3px;
    box-shadow:0 8px 18px rgba(15,23,42,.04);
}

/* =========================
   RESPONSIVE
========================= */
@media (max-width: 1399.98px){
    .box-card-grid{
        grid-template-columns:repeat(auto-fill,minmax(320px,1fr));
    }
}

@media (max-width: 1199.98px){
    .box-card-grid{
        grid-template-columns:repeat(auto-fill,minmax(300px,1fr));
    }

    .splitter-row{
        grid-template-columns:repeat(6,minmax(0,1fr));
    }
}

@media (max-width: 991.98px){
    .splitter-row{
        grid-template-columns:repeat(4,minmax(0,1fr));
    }

    .splitter-row.splitter-row-uplink{
        flex-direction:column;
    }

    .splitter-port.uplink-port{
        max-width:none;
        width:100%;
        min-width:0;
    }

    #boxViewerModal .nx-meta-tile{
        min-height:unset;
    }
}

@media (max-width: 767.98px){
    .box-card-grid{
        grid-template-columns:1fr;
    }

    .infra-box-card{
        min-height:auto;
    }

    .infra-box-actions{
        grid-template-columns:repeat(2,minmax(0,1fr));
    }

    .cabinet{
        padding:12px;
        border-radius:3px;
    }

    .cabinet-inside{
        padding:12px;
    }

    .cabinet-inside-top{
        align-items:flex-start;
    }

    .splitter-status-legend{
        justify-content:flex-start;
    }
}

@media (max-width: 575.98px){
    .infra-box-card{
        padding:14px;
        gap:12px;
    }

    .infra-box-actions{
        grid-template-columns:1fr;
    }

    .splitter-row{
        grid-template-columns:repeat(2,minmax(0,1fr));
    }

    .splitter-port{
        min-height:78px;
    }

    #boxViewerModal .nx-modal-header{
        padding:12px 14px;
    }

    #boxViewerModal .nx-modal-body{
        padding:12px;
    }
}
#plannerMapCanvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    padding: 0;
    background: #e0f2fe;
}

.nap-map-shell {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: hidden;
    background: #e0f2fe;
}

#napPlannerMap {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 1;
}

.nap-map-legend {
    position: absolute;
    right: 18px;
    bottom: 18px;
    z-index: 600;
    background: #ffffff;
    border: 1px solid #dbeafe;
    border-radius:3px;
    padding: 12px 14px;
    box-shadow: 0 14px 30px rgba(15, 23, 42, 0.18);
    font-size: 12px;
    min-width: 150px;
}

.nap-map-legend-title {
    font-weight: 900;
    color: #0f172a;
    margin-bottom: 8px;
}

.nap-map-legend-row {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 7px;
    font-weight: 700;
    color: #334155;
}

.nap-map-dot {
    width: 11px;
    height: 11px;
    border-radius:3px;
    display: inline-block;
    flex: 0 0 auto;
}

.nap-map-dot.odf { background: #dc2626; }
.nap-map-dot.lcp { background: #2563eb; }
.nap-map-dot.nap { background: #16a34a; }

.nap-map-line {
    width: 22px;
    height: 4px;
    border-radius:3px;
    display: inline-block;
    flex: 0 0 auto;
}

.nap-map-line.feeder { background: #7c3aed; }
.nap-map-line.distribution { background: #f97316; }

.leaflet-container {
    width: 100%;
    height: 100%;
}

.nap-map-node-label {
    border: 0 !important;
    border-radius:3px !important;
    padding: 4px 8px !important;
    font-size: 11px !important;
    font-weight: 900 !important;
    line-height: 1 !important;
    color: #0f172a !important;
    background: rgba(255, 255, 255, 0.92) !important;
    box-shadow: 0 8px 18px rgba(15, 23, 42, 0.18) !important;
}

.nap-map-node-label::before {
    display: none !important;
}

.nap-map-node-label.odf {
    color: #991b1b !important;
}

.nap-map-node-label.lcp {
    color: #1d4ed8 !important;
}

.nap-map-node-label.nap {
    color: #166534 !important;
}
.nap-map-node-label.success {
    background: rgba(220, 252, 231, 0.96) !important;
    color: #166534 !important;
}

.nap-map-node-label.info {
    background: rgba(219, 234, 254, 0.96) !important;
    color: #1d4ed8 !important;
}

.nap-map-node-label.warning {
    background: rgba(255, 237, 213, 0.96) !important;
    color: #c2410c !important;
}

.nap-map-node-label.danger {
    background: rgba(254, 226, 226, 0.96) !important;
    color: #b91c1c !important;
}

.nap-map-util-badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius:3px;
    padding: 4px 9px;
    font-size: 11px;
    font-weight: 900;
    white-space: nowrap;
}

.nap-map-util-badge.success {
    background: #dcfce7;
    color: #166534;
}

.nap-map-util-badge.info {
    background: #dbeafe;
    color: #1d4ed8;
}

.nap-map-util-badge.warning {
    background: #ffedd5;
    color: #c2410c;
}

.nap-map-util-badge.danger {
    background: #fee2e2;
    color: #b91c1c;
}

.nap-map-util-bar {
    width: 100%;
    height: 8px;
    background: #e5e7eb;
    border-radius:3px;
    overflow: hidden;
}

.nap-map-util-bar-fill {
    height: 100%;
    border-radius:3px;
}

.nap-map-util-bar-fill.success {
    background: #16a34a;
}

.nap-map-util-bar-fill.info {
    background: #2563eb;
}

.nap-map-util-bar-fill.warning {
    background: #f97316;
}

.nap-map-util-bar-fill.danger {
    background: #dc2626;
}

/* =========================================================
   NAP MANAGEMENT DARK MODE
   Place at VERY BOTTOM of NapManagement.css
========================================================= */

html[data-theme="dark"] .nap-summary-card.odf-summary .nx-summary-icon,
html[data-theme="dark"] .nap-summary-card.odf-summary .nap-summary-icon {
    background: rgba(56, 189, 248, .14) !important;
    color: #38bdf8 !important;
}

/* Tables / rows */
html[data-theme="dark"] .row-maintenance {
    background: rgba(251, 146, 60, .09) !important;
}

/* Box cards */
html[data-theme="dark"] .infra-box-card {
    background: linear-gradient(180deg, #182235 0%, #141f31 100%) !important;
    border-color: rgba(255, 255, 255, .06) !important;
    box-shadow: 0 14px 30px rgba(0, 0, 0, .28) !important;
}

html[data-theme="dark"] .infra-box-card:hover {
    border-color: rgba(96, 165, 250, .35) !important;
    box-shadow: 0 18px 36px rgba(0, 0, 0, .36) !important;
}

html[data-theme="dark"] .infra-box-card.maintenance {
    background:
            radial-gradient(circle at top right, rgba(249, 115, 22, .14), transparent 32%),
            linear-gradient(180deg, #241c14 0%, #181b20 100%) !important;
    border-color: rgba(251, 146, 60, .35) !important;
}

/* Icons */
html[data-theme="dark"] .infra-box-icon-wrap.odf {
    background: rgba(56, 189, 248, .14) !important;
    color: #38bdf8 !important;
}

html[data-theme="dark"] .infra-box-icon-wrap.lcp {
    background: rgba(59, 130, 246, .14) !important;
    color: #60a5fa !important;
}

html[data-theme="dark"] .infra-box-icon-wrap.nap {
    background: rgba(34, 197, 94, .14) !important;
    color: #4ade80 !important;
}

/* Text */
html[data-theme="dark"] .infra-box-title,
html[data-theme="dark"] #boxViewerModal .modal-title,
html[data-theme="dark"] #boxViewerTitle,
html[data-theme="dark"] .splitter-panel-ratio,
html[data-theme="dark"] .splitter-port-no {
    color: #f8fafc !important;
}

html[data-theme="dark"] .infra-box-meta,
html[data-theme="dark"] .infra-box-meta strong,
html[data-theme="dark"] #nodesPageMeta,
html[data-theme="dark"] #boxViewerSubtitle,
html[data-theme="dark"] .splitter-panel-title,
html[data-theme="dark"] .splitter-port-status,
html[data-theme="dark"] .splitter-port-linked,
html[data-theme="dark"] .legend-chip {
    color: #9aabc1 !important;
}

/* Chips */
html[data-theme="dark"] .infra-box-chip.odf {
    background: rgba(56, 189, 248, .14) !important;
    color: #7dd3fc !important;
}

html[data-theme="dark"] .infra-box-chip.lcp {
    background: rgba(59, 130, 246, .14) !important;
    color: #93c5fd !important;
}

html[data-theme="dark"] .infra-box-chip.nap {
    background: rgba(34, 197, 94, .14) !important;
    color: #4ade80 !important;
}

/* Stats */
html[data-theme="dark"] .infra-stat.used {
    background: rgba(239, 68, 68, .14) !important;
    color: #f87171 !important;
}

html[data-theme="dark"] .infra-stat.free {
    background: rgba(34, 197, 94, .14) !important;
    color: #4ade80 !important;
}

html[data-theme="dark"] .infra-stat.neutral {
    background: rgba(59, 130, 246, .14) !important;
    color: #93c5fd !important;
}

/* Inputs */
html[data-theme="dark"] #nodesPerPageSelect,
html[data-theme="dark"] #nodesSearchInput,
html[data-theme="dark"] #plannerOltSelect,
html[data-theme="dark"] #plannerOltPortSelect {
    background: #101827 !important;
    border-color: #334155 !important;
    color: #f8fafc !important;
}

/* Planner canvas */
html[data-theme="dark"] #napManagementApp #plannerLogicalCanvas {
    background-color: #0d1625 !important;
    background-image:
            linear-gradient(rgba(148, 163, 184, .10) 1px, transparent 1px),
            linear-gradient(90deg, rgba(148, 163, 184, .10) 1px, transparent 1px),
            linear-gradient(180deg, #101827 0%, #0b1220 100%) !important;
    background-position:
            var(--planner-grid-offset-x) var(--planner-grid-offset-y),
            var(--planner-grid-offset-x) var(--planner-grid-offset-y),
            0 0 !important;
    background-size:
            var(--planner-grid-size) var(--planner-grid-size),
            var(--planner-grid-size) var(--planner-grid-size),
            100% 100% !important;
    background-repeat: repeat, repeat, no-repeat !important;
}

html[data-theme="dark"] #plannerMapCanvas,
html[data-theme="dark"] .nap-map-shell {
    background: #101827 !important;
}

/* Planner buttons */
html[data-theme="dark"] #plannerDeleteObjectBtn,
html[data-theme="dark"] #plannerDeleteLinkBtn {
    background: #182235 !important;
    border-color: rgba(248, 113, 113, .35) !important;
    color: #f87171 !important;
}

html[data-theme="dark"] #plannerDeleteObjectBtn:hover,
html[data-theme="dark"] #plannerDeleteLinkBtn:hover {
    background: rgba(239, 68, 68, .14) !important;
    color: #fecaca !important;
}

html[data-theme="dark"] #plannerRefreshBtn,
html[data-theme="dark"] #plannerClearHighlightBtn {
    background: #182235 !important;
    border-color: #334155 !important;
    color: #cbd5e1 !important;
}

/* Box viewer / cabinet stage */
html[data-theme="dark"] .box-viewer-stage {
    background: linear-gradient(180deg, #101827 0%, #0b1220 100%) !important;
    border-color: #2b3d56 !important;
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, .04) !important;
}

html[data-theme="dark"] .cabinet {
    background: linear-gradient(135deg, #111827 0%, #020617 100%) !important;
    box-shadow: 0 22px 42px rgba(0, 0, 0, .42) !important;
}

html[data-theme="dark"] .cabinet-badge {
    background: rgba(255, 255, 255, .07) !important;
    border-color: rgba(255, 255, 255, .10) !important;
}

html[data-theme="dark"] .cabinet-inside {
    background:
            radial-gradient(circle at top left, rgba(96, 165, 250, .09) 0%, rgba(96, 165, 250, 0) 28%),
            linear-gradient(180deg, #182235 0%, #141f31 100%) !important;
    border-color: rgba(255, 255, 255, .08) !important;
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, .04) !important;
}

html[data-theme="dark"] .splitter-panel,
html[data-theme="dark"] #boxViewerModal .nx-meta-tile,
html[data-theme="dark"] #boxViewerExtraInfo .nx-meta-tile {
    background: linear-gradient(180deg, #182235 0%, #141f31 100%) !important;
    border-color: #2b3d56 !important;
    box-shadow: 0 10px 24px rgba(0, 0, 0, .28) !important;
}

html[data-theme="dark"] .legend-chip {
    background: #101827 !important;
    border-color: #334155 !important;
}

/* Splitter ports */
html[data-theme="dark"] .splitter-port {
    background: linear-gradient(180deg, #182235 0%, #141f31 100%) !important;
    border-color: #2b3d56 !important;
    box-shadow: 0 8px 20px rgba(0, 0, 0, .24) !important;
}

html[data-theme="dark"] .splitter-port.free {
    background: rgba(34, 197, 94, .10) !important;
    border-color: rgba(74, 222, 128, .35) !important;
}

html[data-theme="dark"] .splitter-port.used {
    background: rgba(239, 68, 68, .10) !important;
    border-color: rgba(248, 113, 113, .35) !important;
}

html[data-theme="dark"] .splitter-port.reserved {
    background: rgba(59, 130, 246, .10) !important;
    border-color: rgba(96, 165, 250, .35) !important;
}

html[data-theme="dark"] .splitter-port.maintenance {
    background: rgba(148, 163, 184, .10) !important;
    border-color: rgba(148, 163, 184, .35) !important;
}

/* Uplink port */
html[data-theme="dark"] .splitter-port.uplink-port {
    background: linear-gradient(180deg, rgba(59, 130, 246, .15) 0%, rgba(30, 41, 59, .92) 100%) !important;
    border-color: rgba(96, 165, 250, .35) !important;
    box-shadow: 0 12px 26px rgba(59, 130, 246, .14) !important;
}

html[data-theme="dark"] .splitter-port.uplink-port .splitter-port-no,
html[data-theme="dark"] .splitter-port.uplink-port .splitter-port-status {
    color: #93c5fd !important;
}

html[data-theme="dark"] .splitter-port.uplink-port .splitter-port-linked {
    color: #cbd5e1 !important;
}

/* Map legend */
html[data-theme="dark"] .nap-map-legend {
    background: rgba(24, 34, 53, .96) !important;
    border-color: #2b3d56 !important;
    box-shadow: 0 18px 40px rgba(0, 0, 0, .36) !important;
}

html[data-theme="dark"] .nap-map-legend-title {
    color: #f8fafc !important;
}

html[data-theme="dark"] .nap-map-legend-row {
    color: #cbd5e1 !important;
}

/* Map labels */
html[data-theme="dark"] .nap-map-node-label {
    background: rgba(15, 23, 42, .92) !important;
    color: #f8fafc !important;
    box-shadow: 0 8px 18px rgba(0, 0, 0, .35) !important;
}

html[data-theme="dark"] .nap-map-node-label.odf {
    color: #f87171 !important;
}

html[data-theme="dark"] .nap-map-node-label.lcp {
    color: #93c5fd !important;
}

html[data-theme="dark"] .nap-map-node-label.nap {
    color: #4ade80 !important;
}

html[data-theme="dark"] .nap-map-node-label.success {
    background: rgba(34, 197, 94, .16) !important;
    color: #4ade80 !important;
}

html[data-theme="dark"] .nap-map-node-label.info {
    background: rgba(59, 130, 246, .16) !important;
    color: #93c5fd !important;
}

html[data-theme="dark"] .nap-map-node-label.warning {
    background: rgba(249, 115, 22, .16) !important;
    color: #fb923c !important;
}

html[data-theme="dark"] .nap-map-node-label.danger {
    background: rgba(239, 68, 68, .16) !important;
    color: #f87171 !important;
}

/* Util badges */
html[data-theme="dark"] .nap-map-util-badge.success {
    background: rgba(34, 197, 94, .16) !important;
    color: #4ade80 !important;
}

html[data-theme="dark"] .nap-map-util-badge.info {
    background: rgba(59, 130, 246, .16) !important;
    color: #93c5fd !important;
}

html[data-theme="dark"] .nap-map-util-badge.warning {
    background: rgba(249, 115, 22, .16) !important;
    color: #fb923c !important;
}

html[data-theme="dark"] .nap-map-util-badge.danger {
    background: rgba(239, 68, 68, .16) !important;
    color: #f87171 !important;
}

html[data-theme="dark"] .nap-map-util-bar {
    background: #334155 !important;
}

/* =========================================================
   NAP DARK MODE TABLE FIX
   Place at VERY BOTTOM of NapManagement.css
========================================================= */

html[data-theme="dark"] #napManagementApp .nx-table-wrap,
html[data-theme="dark"] #napManagementApp .table-responsive,
html[data-theme="dark"] #napManagementApp table,
html[data-theme="dark"] #napManagementApp .table {
    background: #141f31 !important;
    color: #dbe4f0 !important;
}

html[data-theme="dark"] #napManagementApp .table thead,
html[data-theme="dark"] #napManagementApp .table thead tr,
html[data-theme="dark"] #napManagementApp .table thead th {
    background: #101827 !important;
    color: #9aabc1 !important;
    border-color: #2b3d56 !important;
}

html[data-theme="dark"] #napManagementApp .table tbody,
html[data-theme="dark"] #napManagementApp .table tbody tr,
html[data-theme="dark"] #napManagementApp .table tbody td {
    background: #141f31 !important;
    color: #dbe4f0 !important;
    border-color: rgba(255, 255, 255, .06) !important;
}

html[data-theme="dark"] #napManagementApp .table tbody tr:hover,
html[data-theme="dark"] #napManagementApp .table tbody tr:hover td {
    background: #182235 !important;
    color: #ffffff !important;
}

/* Bootstrap table cell reset */
html[data-theme="dark"] #napManagementApp .table > :not(caption) > * > * {
    background-color: transparent !important;
    color: inherit !important;
    box-shadow: none !important;
}

/* If table text has links or muted classes */
html[data-theme="dark"] #napManagementApp .table a {
    color: #93c5fd !important;
}

html[data-theme="dark"] #napManagementApp .table .text-muted,
html[data-theme="dark"] #napManagementApp .table small,
html[data-theme="dark"] #napManagementApp .table .small {
    color: #9aabc1 !important;
}


/* =========================================================
   STANDARD TAB DESIGN
   Match the current VLAN/CGNAT segmented-tab treatment.
========================================================= */
html body#nxApplication .main-content #napManagementApp .nx-segment-control {
    display: inline-flex !important;
    align-items: center !important;
    flex-wrap: nowrap !important;
    gap: 4px !important;
    width: max-content !important;
    max-width: 100% !important;
    padding: 4px !important;
    overflow: hidden !important;
    border: 1px solid var(--nx-control-border-light) !important;
    border-radius: 8px !important;
    background: var(--nx-control-surface-light) !important;
    background-image: none !important;
    box-shadow: none !important;
}

html body#nxApplication .main-content #napManagementApp .nx-segment-control > .nx-segment-item {
    min-width: 118px !important;
    min-height: 40px !important;
    padding: .6rem 1rem !important;
    border: 0 !important;
    border-radius: 6px !important;
    background: transparent !important;
    color: var(--nx-text-soft) !important;
    font-family: var(--nx-font-body) !important;
    font-size: var(--nx-font-size-sm) !important;
    font-weight: 500 !important;
    line-height: 1.2 !important;
}

html body#nxApplication .main-content #napManagementApp .nx-segment-control > .nx-segment-item:hover {
    background: rgba(37, 99, 235, .08) !important;
    color: var(--nx-text) !important;
}

html body#nxApplication .main-content #napManagementApp .nx-segment-control > .nx-segment-item.active,
html body#nxApplication .main-content #napManagementApp .nx-segment-control > .nx-segment-item[aria-selected="true"] {
    background: #2563eb !important;
    background-image: none !important;
    color: #fff !important;
    box-shadow: 0 1px 2px rgba(37, 99, 235, .18) !important;
}

html body#nxApplication .main-content #napManagementApp .nx-toggle-group {
    display: inline-flex !important;
    align-items: center !important;
    gap: 4px !important;
    width: max-content !important;
    max-width: 100% !important;
    padding: 4px !important;
    border: 1px solid var(--nx-control-border-light) !important;
    border-radius: 8px !important;
    background: var(--nx-control-surface-light) !important;
    box-shadow: none !important;
}

html body#nxApplication .main-content #napManagementApp .nx-toggle-group button {
    min-height: 34px !important;
    padding: .5rem .85rem !important;
    border: 0 !important;
    border-radius: 6px !important;
    background: transparent !important;
    color: var(--nx-text-soft) !important;
    font-family: var(--nx-font-body) !important;
    font-size: var(--nx-font-size-sm) !important;
    font-weight: 500 !important;
    line-height: 1.2 !important;
}

html body#nxApplication .main-content #napManagementApp .nx-toggle-group button:hover {
    background: rgba(37, 99, 235, .08) !important;
    color: var(--nx-text) !important;
}

html body#nxApplication .main-content #napManagementApp .nx-toggle-group button.active {
    background: #2563eb !important;
    background-image: none !important;
    color: #fff !important;
    box-shadow: 0 1px 2px rgba(37, 99, 235, .18) !important;
}

html[data-theme="dark"] body#nxApplication .main-content #napManagementApp .nx-segment-control,
html[data-theme="dark"] body#nxApplication .main-content #napManagementApp .nx-toggle-group {
    background: var(--nx-control-surface-dark) !important;
    border-color: var(--nx-control-border-dark) !important;
}

html[data-theme="dark"] body#nxApplication .main-content #napManagementApp .nx-segment-control > .nx-segment-item,
html[data-theme="dark"] body#nxApplication .main-content #napManagementApp .nx-toggle-group button {
    color: var(--nx-text-soft) !important;
}

html[data-theme="dark"] body#nxApplication .main-content #napManagementApp .nx-segment-control > .nx-segment-item:hover,
html[data-theme="dark"] body#nxApplication .main-content #napManagementApp .nx-toggle-group button:hover {
    background: rgba(255, 255, 255, .06) !important;
    color: var(--nx-text) !important;
}

html[data-theme="dark"] body#nxApplication .main-content #napManagementApp .nx-segment-control > .nx-segment-item.active,
html[data-theme="dark"] body#nxApplication .main-content #napManagementApp .nx-toggle-group button.active {
    background: #2563eb !important;
    color: #fff !important;
}

@media (max-width: 767.98px) {
    html body#nxApplication .main-content #napManagementApp .nx-segment-control {
        width: 100% !important;
    }

    html body#nxApplication .main-content #napManagementApp .nx-segment-control > .nx-segment-item {
        min-width: 0 !important;
        flex: 1 1 0 !important;
    }

    html body#nxApplication .main-content #napManagementApp .nx-toggle-group {
        width: 100% !important;
    }

    html body#nxApplication .main-content #napManagementApp .nx-toggle-group button {
        flex: 1 1 0 !important;
    }
}


/* =========================================================
   STANDARD UI — NODES AND LINKS TABS ONLY
   Visual Planner uses separate selectors and is intentionally excluded.
========================================================= */
#napManagementApp .nap-standard-tab-shell {
    gap: 20px !important;
}

#napManagementApp .nap-standard-filter-panel,
#napManagementApp .nap-standard-results-panel {
    background: transparent !important;
    background-color: transparent !important;
    background-image: none !important;
    border: 0 !important;
    border-radius: 0 !important;
    box-shadow: none !important;
}

#napManagementApp .nap-standard-filter-panel > .card-body,
#napManagementApp .nap-standard-results-panel > .card-body {
    padding: 0 !important;
    margin: 0 !important;
}

#napManagementApp .nap-standard-filter-panel h5,
#napManagementApp .nap-standard-results-panel h5 {
    margin: 0 0 4px !important;
    color: var(--nx-text) !important;
    font-family: var(--nx-font-heading) !important;
    font-size: 17px !important;
    font-weight: 500 !important;
    line-height: 1.3 !important;
}

#napManagementApp .nap-standard-filter-panel .text-muted,
#napManagementApp .nap-standard-results-panel .text-muted,
#napManagementApp .nap-standard-filter-panel small,
#napManagementApp .nap-standard-results-panel small {
    color: var(--nx-text-muted) !important;
    font-family: var(--nx-font-body) !important;
    font-size: var(--nx-font-size-sm) !important;
    font-weight: 400 !important;
}

#napManagementApp .nap-standard-filter-panel > .card-body > div > div:last-child {
    margin-top: 16px !important;
}

#napManagementApp .nap-standard-filter-panel input,
#napManagementApp .nap-standard-filter-panel select {
    min-height: 40px !important;
    height: 40px !important;
    padding: 0 12px !important;
    border: 1px solid var(--nx-control-border-light) !important;
    border-radius: 3px !important;
    background: var(--nx-control-surface-light) !important;
    color: var(--nx-text) !important;
    box-shadow: none !important;
    font-family: var(--nx-font-body) !important;
    font-size: var(--nx-font-size-sm) !important;
    font-weight: 400 !important;
}

#napManagementApp .nap-standard-results-panel .nx-table-wrap,
#napManagementApp .nap-standard-results-panel .table-responsive {
    margin: 0 !important;
    padding: 0 !important;
    border: 0 !important;
    background: transparent !important;
    box-shadow: none !important;
}

#napManagementApp .nap-standard-results-panel .nx-table-wrap > table,
#napManagementApp .nap-standard-results-panel .table {
    width: 100% !important;
    margin: 0 !important;
    font-family: var(--nx-font-body) !important;
    font-size: var(--nx-font-size-sm) !important;
    font-weight: 400 !important;
}

#napManagementApp .nap-standard-results-panel table thead th {
    font-size: var(--nx-font-size-table-head) !important;
    font-weight: 500 !important;
}

#napManagementApp .nap-standard-results-panel table tbody td {
    font-size: var(--nx-font-size-sm) !important;
    font-weight: 400 !important;
    vertical-align: middle !important;
}

#napManagementApp .nap-standard-results-panel .btn-link {
    color: inherit !important;
    font-weight: 500 !important;
}

#napManagementApp .nap-standard-node-grid {
    gap: 20px !important;
}

#napManagementApp .nap-standard-node-grid .infra-box-card {
    min-height: 0 !important;
    padding: 16px !important;
    background: var(--nx-panel-surface-light) !important;
    background-image: none !important;
    border: 1px solid var(--nx-panel-border-light) !important;
    border-radius: var(--nx-panel-radius) !important;
    box-shadow: none !important;
}

#napManagementApp .nap-standard-node-grid .infra-box-card:hover {
    transform: none !important;
    box-shadow: none !important;
}

#napManagementApp .nap-standard-node-grid .infra-box-title {
    font-family: var(--nx-font-heading) !important;
    font-size: 16px !important;
    font-weight: 500 !important;
}

#napManagementApp .nap-standard-node-grid .infra-box-meta,
#napManagementApp .nap-standard-node-grid .infra-box-meta strong {
    font-family: var(--nx-font-body) !important;
    font-weight: 400 !important;
}

#napManagementApp .nap-standard-results-panel > .card-body > .d-flex:last-child {
    margin-top: 20px !important;
    font-family: var(--nx-font-body) !important;
    font-weight: 400 !important;
}

#napManagementApp .nap-standard-results-panel > .card-body > .d-flex:last-child .form-select,
#napManagementApp .nap-standard-results-panel > .card-body > .d-flex:last-child .btn {
    min-height: 36px !important;
    height: 36px !important;
    font-family: var(--nx-font-body) !important;
    font-size: var(--nx-font-size-sm) !important;
    font-weight: 400 !important;
}

html[data-theme="dark"] #napManagementApp .nap-standard-filter-panel input,
html[data-theme="dark"] #napManagementApp .nap-standard-filter-panel select {
    background: var(--nx-control-surface-dark) !important;
    border-color: var(--nx-control-border-dark) !important;
    color: var(--nx-text) !important;
}

html[data-theme="dark"] #napManagementApp .nap-standard-node-grid .infra-box-card {
    background: var(--nx-panel-surface-dark) !important;
    border-color: var(--nx-panel-border-dark) !important;
}

@media (max-width: 767.98px) {
    #napManagementApp .nap-standard-filter-panel > .card-body > div > div:last-child {
        margin-top: 12px !important;
    }

    #napManagementApp .nap-standard-node-grid {
        grid-template-columns: 1fr !important;
    }

    #napManagementApp .nap-standard-results-panel > .card-body > .d-flex:last-child {
        align-items: stretch !important;
    }
}


/* Keep filter spacing on the actual search row, not the heading row. */
#napManagementApp .nap-standard-filter-panel > .card-body > div > div:last-child {
    margin-top: 0 !important;
}

#napManagementApp .nap-standard-filter-panel > .card-body > .mt-3 {
    margin-top: 16px !important;
}


/* Final global-card cascade alignment for Nodes and Links only.
   These wrappers are non-card containers; the node tiles and table remain
   the true content surfaces. */
html body#nxApplication .main-content #napManagementApp .nap-standard-filter-panel,
html body#nxApplication .main-content #napManagementApp .nap-standard-results-panel {
    background: transparent !important;
    background-color: transparent !important;
    background-image: none !important;
    border: 0 !important;
    box-shadow: none !important;
}

html body#nxApplication .main-content #napManagementApp .nap-standard-filter-panel > .card-body,
html body#nxApplication .main-content #napManagementApp .nap-standard-results-panel > .card-body {
    background: transparent !important;
    background-color: transparent !important;
    background-image: none !important;
    padding-left: 0 !important;
    padding-right: 0 !important;
}

html[data-theme="dark"] body#nxApplication .main-content #napManagementApp .nap-standard-filter-panel,
html[data-theme="dark"] body#nxApplication .main-content #napManagementApp .nap-standard-results-panel {
    background: transparent !important;
    background-color: transparent !important;
    border: 0 !important;
}

html body#nxApplication .main-content #napManagementApp .nap-standard-node-grid .infra-box-card {
    background: var(--nx-panel-surface-light) !important;
    background-image: none !important;
    border: 1px solid var(--nx-panel-border-light) !important;
    border-radius: var(--nx-panel-radius) !important;
    box-shadow: none !important;
}

html[data-theme="dark"] body#nxApplication .main-content #napManagementApp .nap-standard-node-grid .infra-box-card,
html[data-theme="dark"] body#nxApplication .main-content #napManagementApp .nap-standard-node-grid .infra-box-card.maintenance {
    background: var(--nx-panel-surface-dark) !important;
    background-image: none !important;
    border-color: var(--nx-panel-border-dark) !important;
    box-shadow: none !important;
}


/* The outer content shell is a non-card wrapper for Nodes and Links.
   Keep the Visual Planner shell unchanged. */
html body#nxApplication .main-content #napManagementApp.nap-view-nodes > .nx-content-card,
html body#nxApplication .main-content #napManagementApp.nap-view-links > .nx-content-card {
    background: transparent !important;
    background-color: transparent !important;
    background-image: none !important;
    border: 0 !important;
    box-shadow: none !important;
}

html body#nxApplication .main-content #napManagementApp.nap-view-nodes > .nx-content-card > .card-body,
html body#nxApplication .main-content #napManagementApp.nap-view-links > .nx-content-card > .card-body {
    background: transparent !important;
    background-color: transparent !important;
    background-image: none !important;
    padding-left: 0 !important;
    padding-right: 0 !important;
}

html[data-theme="dark"] body#nxApplication .main-content #napManagementApp.nap-view-nodes > .nx-content-card,
html[data-theme="dark"] body#nxApplication .main-content #napManagementApp.nap-view-links > .nx-content-card {
    background: transparent !important;
    background-color: transparent !important;
    border: 0 !important;
}
/* Keep modal pickers usable even when shared map styles load out of order. */
.nx-modal .nx-map-picker {
    display: block;
    width: 100%;
    height: 320px !important;
    min-height: 320px !important;
    overflow: hidden;
    border: 1px solid var(--bs-border-color);
    border-radius: 6px;
    background: #f8fafc;
}

.nx-modal .nx-map-picker.leaflet-container,
.nx-modal .nx-map-picker .leaflet-container {
    width: 100%;
    height: 100% !important;
    min-height: 320px !important;
}

#napManagementApp .nap-nodes-table {
    width: 100%;
    min-width: 1120px;
    table-layout: fixed;
}

#napManagementApp .nap-nodes-table th {
    padding: 12px 16px;
    color: #64748b;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: .04em;
    text-transform: uppercase;
}

#napManagementApp .nap-nodes-table td {
    padding: 14px 16px;
    vertical-align: middle;
}

#napManagementApp .nap-nodes-table tbody tr { cursor: pointer; }
#napManagementApp .nap-nodes-table tbody tr:hover td { background: rgba(148, 163, 184, .06); }
#napManagementApp .nap-node-table-icon { display: inline-grid; width: 36px; height: 36px; flex: 0 0 36px; place-items: center; border-radius: 8px; }
#napManagementApp .nap-nodes-table th:nth-child(1) { width: 190px; }
#napManagementApp .nap-nodes-table th:nth-child(2) { width: 210px; }
#napManagementApp .nap-nodes-table th:nth-child(3) { width: 280px; }
#napManagementApp .nap-nodes-table th:nth-child(4) { width: 155px; }
#napManagementApp .nap-nodes-table th:nth-child(5) { width: 145px; }
#napManagementApp .nap-nodes-table th:nth-child(6),
#napManagementApp .nap-nodes-table td:nth-child(6) { width: 180px; min-width: 180px; }

#napManagementApp .nap-nodes-table td:nth-child(6) .btn {
    width: 34px;
    height: 32px;
    padding: 0;
}

@media (max-width: 991.98px) {
    #napManagementApp .nap-nodes-table { min-width: 1120px; table-layout: fixed; }
}
