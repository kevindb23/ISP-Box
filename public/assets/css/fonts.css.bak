:root {
    --nx-font-body: "DM Sans", "Segoe UI", Arial, sans-serif;
    --nx-font-heading: "DM Sans", "Segoe UI", Arial, sans-serif;
    --bs-font-sans-serif: var(--nx-font-body);
    --bs-body-font-family: var(--nx-font-body);
}

body {
    font-family: var(--nx-font-body) !important;
    font-weight: 400;
}

body h1,
body h2,
body h3,
body h4,
body h5,
body h6 {
    font-weight: 500;
}


/* DM Sans is the application-wide default, including standalone/auth pages. */
html,
body,
body#nxApplication,
body#nxApplication input,
body#nxApplication select,
body#nxApplication textarea,
body#nxApplication button,
body#nxApplication table {
    font-family: var(--nx-font-body) !important;
}
